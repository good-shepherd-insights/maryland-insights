---
import ClosingSection from "@/components/pages/Closing.astro";
import Drawing from "@/components/pages/Drawing.astro";
import PageHero from "@/components/pages/PageHero.astro";
import Questions from "@/components/pages/Questions.astro";
import Base from "@/layouts/Base.astro";
import { getFaqsPage, getSiteSettings } from "@/lib/sanity/queries";
import "@/styles/home.css";
import "@/styles/service.css";
import "@/styles/pages.css";

const page = await getFaqsPage();
const settingsUi = (await getSiteSettings())?.ui ?? {};
const header = page?.header ?? {};
const questions = (page?.list?.items ?? []).filter((f: any) => f?.question && f?.answer);
const support = page?.support ?? {};
const topics = (support.topics ?? []).filter((t: any) => t?.label && t?.link);
---

<Base {...page} ui={settingsUi} seoId={page._id}>
  <div class="hp sp pg">
    <PageHero title={header.title} description={header.description}>
      <div class="pg-ask" aria-hidden="true">{questions.slice(0, 7).map((f: any) => <span>{f.question}</span>)}</div>
    </PageHero>

    <section class="pg-sec hp-white">
      <div class="hp-in">
        <div class="pg-vision pg-vision-w">
          <div class="pg-text"><h2 class="pg-h2">{support.title}</h2>{[support.description, support.descriptionSecondary].filter(Boolean).map((t: string) => <p>{t}</p>)}</div>
          <Drawing name="under" labels={[["Your site", "#fff"], ["Headless CMS", "#FFC20E"], ["Cloud services", "#B8112B"], ["Edge delivery", "#121212"]]} />
        </div>
        <nav class="pg-topics" aria-label={support.eyebrow}>{topics.map((t: any) => <a href={t.link}><strong>{t.label}</strong><span>{t.description}</span></a>)}</nav>
      </div>
    </section>

    <Questions />
    <ClosingSection />
  </div>
</Base>
