---
import Base from "@/layouts/Base.astro";
import { getFaqsPage, getSiteSettings } from "@/lib/sanity/queries";
import { plainify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import PageHeader from "@/partials/PageHeader.astro";
import Testimonial from "@/partials/Testimonial.astro";
import Faqs from "@/partials/Faqs.astro";
import FaqSupport from "@/partials/FaqSupport.astro";
import type { FAQPage, Question } from "schema-dts";

const faqsPage = await getFaqsPage();
const settings = await getSiteSettings();
const settingsUi = settings?.ui ?? {};
const header = faqsPage?.header ?? {};
const title = header.title;
const description = header.description;

const list = faqsPage?.list ?? {};
const faqs_section = {
  faqs_list: (list.items ?? []).map((faq: any) => ({
    question: faq.question,
    answer: faq.answer,
  })),
  section_title: list.sectionTitle,
};

const support = faqsPage?.support ?? {};
const supportProps = {
  eyebrow: support.eyebrow,
  title: support.title,
  intro: support.description,
  description: support.descriptionSecondary,
  cards: (support.topics ?? []).map((t: any) => ({
    title: t.label,
    description: t.description,
    href: t.link,
  })),
};

const faqSchema: FAQPage = {
  "@type": "FAQPage",
  mainEntity: faqs_section.faqs_list.map(
    (faq: any) =>
      ({
        "@type": "Question",
        name: plainify(faq.question),
        acceptedAnswer: {
          "@type": "Answer",
          text: plainify(faq.answer),
        },
      }) as Question,
  ),
};
---

<Base {...faqsPage} ui={settingsUi} schema={[faqSchema]}>
  <PageHeader title={title} description={description} ui={settingsUi.pageHeader} />

  <FaqSupport {...supportProps} />

  {faqs_section.faqs_list.length > 0 && (
    <Faqs data={faqs_section} ui={settingsUi.faqs} />
  )}

  <Testimonial />
  <CallToAction />
</Base>
