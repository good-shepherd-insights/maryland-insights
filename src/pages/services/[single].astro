---
import config from "@/config/config.json";
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import CallToAction from "@/partials/CallToAction.astro";
import PageHeader from "@/partials/PageHeader.astro";
import Faqs from "@/partials/Faqs.astro";
import ServiceRichText from "@/components/services/ServiceRichText.astro";
import { plainify } from "@/lib/utils/textConverter";
import type { SoftwareApplication, FAQPage, Question } from "schema-dts";
import { render } from "astro:content";

export async function getStaticPaths() {
  const services = await getSinglePage("services");

  const paths = services.map((service) => ({
    params: {
      single: service.id,
    },
    props: { service },
  }));
  return paths;
}

const { service } = Astro.props;
const { title, description, image, faqs_list, blocks = [] } = service.data;
const richTextBlocks = Array.isArray(blocks)
  ? blocks.filter((block: any) => block?.type === "richText")
  : [];

const { Content } = await render(service);

const serviceSchema: SoftwareApplication = {
  "@type": "SoftwareApplication",
  "name": plainify(title),
  "description": plainify(description),
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "offers": {
    "@type": "Offer",
    "price": 0,
    "priceCurrency": "USD",
  },
  "image": image ? `${config.site.base_url}${image}` : undefined,
  "publisher": {
    "@id": `${config.site.base_url}/#organization`,
  },
};

const pageSchemas: (SoftwareApplication | FAQPage)[] = [serviceSchema];

if (faqs_list && faqs_list.length > 0) {
  const faqSchema: FAQPage = {
    "@type": "FAQPage",
    mainEntity: faqs_list.map(
      (faq: { question: string; answer: string }) =>
        ({
          "@type": "Question",
          name: plainify(faq.question),
          acceptedAnswer: {
            "@type": "Answer",
            text: plainify(faq.answer),
          },
        }) as Question,
    ),
  };
  pageSchemas.push(faqSchema);
}
---

<Base {...service.data} schema={pageSchemas}>
  <PageHeader title={title} description={description} />

  <section class="section-sm bg-light">
    <div class="container">
      <article class="w-full">
        {
          image && (
            <div>
              <ImageMod
                src={image}
                alt={title}
                width={800}
                height={450}
                class="w-full h-auto rounded-lg mb-6"
              />
            </div>
          )
        }
        <div class="content">
          <Content />
        </div>
      </article>
    </div>
  </section>

  {
    richTextBlocks.map((block: any) => (
      <ServiceRichText
        eyebrow={block.eyebrow}
        title={block.title}
        body={block.body}
        tone={block.tone}
      />
    ))
  }

  {faqs_list && faqs_list.length > 0 && <Faqs data={{ faqs_list, section_title: `Frequently Asked Questions About ${title}` }} prefix="service-faq" />}

  <CallToAction />
</Base>
