---
export const prerender = true;

import Base from "@/layouts/Base.astro";
import { getServicePageSlugs, getServicePage, getSiteSettings } from "@/lib/sanity/queries";
import { adaptServicePage } from "@/lib/sanity/adapters";
import PageHeader from "@/partials/PageHeader.astro";
import ServiceFaq from "@/components/services/ServiceFaq.astro";
import "@/styles/home.css";
import "@/styles/service.css";
import ServiceBlocks from "@/components/services/ServiceBlocks.astro";
import ServiceCTA from "@/components/services/ServiceCTA.astro";
import ServiceRelatedFeatures from "@/components/services/ServiceRelatedFeatures.astro";

export async function getStaticPaths() {
  const slugs = await getServicePageSlugs();
  return slugs.map((slug) => ({
    params: { single: slug },
    props: { slug },
  }));
}

const { slug } = Astro.props;
const service = adaptServicePage(await getServicePage(slug));
if (!service) return Astro.redirect("/404");
const settings = await getSiteSettings();
const settingsUi = settings?.ui ?? {};
const { title, description, faqs_list, blocks = [], faq_title_prefix, faqsUi } = service;
const relatedFeatures = (service.relatedFeatures ?? []).filter((f: { slug?: string }) => f?.slug);
const hasLeadHero = blocks.some((block: { _type: string }) => block._type === "leadCapture");
const ctaProps = {
  title: service.cta_title,
  description: service.cta_description,
  buttonLabel: service.cta_button_label,
  buttonLink: service.cta_button_link,
};

---

<Base {...service} ui={settingsUi} seoId={service._id}>
  <div class="hp sp">
  {!hasLeadHero && <PageHeader title={title} description={description} locale={settings.locale} ui={settingsUi.pageHeader} />}

  <ServiceBlocks blocks={blocks} locale={settings.locale} />

  {relatedFeatures.length > 0 && <ServiceRelatedFeatures title={service.relatedFeaturesTitle} items={relatedFeatures} />}

  {faqs_list && faqs_list.length > 0 && <ServiceFaq items={faqs_list} title={(faq_title_prefix ?? "").replace("{title}", title ?? "")} ui={faqsUi} />}

  <ServiceCTA {...ctaProps} />
  </div>
</Base>
