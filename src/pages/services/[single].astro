---
export const prerender = true;

import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getServicePageSlugs, getServicePage, getSiteSettings } from "@/lib/sanity/queries";
import { adaptServicePage } from "@/lib/sanity/adapters";
import PageHeader from "@/partials/PageHeader.astro";
import Faqs from "@/partials/Faqs.astro";
import ServiceBlocks from "@/components/services/ServiceBlocks.astro";
import ServiceCTA from "@/components/services/ServiceCTA.astro";
import { plainify } from "@/lib/utils/textConverter";
import type { SoftwareApplication, FAQPage, Question } from "schema-dts";

export async function getStaticPaths() {
  const slugs = await getServicePageSlugs();
  return slugs.map((slug) => ({
    params: { single: slug },
    props: { slug },
  }));
}

const { slug } = Astro.props;
const service = adaptServicePage(await getServicePage(slug));
const settings = await getSiteSettings();
const settingsUi = settings?.ui ?? {};
const { title, description, image, faqs_list, blocks = [], date_modified, faq_title_prefix, faqsUi } = service;
const hasLeadHero = blocks.some((block: { _type: string }) => block._type === "leadCapture");
const ctaProps = {
  title: service.cta_title,
  description: service.cta_description,
  buttonLabel: service.cta_button_label,
  buttonLink: service.cta_button_link,
};

const serviceSchema: SoftwareApplication = {
  "@type": "SoftwareApplication",
  "name": plainify(title),
  "description": plainify(description),
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "offers": {
    "@type": "Offer" as const,
    "price": 0,
    "priceCurrency": "USD" as const,
  },
  "image": image ? `${config.site.base_url}${image}` : undefined,
  "publisher": {
    "@id": `${config.site.base_url}/#organization`,
  },
  ...(date_modified ? { "dateModified": new Date(date_modified).toISOString() } : {}),
};

const pageSchemas: (SoftwareApplication | FAQPage)[] = [serviceSchema];

if (faqs_list && faqs_list.length > 0) {
  const faqSchema: FAQPage = {
    "@type": "FAQPage",
    mainEntity: faqs_list.map(
      (faq: { question: string; answer: string }) =>
        ({
          "@type": "Question",
          name: plainify(faq.question),
          acceptedAnswer: {
            "@type": "Answer",
            text: plainify(faq.answer),
          },
        }) as Question,
    ),
  };
  pageSchemas.push(faqSchema);
}
---

<Base {...service} ui={settingsUi} schema={pageSchemas}>
  {!hasLeadHero && <PageHeader title={title} description={description} ui={settingsUi.pageHeader} />}

  <ServiceBlocks blocks={blocks} />

  {faqs_list && faqs_list.length > 0 && <Faqs data={{ faqs_list, section_title: `${faq_title_prefix ?? ""}${title}` }} prefix="service-faq" ui={faqsUi} />}

  <ServiceCTA {...ctaProps} />
</Base>
