---
export const prerender = true;

import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";
import Faqs from "@/partials/Faqs.astro";
import ServiceBlocks from "@/components/services/ServiceBlocks.astro";
import ServiceCTA from "@/components/services/ServiceCTA.astro";
import { plainify } from "@/lib/utils/textConverter";
import type { SoftwareApplication, FAQPage, Question } from "schema-dts";

export async function getStaticPaths() {
  const services = await getSinglePage("services");

  const paths = services.map((service) => ({
    params: {
      single: service.id,
    },
    props: { service },
  }));
  return paths;
}

const { service } = Astro.props;
const { title, description, image, faqs_list, blocks = [], date_modified, is_local_seo, cta_title, cta_description, cta_button_label, cta_button_link, faq_title_prefix } = service.data;
const hasLeadHero = blocks.some((block: { type: string }) => block.type === "leadCapture");
const isLocalSeo = Boolean(is_local_seo);
const mainBlocks = isLocalSeo ? blocks.filter((block: { type: string }) => block.type !== "relatedArticles") : blocks;
const trailingArticleBlocks = isLocalSeo ? blocks.filter((block: { type: string }) => block.type === "relatedArticles") : [];
const ctaProps = {
  title: cta_title,
  description: cta_description,
  buttonLabel: cta_button_label,
  buttonLink: cta_button_link,
};

const serviceSchema: SoftwareApplication = {
  "@type": "SoftwareApplication",
  "name": plainify(title),
  "description": plainify(description),
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  ...(!isLocalSeo ? {
    "offers": {
      "@type": "Offer" as const,
      "price": 0,
      "priceCurrency": "USD" as const,
    },
  } : {}),
  "image": image ? `${config.site.base_url}${image}` : undefined,
  "publisher": {
    "@id": `${config.site.base_url}/#organization`,
  },
  ...(date_modified ? { "dateModified": new Date(date_modified).toISOString() } : {}),
};

const pageSchemas: (SoftwareApplication | FAQPage)[] = [serviceSchema];

if (faqs_list && faqs_list.length > 0) {
  const faqSchema: FAQPage = {
    "@type": "FAQPage",
    mainEntity: faqs_list.map(
      (faq: { question: string; answer: string }) =>
        ({
          "@type": "Question",
          name: plainify(faq.question),
          acceptedAnswer: {
            "@type": "Answer",
            text: plainify(faq.answer),
          },
        }) as Question,
    ),
  };
  pageSchemas.push(faqSchema);
}
---

<Base {...service.data} schema={pageSchemas}>
  {!hasLeadHero && <PageHeader title={title} description={description} />}

  <ServiceBlocks blocks={mainBlocks} />

  {isLocalSeo && <ServiceCTA {...ctaProps} />}

  {faqs_list && faqs_list.length > 0 && <Faqs data={{ faqs_list, section_title: `${faq_title_prefix ?? ""}${title}` }} prefix="service-faq" />}

  {isLocalSeo ? <ServiceBlocks blocks={trailingArticleBlocks} /> : <ServiceCTA {...ctaProps} />}
</Base>
