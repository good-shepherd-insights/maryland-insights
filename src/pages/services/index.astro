---
import ClosingBand from "@/components/blog/ClosingBand.astro";
import ImageMod from "@/components/ImageMod.astro";
import DynamicIcon from "@/helpers/DynamicIcon";
import Base from "@/layouts/Base.astro";
import { getServicesPage, getSiteSettings } from "@/lib/sanity/queries";
import { markdownify } from "@/lib/utils/textConverter";
import { serviceIcon } from "@/lib/home/serviceArt";
import "@/styles/home.css";
import "@/styles/service.css";
import "@/styles/blog.css";

const servicesPage = await getServicesPage();
const settings = await getSiteSettings();
const settingsUi = settings?.ui ?? {};
const header = servicesPage?.header ?? {};
const grid = servicesPage?.grid ?? {};
const title = header.title;
const description = header.description;
const section_title = grid.title;
const use_cases = servicesPage?.useCases
  ? { enable: servicesPage.useCasesEnable ?? true, ...servicesPage.useCases }
  : undefined;

const services = (grid.services ?? []).map((s: any) => ({
  id: s.slug,
  data: {
    title: s.title,
    description: s.description,
    image: s.image,
    button: s.button,
  },
}));

const TONE: Record<string, string> = { "website-hosting": "ink", "aeo-optimization": "gold", "local-seo": "cream", "analytics-reporting": "red", "marketing-automation": "sand", "ai-powered-content": "white" };
---

<Base {...servicesPage} ui={settingsUi} seoId={servicesPage._id}>
  <div class="hp sp">
    <section class="bp-top bp-top-s hp-cream">
      <div class="hp-in"><h1>{title}</h1>{description && <p set:html={markdownify(description)} />}{section_title && <h2 class="sp-h2 sp-h2-lg" set:html={markdownify(section_title)} />}</div>
    </section>
    {services.map((service: any) => {
      const tone = TONE[service.id] ?? "white";
      const icon = serviceIcon(service.data.image, tone, "");
      return (
        <section class={`hp-${tone}`}>
          <div class="hp-in bp-svc">
            <div class="bp-svc-i" aria-hidden="true">{icon ? <Fragment set:html={icon} /> : service.data.image && <img src={service.data.image} alt="" width="120" height="96" />}</div>
            <div><h3><a href={`/services/${service.id}`} aria-label={settingsUi.cardPrimary?.readMorePrefix ? `${settingsUi.cardPrimary.readMorePrefix} ${service.data.title}` : undefined}>{service.data.title}</a></h3><p set:html={markdownify(service.data.description)} /></div>
            {service.data.button?.label && <a class:list={["hp-btn", tone === "ink" || tone === "red" ? "hp-btn-gold" : "hp-btn-ink"]} href={`/services/${service.id}`}>{service.data.button.label}</a>}
          </div>
        </section>
      );
    })}
  </div>

  {
    use_cases?.enable && (
      <section
        class="section bg-dark section-divider"
        style="--section-divider-color: var(--color-dark)"
      >
        <div class="container">
          <div class="flex flex-col gap-6 lg:flex-row lg:justify-between max-lg:text-center items-center mb-12">
            <h2
              class="text-balance text-white"
              set:html={markdownify(use_cases.title)}
            />
            <p
              class="text-balance lg:ml-auto lg:text-right text-lg text-white"
              set:html={markdownify(use_cases.description)}
            />
          </div>

          <div class="space-y-20">
            {use_cases.cases?.map((item: any, i: number) => (
              <div
                class={`flex justify-between items-center gap-10 flex-col-reverse lg:flex-row ${i % 2 !== 0 ? "lg:flex-row-reverse" : ""}`}
              >
                <div class="lg:w-[50%]">
                  <div class="size-16 rounded-full bg-primary/10 flex items-center justify-center shrink-0 mb-10">
                    <DynamicIcon
                      icon={item.icon}
                      className="text-primary feature-pagination-icon-active text-3xl"
                    />
                  </div>

                  <h3
                    class="h5 leading-snug -mt-1.5 mb-2 text-white"
                    set:html={markdownify(item.title)}
                  />
                  <p
                    class="mt-2 text-white/80 text-balance"
                    set:html={markdownify(item.description)}
                  />

                  {item.button?.enable && (
                    <a
                      href={item.button.link}
                      class="hero-cta-gold inline-block mt-6 px-8 py-4 font-semibold text-base transition"
                    >
                      {item.button.label}
                    </a>
                  )}
                </div>
                <div class="bg-white/80 p-4 rounded-3xl lg:w-[44%]">
                  <ImageMod
                    src={item.image}
                    alt={item.title}
                    width={875}
                    height={597}
                    class="mx-auto w-full max-w-md h-auto max-h-[420px] object-contain rounded-2xl"
                  />
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <div class="hp sp"><ClosingBand /></div>
</Base>
