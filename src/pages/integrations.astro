---
import Base from "@/layouts/Base.astro";
import { getIntegrationsPage, getIntegrationsGuidance, getSiteSettings } from "@/lib/sanity/queries";
import CallToAction from "@/partials/CallToAction.astro";
import Faqs from "@/partials/Faqs.astro";
import PageHeader from "@/partials/PageHeader.astro";
import IntegrationsGuidance from "@/partials/IntegrationsGuidance.astro";
import Integrations from "@/partials/Integrations.astro";

const integrationsPage = await getIntegrationsPage();
const settings = await getSiteSettings();
const settingsUi = settings?.ui ?? {};
const header = integrationsPage?.header ?? {};
const title = header.title;
const description = header.description;

const guidance = await getIntegrationsGuidance();
const guidanceProps = {
  eyebrow: guidance?.eyebrow,
  title: guidance?.title,
  intro: guidance?.description,
  description: guidance?.archIntro,
  pillars: guidance?.pillars,
  standardsHeading: guidance?.standardsTitle,
  standardsIntro: guidance?.standardsIntro,
  standards: guidance?.standards,
};

---

<Base
  {...integrationsPage}
  title={title}
  meta_title={header.metaTitle}
  description={description}
  ui={settingsUi}
>
  <PageHeader
    title={title}
    description={description}
    locale={settings.locale}
    ui={settingsUi.pageHeader}
  />

  <IntegrationsGuidance {...guidanceProps} />

  <Integrations ui={integrationsPage?.ui?.integrations} logoAltTemplate={settingsUi.companyLogo?.altTemplate} />

  <Faqs prefix="integrations-faq" ui={settingsUi.faqs} />
  <CallToAction />
</Base>
