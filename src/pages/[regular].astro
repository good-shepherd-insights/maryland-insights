---
export const prerender = true;

import ClosingSection from "@/components/pages/Closing.astro";
import Base from "@/layouts/Base.astro";
import { renderPortableText, slugifyHeading } from "@/lib/sanity/portableText";
import { getLegalPage, getLegalPageSlugs, getSiteSettings } from "@/lib/sanity/queries";
import "@/styles/home.css";
import "@/styles/service.css";
import "@/styles/pages.css";

export async function getStaticPaths() {
  const slugs = await getLegalPageSlugs();
  return slugs.map((slug) => ({ params: { regular: slug }, props: { slug } }));
}

const { slug } = Astro.props;
const page = await getLegalPage(slug);
if (!page) return Astro.redirect("/404");
const settingsUi = (await getSiteSettings())?.ui ?? {};
// Whatever level the headings were typed at, they are this page's second level.
const headings: { id: string; text: string }[] = [];
const body = renderPortableText(page.body).replace(/<h([2-4])[^>]*>([\s\S]*?)<\/h\1>/g, (_, level, inner) => {
  const text = inner.replace(/<[^>]+>/g, "");
  const base = slugifyHeading(text.replace(/&\w+;/g, " "));
  const id = headings.some((h) => h.id === base) ? `${base}-${headings.length}` : base;
  headings.push({ id, text });
  return `<h2 id="${id}">${inner}</h2>`;
});
---

<Base {...page} ui={settingsUi} seoId={page._id}>
  <div class="hp sp pg">
    <section class="pg-legal-top hp-cream"><div class="hp-in"><h1>{page.title}</h1>{page.description && <p>{page.description}</p>}</div></section>
    <section class="pg-sec-s hp-white">
      <div class="hp-in pg-legal">
        {headings.length > 1 && <nav aria-label={page.title}><ul>{headings.map((h) => <li><a href={`#${h.id}`} set:html={h.text} /></li>)}</ul></nav>}
        <div class="pg-legal-body" set:html={body} />
      </div>
    </section>
    <ClosingSection />
  </div>
</Base>
