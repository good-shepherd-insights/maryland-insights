---
export const prerender = true;

import Base from "@/layouts/Base.astro";
import { getLegalPageSlugs, getLegalPage, getSiteSettings } from "@/lib/sanity/queries";
import { renderPortableText } from "@/lib/sanity/portableText";
import CallToAction from "@/partials/CallToAction.astro";
import Faqs from "@/partials/Faqs.astro";
import PageHeader from "@/partials/PageHeader.astro";

// get static paths for all legal pages
export async function getStaticPaths() {
  const slugs = await getLegalPageSlugs();
  return slugs.map((slug) => ({
    params: { regular: slug },
    props: { slug },
  }));
}

const { slug } = Astro.props;
const page = await getLegalPage(slug);
if (!page) return Astro.redirect("/404");
const settings = await getSiteSettings();
const settingsUi = settings?.ui ?? {};
const { title, description } = page;
const bodyHtml = renderPortableText(page?.body);

---

<Base {...page} ui={settingsUi}>
  <PageHeader title={title} description={description} locale={settings.locale} ui={settingsUi.pageHeader} />

  <section class="section-sm bg-light">
    <div class="container">
      <article
        class="w-full lg:w-7/12 bg-body rounded-2xl p-6 lg:p-8 mx-auto"
      >
        <div class="content" set:html={bodyHtml} />
      </article>
    </div>
  </section>

  <Faqs prefix="regular-faq" data={{ faqs_list: [] }} ui={settingsUi.faqs} />
  <CallToAction />
</Base>
