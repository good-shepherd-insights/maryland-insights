---
import ClosingSection from "@/components/pages/Closing.astro";
import PageHero from "@/components/pages/PageHero.astro";
import Questions from "@/components/pages/Questions.astro";
import Base from "@/layouts/Base.astro";
import { getSiteSettings, getToolsPage } from "@/lib/sanity/queries";
import { markdownify } from "@/lib/utils/textConverter";
import "@/styles/home.css";
import "@/styles/service.css";
import "@/styles/pages.css";

const page = await getToolsPage();
const settingsUi = (await getSiteSettings())?.ui ?? {};
const header = page?.header ?? {};
const grid = page?.grid ?? {};
const tools = (grid.tools ?? []).filter((t: any) => t?.title);
// What Maryland Business Online offers, from its own menus.
const isDirectory = (t: any) => /^https:\/\/marylandbusiness\.online/.test(t?.link ?? "");
const CATEGORIES = ["Active Life", "Automotive", "Beauty & Spas", "Education & Childcare", "Event Services", "Fitness", "Food & Drink", "Health & Medical", "Home Services", "Hotels & Travel", "Moving & Storage", "Nightlife", "Pets", "Professional Services", "Real Estate", "Restaurant", "Shopping"];
const hasDirectory = tools.some(isDirectory);
// Home page screenshots for tool cards, keyed by the tool's host.
const SHOTS: Record<string, string> = {
  "marylandbusiness.online": "/images/tools/maryland-business-online.jpg",
  "seo-fundamentals.marylandinsights.com": "/images/tools/seo-fundamentals.jpg",
};
const hostOf = (t: any) => { try { return new URL(t?.link ?? "").host; } catch { return ""; } };
---

<Base {...page} title={header.title} meta_title={header.metaTitle} description={header.description} ui={settingsUi} seoId={page._id}>
  <div class="hp sp pg">
    <PageHero title={header.title} description={header.description}>
      {hasDirectory && <div class="pg-shot"><p aria-hidden="true">marylandbusiness.online</p><img src="/images/tools/maryland-business-online.jpg" alt="The Maryland Business Online home page" width="1424" height="772" /></div>}
    </PageHero>

    <section class="pg-sec hp-cream">
      <div class="hp-in">
        {grid.eyebrow && <p>{grid.eyebrow}</p>}
        <h2 class="pg-h2 pg-h2-s" set:html={markdownify(grid.title ?? "")} />
        {tools.length === 0 && <p>{grid.emptyState}</p>}
        {tools.map((t: any) => (
          <div class="pg-tool">
            <h3>{t.title}</h3><p>{t.description}</p>
            {t.link && <a class="hp-btn hp-btn-ink" href={t.link} target="_blank" rel="noopener noreferrer">Visit {t.title}</a>}
            {SHOTS[hostOf(t)] && <div class="pg-shot"><p aria-hidden="true">{hostOf(t)}</p><img src={SHOTS[hostOf(t)]} alt="" width="1424" height="772" loading="lazy" /></div>}
          </div>
        ))}
      </div>
    </section>

    {hasDirectory && (
      <section class="pg-sec hp-white">
        <div class="hp-in pg-two">
          <div><h3 class="pg-h2">24 county hubs</h3><img class="pg-map" src="/images/pages/map-mixed.svg" alt="" width="1012" height="536" loading="lazy" /></div>
          <div><h3 class="pg-h2">{CATEGORIES.length} business categories</h3><ul class="pg-cats">{CATEGORIES.map((c) => <li>{c}</li>)}</ul></div>
        </div>
      </section>
    )}

    <Questions />
    <ClosingSection />
  </div>
</Base>
