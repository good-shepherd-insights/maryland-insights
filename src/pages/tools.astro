---
import Base from "@/layouts/Base.astro";
import { getToolsPage, getSiteSettings } from "@/lib/sanity/queries";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import Faqs from "@/partials/Faqs.astro";
import PageHeader from "@/partials/PageHeader.astro";
import IntegrationCard from "../components/IntegrationCard.astro";

const toolsPage = await getToolsPage();
const settings = await getSiteSettings();
const settingsUi = settings?.ui ?? {};
const header = toolsPage?.header ?? {};
const grid = toolsPage?.grid ?? {};
// toolsGrid.ui.cardAriaLabelTemplate — the labels live on the grid document, not on toolsPage.
const gridUi = grid.ui ?? {};

const title = header.title;
const description = header.description;
const eyebrow = grid.eyebrow ?? header.eyebrow;
const section_title = grid.title;
// `integration` schema: title, description, logo, logoName, link, kind, featured.
// Cards render the mark from logoName (Logo.dev); there is no `image` field.
const tools_list = (grid.tools ?? []).map((t: any) => ({
  title: t.title,
  description: t.description,
  logo_name: t.logoName,
  link: t.link,
}));

---

<Base
  {...toolsPage}
  title={title}
  meta_title={header.metaTitle}
  description={description}
  ui={settingsUi}
>
  <PageHeader
    title={title}
    description={description}
    locale={settings.locale}
    ui={settingsUi.pageHeader}
  />

  <section class="section-sm">
    <div class="container lg:w-[80%] xl:w-[70%] mx-auto">
      {eyebrow && (
        <p class="mb-3 text-center text-xs font-semibold uppercase tracking-[0.14em] text-text-light">
          {eyebrow}
        </p>
      )}
      {section_title && (
        <h2 class="mb-12 text-center text-balance" set:html={markdownify(section_title)} />
      )}

      {tools_list && tools_list.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {tools_list.map((tool: any) => (
            <IntegrationCard integration={tool} ui={{ ariaLabelTemplate: gridUi.cardAriaLabelTemplate }} logoAltTemplate={settingsUi.companyLogo?.altTemplate} />
          ))}
        </div>
      ) : (
        <div class="text-center text-text-dark/70 max-w-md mx-auto">
          <p>{grid.emptyState}</p>
        </div>
      )}
    </div>
  </section>

  <Faqs prefix="tools-faq" ui={settingsUi.faqs} />
  <CallToAction />
</Base>
