---
import Base from "@/layouts/Base.astro";
import { getToolsPage, getSiteSettings } from "@/lib/sanity/queries";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import Faqs from "@/partials/Faqs.astro";
import PageHeader from "@/partials/PageHeader.astro";
import IntegrationCard from "../components/IntegrationCard.astro";
import type { CollectionPage } from "schema-dts";

const toolsPage = await getToolsPage();
const settings = await getSiteSettings();
const settingsUi = settings?.ui ?? {};
const header = toolsPage?.header ?? {};
const grid = toolsPage?.grid ?? {};
const ui = toolsPage?.ui?.tools ?? {};

const title = header.title;
const description = header.description;
const eyebrow = grid.eyebrow ?? header.eyebrow;
const section_title = grid.title;
const tools_list = (grid.tools ?? []).map((t: any) => ({
  title: t.title,
  description: t.description,
  logo_name: t.logoName,
  image: t.image,
  link: t.link,
}));

const collectionSchema: CollectionPage = {
  "@type": "CollectionPage",
  "name": title,
  "description": description,
  "url": `${settings.seoUrl ?? ""}/tools`,
  "publisher": {
    "@id": `${settings.seoUrl ?? ""}/#organization`
  }
};
---

<Base
  {...toolsPage}
  title={title}
  meta_title={header.metaTitle}
  description={description}
  ui={settingsUi}
  schema={[collectionSchema]}
>
  <PageHeader
    title={title}
    description={description}
    ui={settingsUi.pageHeader}
  />

  <section class="section-sm">
    <div class="container lg:w-[80%] xl:w-[70%] mx-auto">
      {eyebrow && (
        <p class="mb-3 text-center text-xs font-semibold uppercase tracking-[0.14em] text-text-light">
          {eyebrow}
        </p>
      )}
      {section_title && (
        <h2 class="mb-12 text-center text-balance" set:html={markdownify(section_title)} />
      )}

      {tools_list && tools_list.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {tools_list.map((tool: any) => (
            <IntegrationCard integration={tool} ui={toolsPage?.ui?.integrationCard} />
          ))}
        </div>
      ) : (
        <div class="text-center text-text-dark/70 max-w-md mx-auto">
          <p>{ui?.emptyStateText}</p>
        </div>
      )}
    </div>
  </section>

  <Faqs prefix="tools-faq" />
  <CallToAction />
</Base>
