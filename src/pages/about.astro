---
export const prerender = true;
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getAboutPage, getSiteSettings } from "@/lib/sanity/queries";
import { markdownify, plainify } from "@/lib/utils/textConverter";
import AboutNarrative from "@/partials/AboutNarrative.astro";
import CallToAction from "@/partials/CallToAction.astro";
import Facts from "@/partials/Facts.astro";
import PageHeader from "@/partials/PageHeader.astro";
import Testimonial from "@/partials/Testimonial.astro";
import TrustedBrands from "@/partials/TrustedBrands.astro";
import type { AboutPage, Person } from "schema-dts";

const aboutPage = await getAboutPage();
const settings = await getSiteSettings();
const settingsUi = settings?.ui ?? {};
const header = aboutPage?.header ?? {};
const title = header.title;
const description = header.description;

const narrative = aboutPage?.narrative ?? {};
const narrativeUi = aboutPage?.ui?.aboutNarrative ?? {};
const company_narrative = {
  title: narrative.title,
  sections: narrative.sections ?? [],
  ui: narrativeUi,
};

const facts = aboutPage?.facts ?? {};
const facts_section = { enable: true, facts: facts.facts ?? [] };

const aboutSchema: AboutPage = {
  "@type": "AboutPage",
  "mainEntity": {
    "@id": `${config.site.base_url}/#organization`,
  },
};
---

<Base {...aboutPage} ui={settingsUi} schema={[aboutSchema]}>
  <PageHeader title={title} description={description} ui={settingsUi.pageHeader} />

  <AboutNarrative {...company_narrative} />

  <div class="border-t border-border">
    <TrustedBrands />
  </div>
  <Facts data={facts_section} />

  <Testimonial />
  <CallToAction />
</Base>
