---
export const prerender = true;
import Base from "@/layouts/Base.astro";
import MarylandDefs from "@/components/home/MarylandDefs.astro";
import Hero from "@/components/home/Hero.astro";
import Partners from "@/components/home/Partners.astro";
import Services from "@/components/home/Services.astro";
import Clients from "@/components/home/Clients.astro";
import Compare from "@/components/home/Compare.astro";
import Tools from "@/components/home/Tools.astro";
import Steps from "@/components/home/Steps.astro";
import HomeFaq from "@/components/home/HomeFaq.astro";
import Closing from "@/components/home/Closing.astro";
import { homeCopy } from "@/lib/home/copy";
import { getHomePage, getSiteSettings } from "@/lib/sanity/queries";
import "@/styles/home.css";

const home = await getHomePage();
const settings = await getSiteSettings();
const settingsUi = settings?.ui ?? {};
const homeUi = home?.ui ?? {};
const copy = homeCopy(home);

const comparison = home?.comparison ?? {};
const categories = (comparison.categories ?? []).map((c: any) => ({
  category: c.category,
  rows: (c.rows ?? []).map((r: any) => ({
    name: r.feature ?? r.name,
    description: r.description,
    values: (r.cells ?? []).map((cell: any) =>
      cell.kind === "check" ? "active" : cell.kind === "cross" ? "cross" : (cell.text ?? "")
    ),
  })),
}));
const plans = (comparison.plans ?? []).map((p: any) => ({ label: p.label, isUs: p.isUs, logo: p.logo }));
const partners = (home?.trustStrip?.logos ?? []).map((l: any) => ({ name: l.name, file: l.logoUrl, url: l.url }));
---

<Base {...home} ui={settingsUi} seoId={home._id} homeFooter>
  <MarylandDefs />
  <div class="hp">
    <Hero hero={home.hero} copy={copy} />
    <Partners partners={partners} title={copy.partnersTitle} label={homeUi.trustStrip?.partnersAriaLabel} />
    <Services stack={home.serviceStack} copy={copy} />
    <Clients features={home.features} copy={copy} />
    <Compare categories={categories} plans={plans} ui={homeUi.replacesTable} partnerLink={home.hero?.buttonSolid?.link} copy={copy} />
    <Tools copy={copy} />
    <Steps facts={home.facts?.facts} copy={copy} />
    <HomeFaq items={home.faq?.items} ui={home.faq?.ui} copy={copy} />
    <Closing cta={home.cta} partnerLink={home.hero?.buttonSolid?.link} copy={copy} />
  </div>
</Base>
