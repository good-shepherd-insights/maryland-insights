---
export const prerender = true;
import Base from "@/layouts/Base.astro";
import ReplacesTable from "@/components/ReplacesTable.astro";
import { getHomePage, getSiteSettings } from "@/lib/sanity/queries";
import { markdownify, plainify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import ChooseSwiper from "@/partials/ChooseSwiper.astro";
import Facts from "@/partials/Facts.astro";
import Features from "@/partials/Features.astro";
import DesignsHeroV2 from "@/layouts/partials/DesignsHeroV2.astro";
import TrustStrip from "@/layouts/partials/TrustStrip.astro";
import Integrations from "@/partials/Integrations.astro";
import TrustedBrands from "@/partials/TrustedBrands.astro";
import Faqs from "@/partials/Faqs.astro";
import type { FAQPage } from "schema-dts";

const home = await getHomePage();
const settings = await getSiteSettings();
const settingsUi = settings?.ui ?? {};
const homeUi = home?.ui ?? {};

const stack = home?.serviceStack ?? {};
const agents_swiper = {
  enable: true,
  title: stack.title,
  agents: (stack.cards ?? []).map((c: any) => ({
    label: c.label,
    description: c.description,
    icon: c.icon,
    points: c.points ?? [],
    button: c.button ? { ...c.button, enable: true } : undefined,
  })),
};

const faq = home?.faq ?? {};
const faqs_section = {
  faqs_list: (faq.items ?? []).map((f: any) => ({ question: f.question, answer: f.answer })),
  section_title: faq.sectionTitle,
};

const comparison = home?.comparison ?? {};
const comparison_section = {
  enable: true,
  title: comparison.title,
};
const planNames = (comparison.plans ?? []).map((p: any) => ({
  label: p.label,
  isUs: p.isUs,
}));
const categories = (comparison.categories ?? []).map((c: any) => ({
  category: c.category,
  rows: (c.rows ?? []).map((r: any) => ({
    name: r.name,
    description: r.description,
    values: (r.cells ?? []).map((cell: any) =>
      cell.kind === "check" ? "active" : cell.kind === "cross" ? "cross" : (cell.text ?? "")
    ),
  })),
}));

const facts = home?.facts ?? {};
const facts_section = { enable: true, facts: facts.facts ?? [] };

const trust = home?.trustStrip ?? {};
const trustStripUi = homeUi.trustStrip ?? {};
const partners = (trust.logos ?? []).map((l: any) => ({
  name: l.name,
  file: l.logoUrl,
  h: 32,
  url: undefined,
}));

// Unique Homepage FAQ Schema for Semantic Density
const faqSchema: FAQPage | null = faqs_section?.faqs_list?.length
  ? {
      "@type": "FAQPage",
      mainEntity: faqs_section.faqs_list.map((faq: any) => ({
        "@type": "Question",
        name: plainify(faq.question),
        acceptedAnswer: {
          "@type": "Answer",
          text: plainify(faq.answer),
        },
      })),
    }
  : null;

const combinedSchema = [faqSchema].filter(Boolean);
---

<Base {...home} ui={settingsUi} schema={combinedSchema}>
  <DesignsHeroV2 />
  <TrustStrip partners={partners} ui={trustStripUi} />
  <TrustedBrands />
  <ChooseSwiper data={agents_swiper} ui={homeUi.chooseSwiper} />
  <Features />
  {
    comparison_section.enable && (
      <section class="section">
        <div class="container mx-auto">
          <h2
            class="mb-12 text-center text-balance"
            set:html={markdownify(comparison_section.title)}
          />

          <ReplacesTable
            categories={categories}
            planNames={planNames}
            ui={homeUi.replacesTable}
          />
        </div>
      </section>
    )
  }
  <Integrations />
  <Facts data={facts_section} enableAnimation={false} />
  {faqs_section.faqs_list.length > 0 && (
    <Faqs data={faqs_section} prefix="home-faq" ui={settingsUi.faqs} />
  )}
  <CallToAction />
</Base>
