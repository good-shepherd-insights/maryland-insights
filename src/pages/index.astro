---
import Base from "@/layouts/Base.astro";
import ReplacesTable from "@/components/ReplacesTable.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify, plainify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import ChooseSwiper from "@/partials/ChooseSwiper.astro";
import Facts from "@/partials/Facts.astro";
import Features from "@/partials/Features.astro";
// import FeautresCarousel from "@/partials/FeautresCarousel.astro";
import HomeBanner from "@/partials/HomeBanner.astro";
import Integrations from "@/partials/Integrations.astro";
// import PricingGrid from "@/partials/PricingGrid.astro";
import TrustedBrands from "@/partials/TrustedBrands.astro";
import Faqs from "@/partials/Faqs.astro";
import type { FAQPage } from "schema-dts";

const pageIndex = await getListPage("homepage", "-index");
const faqsComponent = await getListPage("faqs", "-homepage");
const faqs_section = faqsComponent.data;

const pricingSectionPage = await getListPage("pricingSection", "pricing");
const comparison_section = pricingSectionPage.data;

// Unique Homepage FAQ Schema for Semantic Density
const faqSchema: FAQPage | null = faqs_section?.faqs_list
  ? {
      "@type": "FAQPage",
      mainEntity: faqs_section.faqs_list.map((faq: any) => ({
        "@type": "Question",
        name: plainify(faq.question),
        acceptedAnswer: {
          "@type": "Answer",
          text: plainify(faq.answer),
        },
      })),
    }
  : null;

const combinedSchema = [faqSchema].filter(Boolean);
---

<Base {...pageIndex.data} schema={combinedSchema}>
  <HomeBanner />
  <TrustedBrands />
  <ChooseSwiper data={pageIndex.data.agents_swiper} />
  <Facts data={pageIndex.data.facts_section} enableAnimation={false} />
  <Features />
  {
    comparison_section.enable && (
      <section class="section">
        <div class="container mx-auto">
          <h2
            class="mb-12 text-center text-balance"
            set:html={markdownify(comparison_section.title)}
          />

          <ReplacesTable
            categories={comparison_section.categories}
            planNames={comparison_section.plan_names}
          />
        </div>
      </section>
    )
  }
  <Integrations />
  {/* <PricingGrid haveDivider /> */}
  {/* <FeautresCarousel /> */}
  <Faqs data={faqs_section} prefix="home-faq" />
  <CallToAction />
</Base>
