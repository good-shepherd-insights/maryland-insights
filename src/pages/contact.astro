---
import ClosingSection from "@/components/pages/Closing.astro";
import Drawing from "@/components/pages/Drawing.astro";
import PageHero from "@/components/pages/PageHero.astro";
import Base from "@/layouts/Base.astro";
import { contactLinks, isAddress, mapLink } from "@/lib/pages/contact";
import { getContactPage, getSiteSettings } from "@/lib/sanity/queries";
import { markdownify } from "@/lib/utils/textConverter";
import "@/styles/home.css";
import "@/styles/service.css";
import "@/styles/pages.css";

const page = await getContactPage();
const settings = await getSiteSettings();
const settingsUi = settings?.ui ?? {};
const header = page?.header ?? {};
const g = page?.guidance ?? {};
const form = page?.form;
const links = contactLinks(page?.info?.informations);
const email = links.find((l) => l.href.startsWith("mailto:"));
const phone = links.find((l) => l.href.startsWith("tel:"));
const offices = page?.offices?.locations ?? [];
const STEPS = ["step-review", "step-map", "step-scope"];
---

<Base title={header.title} metaTitle={page?.metaTitle} description={header.description} ui={settingsUi} seoId={page._id}>
  <div class="hp sp pg">
    <PageHero title={header.title} description={header.description} />

    <section class="pg-sec hp-cream">
      <div class="hp-in">
        <h2 class="pg-h2 pg-h2-l pg-w">{g.title}</h2>
        <div class="pg-intro">{[g.description, g.descriptionSecondary].filter(Boolean).map((t: string) => <p>{t}</p>)}{g.processIntro && <p><strong>{g.processIntro}</strong></p>}</div>
        <ol class="pg-process">
          {(g.steps ?? []).map((s: any, i: number) => <li>{STEPS[i] && <Drawing name={STEPS[i]} />}<div><h3 class="pg-h3">{s.title}</h3><p>{s.description}</p></div></li>)}
        </ol>
      </div>
    </section>

    <section class="pg-sec hp-white">
      <div class="hp-in pg-split">
        <div class="pg-text">
          <h2 class="pg-h2">{g.contextTitle}</h2><p>{g.contextIntro}</p>
          <div class="pg-note" aria-hidden="true">{email && <p>To {email.value}</p>}<ul>{(g.contextItems ?? []).map((c: any) => <li>{c.title}</li>)}</ul></div>
        </div>
        <dl class="pg-defs">{(g.contextItems ?? []).map((c: any) => <div><dt>{c.title}</dt><dd>{c.description}</dd></div>)}</dl>
      </div>
    </section>

    {form && (
      <section class="pg-sec hp-cream" id="contact-form">
        <div class="hp-in">
          <h2 class="pg-h2 pg-h2-l pg-w" set:html={markdownify(page?.sectionTitle || form.title)} />
          <div class="pg-intro"><p>{form.description}</p></div>
          <form class="pg-form" action="/api/contact" method="post" data-contact-form>
            {(form.fields ?? []).map((f: any) => (
              <label class:list={{ "pg-form-w": f.type === "textarea" }}>
                <span>{f.label}{f.required && <b aria-hidden="true"> *</b>}</span>
                {f.type === "textarea"
                  ? <textarea name={f.name} rows="4" placeholder={f.placeholder} required={f.required} maxlength="5000" />
                  : <input name={f.name} type={f.name === "phone" ? "tel" : f.type} placeholder={f.placeholder} required={f.required} maxlength="200" autocomplete={({ name: "name", email: "email", phone: "tel" } as any)[f.name]} />}
              </label>
            ))}
            <label class="pg-trap" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
            <div class="pg-form-w"><button class="hp-btn hp-btn-ink" type="submit">{form.submitLabel}</button><p role="status" aria-live="polite" data-contact-status></p></div>
          </form>
          <div class="pg-ways">{links.map((l) => <a href={l.href}><span>{l.label}</span>{l.value}</a>)}</div>
        </div>
      </section>
    )}

    {offices.length > 0 && (
      <section class="pg-office hp-white">
        <div class="pg-office-t">
          <h2 class="pg-h2">{page?.offices?.title}</h2>
          {offices.filter((o: any) => isAddress(o.address)).map((o: any) => <div><h3 class="pg-h3">{o.name}</h3><a href={mapLink(o.address)} target="_blank" rel="noopener noreferrer">{o.address}</a></div>)}
          <ul>{offices.filter((o: any) => !isAddress(o.address)).map((o: any) => <li><span>{o.name}</span><span>{o.address}</span></li>)}</ul>
        </div>
        <Drawing name="headquarters" />
      </section>
    )}

    <ClosingSection />
  </div>
</Base>

<script define:vars={{ phone: phone?.value ?? "", email: email?.value ?? "" }}>
  const bind = () => {
    const form = document.querySelector("[data-contact-form]");
    if (!form || "ready" in form.dataset) return;
    form.dataset.ready = "";
    const status = form.querySelector("[data-contact-status]");
    const button = form.querySelector("button[type=submit]");
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      button.disabled = true;
      status.textContent = "Sending…";
      let ok = false;
      try {
        const response = await fetch(form.action, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
        ok = response.ok;
      } catch {}
      button.disabled = false;
      // Never say a message arrived when it did not.
      status.textContent = ok ? "Thank you. Your message was sent." : `Your message was not sent. Please call ${phone} or email ${email}.`;
      if (ok) form.reset();
    });
  };
  bind();
  document.addEventListener("astro:page-load", bind);
</script>
