---
export const prerender = true;
import Drawing from "@/components/pages/Drawing.astro";
import Base from "@/layouts/Base.astro";
import { getSiteSettings } from "@/lib/sanity/queries";
import "@/styles/home.css";
import "@/styles/service.css";
import "@/styles/pages.css";

const settingsUi = (await getSiteSettings())?.ui ?? {};
const nf = settingsUi.notFound ?? {};
---

<Base title={nf.title} ui={settingsUi} notFound>
  <div class="hp sp pg">
    <section class="pg-404 hp-white">
      <div class="hp-in"><Drawing name="404" /><div class="pg-404-t"><h1>{nf.heading}</h1><div><p>{nf.description}</p><a class="hp-btn hp-btn-ink" href={nf.homeLinkUrl}>{nf.homeLinkText}</a></div></div></div>
    </section>
  </div>
</Base>
