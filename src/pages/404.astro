---
import Base from "@/layouts/Base.astro";

type Props = {
  title?: string;
  heading?: string;
  description?: string;
  homeLinkText?: string;
  homeLinkUrl?: string;
};

const { title, heading, description, homeLinkText, homeLinkUrl } = Astro.props as Props;
---

<Base title={title} noindex={true}>
  <section
    class="section bg-light pt-30 lg:pt-43 bg-4col-grid overflow-x-hidden border-b border-border"
  >
    <div


      class="container sm:w-[90%] md:w-[70%] lg:w-[50%] mx-auto"
    >
      <div class="text-center">
        <span


          class="text-[9rem] block font-bold text-text-dark"
        >
          404
        </span>
        <h1 class="h2 mb-4">
          {heading}
        </h1>
        <div class="content">
          <p class="text-balance">
            {description}
          </p>
        </div>
        <a


          href={homeLinkUrl}
          class="btn btn-dark rounded-full mt-8">{homeLinkText}</a
        >
      </div>
    </div>
  </section>
</Base>
