---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/partials/PageHeader.astro";
import { getSiteSettings } from "@/lib/sanity/queries";

type Props = {
  title?: string;
  description?: string;
  heading?: string;
  body?: string;
  homeLinkText?: string;
  homeLinkUrl?: string;
};

const { title, description, heading, body, homeLinkText, homeLinkUrl } = Astro.props as Props;
const settings = await getSiteSettings();
const settingsUi = settings?.ui ?? {};

---

<Base title={title} description={description} ui={settingsUi} noindex={true}>
  <PageHeader title={title} ui={settingsUi.pageHeader} />
  <section class="section">
    <div class="container text-center">
      <h2 class="h3 mb-6">{heading}</h2>
      <p class="text-lg mb-8">
        {body}
      </p>
      <a href={homeLinkUrl} class="btn btn-primary">{homeLinkText}</a>
    </div>
  </section>
</Base>
