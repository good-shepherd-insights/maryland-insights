---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/partials/PageHeader.astro";
import type { SearchResultsPage } from "schema-dts";

type Props = {
  title?: string;
  description?: string;
  heading?: string;
  body?: string;
  homeLinkText?: string;
  homeLinkUrl?: string;
};

const { title, description, heading, body, homeLinkText, homeLinkUrl } = Astro.props as Props;

const searchSchema: SearchResultsPage = {
  "@type": "SearchResultsPage",
  "name": title,
  "description": description
};
---

<Base title={title} description={description} schema={[searchSchema]} noindex={true}>
  <PageHeader title={title} />
  <section class="section">
    <div class="container text-center">
      <h2 class="h3 mb-6">{heading}</h2>
      <p class="text-lg mb-8">
        {body}
      </p>
      <a href={homeLinkUrl} class="btn btn-primary">{homeLinkText}</a>
    </div>
  </section>
</Base>
