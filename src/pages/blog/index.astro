---
import CardPrimary from "@/components/CardPrimary.astro";
import Base from "@/layouts/Base.astro";
import { getBlogPage, getBlogPosts, getSiteSettings } from "@/lib/sanity/queries";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { markdownify, slugify } from "@/lib/utils/textConverter";
import BlogLibraryGuide from "@/partials/BlogLibraryGuide.astro";
import CallToAction from "@/partials/CallToAction.astro";
import Faqs from "@/partials/Faqs.astro";
import PageHeader from "@/partials/PageHeader.astro";

const blogPage = await getBlogPage();
const settings = await getSiteSettings();
const settingsUi = settings?.ui ?? {};
const cardUi = settingsUi.cardPrimary;
const header = blogPage?.header ?? {};
const title = header.title;
const description = header.description;

const guide = blogPage?.guide ?? {};
const blogGuide = {
  enable: true,
  ...guide,
  introduction: guide.description,
  reading_note: guide.researchIntro,
};

const featured_posts = { enable: true, title: blogPage?.featuredTitle };
const actual_posts = { enable: true, title: blogPage?.archiveTitle };
const all_filter_label = blogPage?.allFilterLabel;

const toCardPost = (p: any) => ({
  id: p.slug,
  data: {
    title: p.title,
    description: p.description,
    image: p.image,
    date: p.datePublished,
    author: p.author,
    categories: (p.categories ?? []).map((c: any) => c.title),
  },
});

const posts = (await getBlogPosts()).map(toCardPost);
const featuredFive = ((blogPage?.featuredPosts ?? []) as any[])
  .filter((p: any) => !p.draft)
  .map(toCardPost)
  .slice(0, 5);
const featuredFirst = featuredFive[0];
const featuredCol2 = featuredFive.slice(1, 3);
const featuredCol3 = featuredFive.slice(3, 5);

const categories: string[] = [...new Set((posts as any[]).flatMap((p: any) => p.data.categories as string[]))];
const categoryLabelsBySlug = new Map(categories.map((category: string) => [slugify(category).toLocaleLowerCase(), category]));
const categoryGroups = [...categoryLabelsBySlug.keys()];
const categoryLabels = [...categoryLabelsBySlug.values()];
const sortedPosts = sortByDate(posts);
---

<Base {...blogPage} ui={settingsUi}>
  <PageHeader title={title} description={description} locale={settings.locale} ui={settingsUi.pageHeader} />

  {blogGuide?.enable && <BlogLibraryGuide
    title={blogGuide.title}
    introduction={blogGuide.description}
    reading_note={blogGuide.researchIntro}
    categories={categoryLabels}
    eyebrow={blogGuide.standardsTitle}
    pillars={blogGuide.pillars}
    domainsHeading={blogGuide.domainsHeading}
    domainsIntro={blogGuide.domainsIntro}
    topics={blogGuide.highlights}
  />}

  <!-- Featured section  -->
  {
    featured_posts && featured_posts.enable && featuredFive.length > 0 && (
      <section class="section-sm bg-light">
        <div class="container">
          <h2
            class="mb-12 text-center xl:w-[60%] mx-auto text-balance"
            set:html={markdownify(featured_posts.title)}
          />

          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {featuredFirst && (
              <div>
                <CardPrimary
                  data={featuredFirst.data}
                  id={`/blog/${featuredFirst.id}`}
                  locale={settings.locale}
                  ui={cardUi}
                />
              </div>
            )}

            {featuredCol2.length > 0 && (
              <div class="flex flex-col gap-6">
                {featuredCol2.map((post: any) => (
                  <div>
                    <CardPrimary
                      data={post.data}
                      id={`/blog/${post.id}`}
                      locale={settings.locale}
                      ui={cardUi}
                    />
                  </div>
                ))}
              </div>
            )}

            {featuredCol3.length > 0 && (
              <div class="w-full flex flex-col gap-6 sm:grid sm:grid-cols-2 lg:flex lg:flex-col md:col-span-2 lg:col-span-1">
                {featuredCol3.map((post: any) => (
                  <div>
                    <CardPrimary
                      data={post.data}
                      id={post.id}
                      locale={settings.locale}
                      ui={cardUi}
                    />
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- All blog with shuffle animation  -->
  <section
    id="all-articles"
    class="section bg-dark section-divider"
    style="--section-divider-color: var(--color-dark)"
  >
    <div class="container">
      {
        actual_posts && actual_posts.enable && (
          <>
            <h2
              class="mb-12 text-center xl:w-[60%] mx-auto text-balance text-white"
              set:html={markdownify(actual_posts.title)}
            />

            <ul class="flex justify-center items-center flex-wrap shuffle-filter">
              <li class="selected" data-target="all">
                <button
                  type="button"
                  class={`btn btn-primary btn-sm border-2 hover:-translate-y-0.75 transition-transform m-3 inline-block capitalize py-3 rounded-full`}
                >
                  {all_filter_label}
                </button>
              </li>
              {categoryGroups.map((group: string) => (
                <li data-target={group}>
                  <button
                    type="button"
                    class={`btn btn-outline btn-sm border-2 bg-body hover:-translate-y-0.75 transition-transform m-3 inline-block capitalize py-3 rounded-full`}
                  >
                    {categoryLabelsBySlug.get(group)}
                  </button>
                </li>
              ))}
            </ul>

            <ul class="shuffle-container relative flex flex-wrap mt-6">
              <li
                class="shuffle-sizer w-full md:w-1/2 lg:w-1/3 p-3"
                aria-hidden="true"
              />
              {sortedPosts.map((post: any) => {
                const postCategories = Array.isArray(post.data.categories)
                  ? post.data.categories
                  : [];
                const postGroups = [
                  ...new Set(
                    postCategories.map((category: string) =>
                      slugify(category).toLocaleLowerCase()
                    )
                  ),
                  "all",
                ];

                return (
                  <li
                    class="shuffle-item w-full md:w-1/2 lg:w-1/3 p-3"
                    data-groups={JSON.stringify(postGroups)}
                  >
                    <CardPrimary
                      data={post.data}
                      id={`/blog/${post.id}`}
                      hasDarkArrow
                      locale={settings.locale}
                      ui={cardUi}
                    />
                  </li>
                );
              })}
            </ul>
          </>
        )
      }
    </div>
  </section>
  <Faqs prefix="blog-faq" ui={settingsUi.faqs} />
  <CallToAction />
</Base>

<script>
  import Shuffle from "shufflejs";

  document.addEventListener("astro:page-load", () => {
    const element = document.querySelector(
      ".shuffle-container"
    ) as HTMLElement | null;
    if (!element) return;

    let shuffleInstance = new Shuffle(element, {
      itemSelector: ".shuffle-item",
      sizer: element.querySelector(".shuffle-sizer") as HTMLElement,
    });

    const filter = document.querySelector(".shuffle-filter");
    if (!filter) return;

    const baseBtnClasses =
      "btn btn-sm hover:-translate-y-0.75 active:scale-95 transition-transform duration-200 inline-block m-2 capitalize py-2.5 rounded-full text-text-dark";
    const activeBtnClasses = `${baseBtnClasses} btn-primary text-dark`;
    const inactiveBtnClasses = `${baseBtnClasses} btn-outline bg-body`;

    const filtterLists = Array.from(filter.children) as HTMLElement[];

    const setButtonVariant = (listItem: HTMLElement, isSelected: boolean) => {
      const button = listItem.querySelector(
        "button"
      ) as HTMLButtonElement | null;
      if (!button) return;
      button.className = isSelected ? activeBtnClasses : inactiveBtnClasses;
    };

    // Apply correct styles on load ("All Together" is selected by default)
    filtterLists.forEach((listItem) => {
      setButtonVariant(listItem, listItem.classList.contains("selected"));
    });

    filtterLists.forEach((listItem) => {
      const button = listItem.querySelector(
        "button"
      ) as HTMLButtonElement | null;
      button?.addEventListener("click", function () {
        filtterLists.forEach((li) => {
          li.classList.remove("selected");
          setButtonVariant(li, false);
        });

        const activeLi = (this as HTMLElement).closest(
          "li"
        ) as HTMLElement | null;
        if (activeLi) {
          activeLi.classList.add("selected");
          setButtonVariant(activeLi, true);
        }

        const keyword = activeLi?.getAttribute("data-target") || "all";
        shuffleInstance.filter(keyword);
      });
    });
  });
</script>
