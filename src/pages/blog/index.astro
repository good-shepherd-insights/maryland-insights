---
import ClosingBand from "@/components/blog/ClosingBand.astro";
import PostRow from "@/components/blog/PostRow.astro";
import ServiceFaq from "@/components/services/ServiceFaq.astro";
import Base from "@/layouts/Base.astro";
import { getBlogPage, getBlogPosts, getFaqsPage, getSiteSettings } from "@/lib/sanity/queries";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { markdownify, slugify } from "@/lib/utils/textConverter";
import BlogLibraryGuide from "@/partials/BlogLibraryGuide.astro";
import "@/styles/home.css";
import "@/styles/service.css";
import "@/styles/blog.css";

const [blogPage, settings, allPosts, faqsPage] = await Promise.all([getBlogPage(), getSiteSettings(), getBlogPosts(), getFaqsPage()]);
const settingsUi = settings?.ui ?? {};
const cardUi = settingsUi.cardPrimary;
const header = blogPage?.header ?? {};
const title = header.title;
const description = header.description;

const guide = blogPage?.guide ?? {};
const blogGuide = {
  enable: true,
  ...guide,
  introduction: guide.description,
  reading_note: guide.researchIntro,
};

const featured_posts = { enable: true, title: blogPage?.featuredTitle };
const actual_posts = { enable: true, title: blogPage?.archiveTitle };
const all_filter_label = blogPage?.allFilterLabel;

const toCardPost = (p: any) => ({
  id: p.slug,
  data: {
    title: p.title,
    description: p.description,
    image: p.image,
    date: p.datePublished,
    author: p.author,
    categories: (p.categories ?? []).map((c: any) => c.title),
  },
});

const posts = allPosts.map(toCardPost);
const featuredFive = ((blogPage?.featuredPosts ?? []) as any[])
  .filter((p: any) => !p.draft)
  .map(toCardPost)
  .slice(0, 5);
const categories: string[] = [...new Set((posts as any[]).flatMap((p: any) => p.data.categories as string[]))];
const categoryLabelsBySlug = new Map(categories.map((category: string) => [slugify(category).toLocaleLowerCase(), category]));
const categoryGroups = [...categoryLabelsBySlug.keys()];
const categoryLabels = [...categoryLabelsBySlug.values()];
const sortedPosts = sortByDate(posts);
---

<Base {...blogPage} ui={settingsUi} seoId={blogPage._id}>
  <div class="hp sp">
    <section class="bp-top hp-cream">
      <div class="hp-in"><h1>{title}</h1>{description && <p set:html={markdownify(description)} />}</div>
    </section>

    {blogGuide?.enable && <BlogLibraryGuide
      title={blogGuide.title}
      introduction={blogGuide.description}
      reading_note={blogGuide.researchIntro}
      categories={categoryLabels}
      eyebrow={blogGuide.standardsTitle}
      pillars={blogGuide.pillars}
      domainsHeading={blogGuide.domainsHeading}
      domainsIntro={blogGuide.domainsIntro}
      topics={blogGuide.highlights}
    />}

    {featured_posts.enable && featuredFive.length > 0 && (
      <section class="sp-sec hp-cream">
        <div class="hp-in sp-stack">
          <h2 class="sp-h2 sp-h2-lg" set:html={markdownify(featured_posts.title)} />
          <div>{featuredFive.map((post: any) => <PostRow post={post} size="l" locale={settings.locale} ui={cardUi} />)}</div>
        </div>
      </section>
    )}

    <section id="all-articles" class="sp-sec hp-white">
      <div class="hp-in sp-side">
        <div class="sp-title">
          <h2 class="sp-h2" set:html={markdownify(actual_posts.title)} />
          <ul class="bp-filters" data-blog-filters>
            <li><button type="button" data-target="all" aria-pressed="true">{all_filter_label}</button></li>
            {categoryGroups.map((group: string) => <li><button type="button" data-target={group} aria-pressed="false">{categoryLabelsBySlug.get(group)}</button></li>)}
          </ul>
        </div>
        <ul data-blog-list>
          {sortedPosts.map((post: any) => (
            <li data-groups={JSON.stringify([...new Set((post.data.categories ?? []).map((c: string) => slugify(c).toLocaleLowerCase()))])}><PostRow post={post} locale={settings.locale} ui={cardUi} /></li>
          ))}
        </ul>
      </div>
    </section>

    <ServiceFaq items={faqsPage?.list?.items} title={faqsPage?.list?.sectionTitle} ui={settingsUi.faqs} />
    <ClosingBand />
  </div>
</Base>

<script>
  document.addEventListener("astro:page-load", () => {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-blog-filters] button"));
    const items = Array.from(document.querySelectorAll<HTMLElement>("[data-blog-list] > li"));
    buttons.forEach((button) => button.addEventListener("click", () => {
      const target = button.dataset.target ?? "all";
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
      items.forEach((item) => (item.hidden = target !== "all" && !(JSON.parse(item.dataset.groups ?? "[]") as string[]).includes(target)));
    }));
  });
</script>
