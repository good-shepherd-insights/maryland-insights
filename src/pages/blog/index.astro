---
import config from "@/config/config.json";
import CardPrimary from "@/components/CardPrimary.astro";
import Base from "@/layouts/Base.astro";
import { getBlogPage, getBlogPosts, getSiteSettings } from "@/lib/sanity/queries";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { markdownify, slugify, humanize, plainify } from "@/lib/utils/textConverter";
import BlogLibraryGuide from "@/partials/BlogLibraryGuide.astro";
import CallToAction from "@/partials/CallToAction.astro";
import Faqs from "@/partials/Faqs.astro";
import PageHeader from "@/partials/PageHeader.astro";
import type { Blog, BlogPosting, Person } from "schema-dts";

const blogPage = await getBlogPage();
const settings = await getSiteSettings();
const settingsUi = settings?.ui ?? {};
const cardUi = settingsUi.cardPrimary;
const header = blogPage?.header ?? {};
const title = header.title;
const description = header.description;

const guide = blogPage?.guide ?? {};
const blogGuide = {
  enable: true,
  ...guide,
  introduction: guide.description,
  reading_note: guide.researchIntro,
};

const featured_posts = { enable: true, title: blogPage?.featuredTitle };
const actual_posts = { enable: true, title: blogPage?.archiveTitle };
const all_filter_label = blogPage?.allFilterLabel;

const toCardPost = (p: any) => ({
  id: p.slug,
  data: {
    title: p.title,
    description: p.description,
    image: p.image,
    date: p.datePublished,
    author: p.author,
    categories: (p.categories ?? []).map((c: any) => c.title),
  },
});

const posts = (await getBlogPosts()).map(toCardPost);
const featuredFive = ((blogPage?.featuredPosts ?? []) as any[])
  .map(toCardPost)
  .slice(0, 5);
const featuredFirst = featuredFive[0];
const featuredCol2 = featuredFive.slice(1, 3);
const featuredCol3 = featuredFive.slice(3, 5);

const categories: string[] = [...new Set((posts as any[]).flatMap((p: any) => p.data.categories as string[]))];
const categoryGroups = [
  ...new Set(categories.map((category: string) => category.toLocaleLowerCase())),
];
const categoryLabels = [
  ...new Map(categories.map((category: string) => [category.toLocaleLowerCase(), category])).values(),
];
const sortedPosts = sortByDate(posts);

const blogIndexSchema: Blog = {
  "@type": "Blog",
  "name": plainify(title),
  "description": plainify(description),
  "url": `${config.site.base_url}/blog`,
  "blogPost": sortedPosts.slice(0, 10).map((post: any) => ({
    "@type": "BlogPosting",
    "headline": plainify(post.data.title),
    "url": `${config.site.base_url}/blog/${post.id}`,
    "datePublished": post.data.date,
    "author": {
      "@type": "Person",
      "name": plainify(post.data.author?.name),
    } as Person,
  } as BlogPosting)),
};
---

<Base {...blogPage} ui={settingsUi} schema={[blogIndexSchema]}>
  <PageHeader title={title} description={description} ui={settingsUi.pageHeader} />

  {blogGuide?.enable && <BlogLibraryGuide {...blogGuide} categories={categoryLabels} />}

  <!-- Featured section  -->
  {
    featured_posts && featured_posts.enable && featuredFive.length > 0 && (
      <section class="section-sm bg-light">
        <div class="container">
          <h2
            class="mb-12 text-center xl:w-[60%] mx-auto text-balance"
            set:html={markdownify(featured_posts.title)}
          />

          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {featuredFirst && (
              <div>
                <CardPrimary
                  data={featuredFirst.data}
                  id={`/blog/${featuredFirst.id}`}
                  ui={cardUi}
                />
              </div>
            )}

            {featuredCol2.length > 0 && (
              <div class="flex flex-col gap-6">
                {featuredCol2.map((post: any) => (
                  <div>
                    <CardPrimary
                      data={post.data}
                      id={`/blog/${post.id}`}
                      ui={cardUi}
                    />
                  </div>
                ))}
              </div>
            )}

            {featuredCol3.length > 0 && (
              <div class="w-full flex flex-col gap-6 sm:grid sm:grid-cols-2 lg:flex lg:flex-col md:col-span-2 lg:col-span-1">
                {featuredCol3.map((post: any) => (
                  <div>
                    <CardPrimary
                      data={post.data}
                      id={post.id}
                      ui={cardUi}
                    />
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- All blog with shuffle animation  -->
  <section
    id="all-articles"
    class="section bg-dark section-divider"
    style="--section-divider-color: var(--color-dark)"
  >
    <div class="container">
      {
        actual_posts && actual_posts.enable && (
          <>
            <h2
              class="mb-12 text-center xl:w-[60%] mx-auto text-balance text-white"
              set:html={markdownify(actual_posts.title)}
            />

            <ul class="flex justify-center items-center flex-wrap shuffle-filter">
              <li class="selected" data-target="all">
                <button
                  type="button"
                  class={`btn btn-primary btn-sm border-2 hover:-translate-y-0.75 transition-transform m-3 inline-block capitalize py-3 rounded-full`}
                >
                  {all_filter_label}
                </button>
              </li>
              {categoryGroups.map((group: string) => (
                <li data-target={group}>
                  <button
                    type="button"
                    class={`btn btn-outline btn-sm border-2 bg-body hover:-translate-y-0.75 transition-transform m-3 inline-block capitalize py-3 rounded-full`}
                  >
                    {humanize(group)}
                  </button>
                </li>
              ))}
            </ul>

            <ul class="shuffle-container relative flex flex-wrap mt-6">
              <li
                class="shuffle-sizer w-full md:w-1/2 lg:w-1/3 p-3"
                aria-hidden="true"
              />
              {sortedPosts.map((post: any) => {
                const postCategories = Array.isArray(post.data.categories)
                  ? post.data.categories
                  : [];
                const postGroups = [
                  ...new Set(
                    postCategories.map((category: string) =>
                      slugify(category).toLocaleLowerCase()
                    )
                  ),
                  "all",
                ];

                return (
                  <li
                    class="shuffle-item w-full md:w-1/2 lg:w-1/3 p-3"
                    data-groups={JSON.stringify(postGroups)}
                  >
                    <CardPrimary
                      data={post.data}
                      id={`/blog/${post.id}`}
                      hasDarkArrow
                      ui={cardUi}
                    />
                  </li>
                );
              })}
            </ul>
          </>
        )
      }
    </div>
  </section>
  <Faqs prefix="blog-faq" />
  <CallToAction />
</Base>
