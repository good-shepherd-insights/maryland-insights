---
export const prerender = true;

import ClosingBand from "@/components/blog/ClosingBand.astro";
import PostRow from "@/components/blog/PostRow.astro";
import ServiceFaq from "@/components/services/ServiceFaq.astro";
import UpdatedDateBadge from "@/components/UpdatedDateBadge.astro";
import Share from "@/components/Share.astro";
import Base from "@/layouts/Base.astro";
import { getBlogPosts, getBlogPost, getSiteSettings } from "@/lib/sanity/queries";
import { renderPortableText, extractHeadings } from "@/lib/sanity/portableText";
import dateFormat from "@/lib/utils/dateFormat";
import similarItems from "@/lib/utils/similarItems";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { markdownify } from "@/lib/utils/textConverter";
import ImageMod from "@/components/ImageMod.astro";
import "@/styles/home.css";
import "@/styles/service.css";
import "@/styles/blog.css";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post: any) => ({
    params: { single: post.slug },
    props: { slug: post.slug },
  }));
}

const { slug } = Astro.props;
const doc = await getBlogPost(slug);
const settings = await getSiteSettings();
const primaryCta = settings.blogChrome?.inlineCtaPrimary ?? settings.navigationButton;
const settingsUi = settings?.ui ?? {};
const ui = doc?.ui?.blogSingle ?? {};
const shareUi = doc?.ui?.share;
const authorUi = { ...doc?.ui?.authorByline, badgeUpdatedLabel: doc?.ui?.authorByline?.updatedLabel };

const title = doc?.title;
const bodyHtml = renderPortableText(doc?.body);
const headings = extractHeadings(doc?.body);

const blogData = {
  author: doc?.author ? { name: doc.author.name, image: doc.author.image } : undefined,
  date: doc?.datePublished,
  lastmod: doc?.dateModified,
};

const allPostsRaw = await getBlogPosts();
const allPosts = allPostsRaw.map((p: any) => ({
  id: p.slug,
  data: {
    title: p.title,
    description: p.description,
    image: p.image,
    date: p.datePublished,
    author: p.author,
    categories: (p.categories ?? []).map((c: any) => c.title),
  },
}));
const currentItem = {
  id: slug,
  data: { categories: (doc?.categories ?? []).map((c: any) => c.title) },
};
const sortedPosts = sortByDate(allPosts).slice(0, 5);
const similarPosts = similarItems(currentItem, allPosts).slice(0, 3);

const dateModifiedRaw = doc?.dateModified || doc?.datePublished;

// One band per h2: the heading on the left, its text on the right.
const sections = bodyHtml.split(/(?=<h2[\s>])/).filter((part: string) => part.trim()).map((part: string) => {
  const m = part.match(/^(<h2[\s\S]*?<\/h2>)([\s\S]*)$/);
  return m ? { heading: m[1], text: m[2] } : { heading: "", text: part };
}).map((part: { heading: string; text: string }) => ({ ...part, text: part.text.replace(/<p>(\s*<strong>Key point:)/g, '<p class="bp-key">$1') }));
if (sections.length > 0 && sections[0].heading) sections.unshift({ heading: "", text: "" });
const asText = (value: unknown) => (value instanceof Date ? value.toISOString() : String(value));
---

<Base
  {...doc}
  seoId={doc._id}
  ui={settingsUi}
  og_type="article"
  date_published={doc?.datePublished ? new Date(doc.datePublished).toISOString() : undefined}
  date_modified={dateModifiedRaw ? new Date(dateModifiedRaw).toISOString() : undefined}
  author_name={doc?.author?.name}
  author_twitter={doc?.author?.twitter}
  article_tags={(doc?.categories ?? []).map((c: any) => c.title)}
  article_section={doc?.categories?.[0]?.title}
>
  <div class="hp sp">
    <section class="bp-post-top hp-white">
      <div class="hp-gold"><div class="hp-in"><h1 set:text={title} /></div></div>
      <div class="hp-in bp-meta">
        {blogData.author?.image && <ImageMod src={blogData.author.image} alt={blogData.author.name} height={48} width={48} />}
        <p><span>{authorUi.writtenByLabel}</span> <strong>{blogData.author?.name}</strong></p>
        {blogData.date && <UpdatedDateBadge dateModified={asText(blogData.lastmod || blogData.date)} datePublished={asText(blogData.date)} variant="badge" label={authorUi.badgeUpdatedLabel} locale={settings.locale} ui={authorUi} />}
      </div>
    </section>

    {headings.length > 0 && (
      <section class="sp-sec sp-sec-s hp-ink">
        <div class="hp-in">
          <nav class="sp-toc" aria-label={ui.tocHeading}>
            <details class="sp-toc-d" open>
              <summary><span><span class="sp-h2 sp-h2-s">{ui.tocHeading}</span><span class="sp-mut">{ui.tocMobileHeading}</span></span><svg width="26" height="26" viewBox="0 0 30 30" aria-hidden="true"><path d="M3 15H27" /><path class="sp-toc-v" d="M15 3V27" /></svg></summary>
              <ol class="bp-toc-l">{headings.map((heading, n) => <li><a href={`#${heading.id}`}><span class="sp-n" aria-hidden="true">{String(n + 1).padStart(2, "0")}</span> <span>{heading.text}</span></a></li>)}</ol>
            </details>
            <script is:inline>if (matchMedia("(max-width: 1023px)").matches) document.currentScript.previousElementSibling.removeAttribute("open");</script>
          </nav>
        </div>
      </section>
    )}

    <article>
      {sections.map((part: { heading: string; text: string }, n: number) => (
        <div class={`sp-sec sp-sec-s ${n % 2 ? "hp-cream" : "hp-white"}`}>
          <div class="hp-in bp-sec">
            <div class="bp-sec-h">
              {part.heading ? <Fragment set:html={part.heading} /> : doc?.image && <ImageMod src={doc.image} width={900} height={500} alt={title} />}
            </div>
            <div>
              <div class="content bp-body" set:html={part.text} />
              {n === sections.length - 1 && (
                <div class="bp-ctas">
                  {primaryCta?.link && (ui.ctaButtonLabel || primaryCta.label) && <a href={primaryCta.link} class="hp-btn hp-btn-ink">{ui.ctaButtonLabel || primaryCta.label}</a>}
                  <a href={settings.consultUrl ?? ""} class="hp-btn hp-btn-line">{ui.consultButtonLabel}</a>
                </div>
              )}
            </div>
          </div>
        </div>
      ))}
    </article>

    <aside class="sp-sec sp-sec-s hp-gold">
      <div class="hp-in bp-aside">
        {sortedPosts.length > 0 && (
          <nav aria-label={ui.recentPostsHeading}>
            <p class="sp-label">{ui.recentPostsHeading}</p>
            <ul class="bp-recent">
              {sortedPosts.map((post: any) => (
                <li><a href={`/blog/${post.id}`}>
                  <ImageMod src={post?.data.image} alt={post?.data.title} width={96} height={76} loading="lazy" />
                  <span><span class="bp-recent-by">{settings.blogChrome?.bylinePrefix && `${settings.blogChrome.bylinePrefix.trim()} `}{[post?.data.author?.name, post?.data.date && dateFormat(post.data.date, settings.locale)].filter(Boolean).join(" - ")}</span><strong>{post?.data.title}</strong></span>
                </a></li>
              ))}
            </ul>
          </nav>
        )}
        <div><p class="sp-label">{ui.shareHeading}</p><Share slug={`blog/${slug}`} className="bp-share" title={title} description={doc?.description} ui={shareUi} /></div>
        {settings.newsletter && (
          <div>
            <p class="sp-label">{ui.newsletterHeading}</p>
            <form
                  data-newsletter-form
                  action="/api/newsletter"
                  method="post"
                >
                  <div class="flex justify-between rounded-lg bg-light px-3 py-2 border border-border mb-5 mt-2">
                    <input
                      type="email"
                      placeholder={ui.newsletterPlaceholder}
                      class="form-input w-full rounded-full border-transparent! bg-transparent! py-2! pl-2! placeholder:opacity-100! placeholder:font-normal"
                      required
                      name="email"
                    />
                    <button
                      title={ui.subscribeButtonTitle}
                      class="transition hover:opacity-80 pr-2"
                      type="submit"
                    >
                      <svg
                        width="18"
                        height="18"
                        viewBox="0 0 18 18"
                        fill="none"
                      >
                        <path
                          fill-rule="evenodd"
                          clip-rule="evenodd"
                          d="M17.1772.0665905C17.3647-.0359303 17.5912-.0187131 17.7637.108851 17.9362.237198 18.0247.454761 17.994.673889L15.9315 15.152C15.9067 15.3234 15.81 15.476 15.6675 15.5668 15.5782 15.6231 15.477 15.6521 15.375 15.6521 15.3135 15.6521 15.252 15.6411 15.1935 15.6208L7.33126 12.8167 15.0622 3.09761 5.07152 12.0114.380282 10.3382C.168033 10.2623.0187833 10.062.00153335 9.8272-.0149666 9.5932.102783 9.37094.302282 9.26216L17.1772.0665905zM6.56261 17.413V13.7833l3.05024 1.0879-2.03474 2.8893C7.47011 17.9139 7.30061 18 7.12511 18 7.06661 18 7.00736 17.9906 6.94961 17.971 6.71861 17.8912 6.56261 17.6666 6.56261 17.413z"
                          fill="#070127"
                        />
                      </svg>
                    </button>
                  </div>
                  <p data-newsletter-hint class="text-xs text-text-light/70 mb-2">
                    {ui.newsletterHint}
                  </p>

                  <label
                    for="blog-newsletter-consent"
                    class="text-xs block"
                    style="line-height:normal"
                  >
                    <input
                      type="checkbox"
                      name="checkbox"
                      id="blog-newsletter-consent"
                      data-newsletter-consent
                      required
                      class="appearance-auto rounded-sm accent-primary ring-0"
                    />
                    <span>{ui.consentLabel}</span>
                    {settings.newsletter?.consentLinkHref && ui.privacyLinkText && (
                      <a
                        href={settings.newsletter.consentLinkHref}
                        class="text-text-dark font-semibold hover:text-primary transition duration-300"
                      >
                        {ui.privacyLinkText}
                      </a>
                    )}
                  </label>
                </form>
          </div>
        )}
      </div>
    </aside>

    {similarPosts.length > 0 && (
      <section class="sp-sec hp-cream">
        <div class="hp-in sp-side">
          <h2 class="sp-h2" set:html={markdownify(ui.similarPostsHeading ?? "")} />
          <div>{similarPosts.map((post: any) => <PostRow post={post} locale={settings.locale} ui={settingsUi.cardPrimary} />)}</div>
        </div>
      </section>
    )}

    {doc?.faqs && doc.faqs.length > 0 && <ServiceFaq items={doc.faqs} title={ui.faqSectionTitle} ui={settingsUi.faqs} />}
    <ClosingBand />
  </div>
</Base>
