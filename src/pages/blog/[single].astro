---
export const prerender = true;

import CardPrimary from "@/components/CardPrimary.astro";
import ImageMod from "@/components/ImageMod.astro";
import Share from "@/components/Share.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getBlogPosts, getBlogPost, getSiteSettings } from "@/lib/sanity/queries";
import { renderPortableText, extractHeadings } from "@/lib/sanity/portableText";
import dateFormat from "@/lib/utils/dateFormat";
import similarItems from "@/lib/utils/similarItems";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { markdownify, plainify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import PageHeader from "@/partials/PageHeader.astro";
import Faqs from "@/partials/Faqs.astro";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post: any) => ({
    params: { single: post.slug },
    props: { slug: post.slug },
  }));
}

const { slug } = Astro.props;
const doc = await getBlogPost(slug);
const settings = await getSiteSettings();
const settingsUi = settings?.ui ?? {};
const ui = doc?.ui?.blogSingle ?? {};
const shareUi = doc?.ui?.share;
const authorUi = doc?.ui?.authorByline;

const title = doc?.title;
const bodyHtml = renderPortableText(doc?.body);
const headings = extractHeadings(doc?.body);

const blogData = {
  author: doc?.author ? { name: doc.author.name, image: doc.author.image } : undefined,
  date: doc?.datePublished,
  lastmod: doc?.dateModified,
};

const allPostsRaw = await getBlogPosts();
const allPosts = allPostsRaw.map((p: any) => ({
  id: p.slug,
  data: {
    title: p.title,
    description: p.description,
    image: undefined,
    date: p.datePublished,
    author: p.author,
    categories: (p.categories ?? []).map((c: any) => c.title),
  },
}));
const currentItem = {
  id: slug,
  data: { categories: (doc?.categories ?? []).map((c: any) => c.title) },
};
const sortedPosts = sortByDate(allPosts).slice(0, 5);
const similarPosts = similarItems(currentItem, allPosts).slice(0, 3);

const dateModifiedRaw = doc?.dateModified || doc?.datePublished;

const blogSchema = {
  "@type": "BlogPosting",
  "@id": `${config.site.base_url}/blog/${slug}#blogposting`,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `${config.site.base_url}/blog/${slug}`,
    "isPartOf": {
      "@id": `${config.site.base_url}/#website`
    }
  },
  "headline": plainify(title),
  "description": plainify(doc?.description),
  ...(doc?.datePublished ? { "datePublished": new Date(doc.datePublished).toISOString() } : {}),
  ...(dateModifiedRaw ? { "dateModified": new Date(dateModifiedRaw).toISOString() } : {}),
  ...(doc?.author?.name ? {
    "author": {
      "@type": "Person",
      "name": plainify(doc.author.name),
      "url": `${config.site.base_url}/about`,
    }
  } : {}),
  "publisher": {
    "@id": `${config.site.base_url}/#organization`,
  },
};

const pageSchemas: any[] = [blogSchema];

if (doc?.faqs && doc.faqs.length > 0) {
  pageSchemas.push({
    "@type": "FAQPage",
    mainEntity: doc.faqs.map(
      (faq: { question: string; answer: string }) => ({
        "@type": "Question",
        name: plainify(faq.question),
        acceptedAnswer: {
          "@type": "Answer",
          text: plainify(faq.answer),
        },
      }),
    ),
  });
}
---

<Base
  {...doc}
  ui={settingsUi}
  schema={pageSchemas}
  og_type="article"
  date_published={doc?.datePublished ? new Date(doc.datePublished).toISOString() : undefined}
  date_modified={dateModifiedRaw ? new Date(dateModifiedRaw).toISOString() : undefined}
  author_name={doc?.author?.name}
  author_twitter={doc?.author?.twitter}
  article_tags={(doc?.categories ?? []).map((c: any) => c.title)}
  article_section={doc?.categories?.[0]?.title}
>
  <PageHeader title={title} blogData={blogData} ui={authorUi} />
  <section class="section-sm bg-light">
    <div
      class="container flex flex-col lg:flex-row justify-center gap-5 items-start"
    >
      {
        headings.length > 0 && (
          <aside class="bg-body rounded-2xl p-6 shrink-0 max-w-62 lg:sticky top-30 hidden lg:block border border-border/50 shadow-sm">
            <nav>
              <small class="block mb-4 font-semibold text-text-dark font-primary text-[10px] uppercase tracking-wider">
                {ui.tocHeading}
              </small>
              <div class="toc-desktop-container">
                <div class="toc-desktop-line" />
                <ul class="space-y-1">
                  {headings.map((heading) => (
                    <li>
                      <a href={`#${heading.id}`} class="toc-desktop-link">
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </nav>
          </aside>
        )
      }
      <article
        class="w-full lg:w-7/12 bg-body rounded-2xl px-6 sm:px-8 xl:px-10"
      >
        {
          headings.length > 0 && (
            <nav class="lg:hidden my-8 p-5 bg-light/50 border border-border rounded-2xl">
              <small class="block mb-3 font-semibold text-text-dark font-primary text-[10px] uppercase tracking-wider">
                {ui.tocMobileHeading}
              </small>
              <ul class="space-y-1">
                {headings.map((heading) => (
                  <li>
                    <a href={`#${heading.id}`} class="toc-link group bg-body">
                      <span class="font-medium">{heading.text}</span>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="toc-link-icon opacity-100! translate-x-0!"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polyline points="9 18 15 12 9 6" />
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        <div class="content" set:html={bodyHtml} />

        <div
          class="flex flex-wrap items-center justify-center gap-4 mt-12 py-10 border-t border-border/50"
        >
          <a href={config.navigation_button.link} class="btn btn-primary px-10">{ui.ctaButtonLabel}</a>
          <a
            href={config.consult_url}
            class="btn btn-outline px-10"
          >
            {ui.consultButtonLabel}
          </a>
        </div>
      </article>

      <aside class="w-full lg:w-auto shrink-0 lg:max-w-62 lg:sticky top-30">
        {
          sortedPosts.length > 0 && (
            <nav class="bg-body rounded-2xl p-4">
              <small class="font-semibold text-text-dark font-primary text-sm">
                {ui.recentPostsHeading}
              </small>
              <ul>
                {sortedPosts.map((post: any) => (
                  <li>
                    <a
                      href={`/blog/${post.id}`}
                      class="block py-2 pl-2 text-sm hover:bg-light rounded"
                    >
                      <div class="flex">
                        <div>
                          <span class="text-[10px]">
                            By {post?.data.author?.name} -{" "}
                            {dateFormat(post?.data.date)}
                          </span>
                          <p class="text-sm line-clamp-1 font-medium text-text-dark">
                            {post?.data.title}
                          </p>
                        </div>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <!-- Social Share  -->
        <div class="bg-body rounded-2xl p-4 mt-5">
          <small class="font-semibold text-text-dark font-primary text-sm">
            {ui.shareHeading}
          </small>
          <Share
            slug={`blog/${slug}`}
            className="space-x-5 mt-2 text-xl pl-2"
            title={title}
            description={doc?.description}
            ui={shareUi}
          />
        </div>

        <!-- Subscribe to newsletter  -->
        {
          config.subscription_in_footer &&
            config.subscription_in_footer.enable && (
              <div class="bg-body rounded-2xl p-4 mt-5 hidden lg:block">
                <small class="font-semibold text-text-dark font-primary text-sm">
                  {ui.newsletterHeading}
                </small>

                <form
                  data-newsletter-form
                  action="/api/newsletter"
                  method="post"
                >
                  <div class="flex justify-between rounded-lg bg-light px-3 py-2 border border-border mb-5 mt-2">
                    <input
                      type="email"
                      placeholder={ui.newsletterPlaceholder}
                      class="form-input w-full rounded-full border-transparent! bg-transparent! py-2! pl-2! placeholder:opacity-100! placeholder:font-normal"
                      required
                      name="email"
                    />
                    <button
                      title={ui.subscribeButtonTitle}
                      class="transition hover:opacity-80 pr-2"
                      type="submit"
                    >
                      <svg
                        width="18"
                        height="18"
                        viewBox="0 0 18 18"
                        fill="none"
                      >
                        <path
                          fill-rule="evenodd"
                          clip-rule="evenodd"
                          d="M17.1772.0665905C17.3647-.0359303 17.5912-.0187131 17.7637.108851 17.9362.237198 18.0247.454761 17.994.673889L15.9315 15.152C15.9067 15.3234 15.81 15.476 15.6675 15.5668 15.5782 15.6231 15.477 15.6521 15.375 15.6521 15.3135 15.6521 15.252 15.6411 15.1935 15.6208L7.33126 12.8167 15.0622 3.09761 5.07152 12.0114.380282 10.3382C.168033 10.2623.0187833 10.062.00153335 9.8272-.0149666 9.5932.102783 9.37094.302282 9.26216L17.1772.0665905zM6.56261 17.413V13.7833l3.05024 1.0879-2.03474 2.8893C7.47011 17.9139 7.30061 18 7.12511 18 7.06661 18 7.00736 17.9906 6.94961 17.971 6.71861 17.8912 6.56261 17.6666 6.56261 17.413z"
                          fill="#070127"
                        />
                      </svg>
                    </button>
                  </div>
                  <p data-newsletter-hint class="text-xs text-text-light/70 mb-2">
                    {ui.newsletterHint}
                  </p>

                  <label
                    for="blog-newsletter-consent"
                    class="text-xs block"
                    style="line-height:normal"
                  >
                    <input
                      type="checkbox"
                      name="checkbox"
                      id="blog-newsletter-consent"
                      data-newsletter-consent
                      required
                      class="appearance-auto rounded-sm accent-primary ring-0"
                    />
                    <span>{ui.consentLabel}</span>
                    <a
                      href={config.privacy_url}
                      class="text-text-dark font-semibold hover:text-primary transition duration-300"
                    >
                      {ui.privacyLinkText}
                    </a>
                  </label>
                </form>
              </div>
            )
        }
      </aside>
    </div>
  </section>

  <section
    class="section bg-dark section-divider"
    style="--section-divider-color: var(--color-dark)"
  >
    <div class="container">
      {
        similarPosts.length > 0 && (
          <div>
            <h2
              class="text-center text-white text-balance mx-auto mb-12"
              set:html={markdownify(
                ui.similarPostsHeading ?? "",
              )}
            />
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {similarPosts.map((post: any) => (
                <CardPrimary
                  data={post.data}
                  id={`/blog/${post.id}`}
                  hasDarkArrow={true}
                />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  {doc?.faqs && doc.faqs.length > 0 && (
    <Faqs data={{ faqs_list: doc.faqs, section_title: ui.faqSectionTitle }} prefix="blog-faq" ui={settingsUi.faqs} />
  )}

  <CallToAction />
</Base>
