---
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Props = {
  /** Micro-label above the heading; keeps the label editable from markdown. */
  eyebrow?: string;
  title?: string;
  body: string;
  /** Tone only changes the accent color and chip tint — it never restates or edits the copy. */
  tone?: "neutral" | "critical" | "supportive";
  /** "callout" is the default band block; "aside" is a tighter inline-tint block; "card" is the elevated block for hero placements in long posts. */
  variant?: "callout" | "aside" | "card";
  anchor?: string;
  headingLevel?: "h2" | "h3";
};

const {
  eyebrow,
  title = "Honest take",
  body,
  tone = "neutral",
  variant = "callout",
  anchor,
  headingLevel = "h2",
} = Astro.props as Props;

const titleSlug = slugify(title);
const headingId = titleSlug === "honest-take" ? "honest-take" : `honest-take-${titleSlug}`;
const Heading = headingLevel;

const stripeClass =
  tone === "critical" ? "border-l-dark" : tone === "supportive" ? "border-l-secondary" : "border-l-primary";
const chipClass =
  tone === "critical" ? "bg-secondary/25" : tone === "supportive" ? "bg-primary/10" : "bg-light";
---

<section
  id={anchor}
  class:list={[
    variant === "card" ? "section" : "section-sm",
    "border-y border-border/70 overflow-x-hidden",
    variant === "aside" ? "bg-body" : "bg-light",
  ]}
  aria-labelledby={headingId}
>
  <div class="container mx-auto lg:w-[88%] xl:w-[80%]">
    <div
      class:list={[
        variant === "aside" ? "mx-auto max-w-2xl" : "mx-auto max-w-3xl",
        variant === "card"
          ? "rounded-xl border border-border bg-body p-6 pb-8 shadow-[0_1px_2px_rgba(18,18,18,0.04),0_16px_40px_-16px_rgba(18,18,18,0.14)] sm:p-9 sm:pb-10"
          : variant === "aside"
            ? `rounded-r-xl border border-l-4 ${stripeClass} border-border bg-light p-5 sm:p-6`
            : `rounded-xl border border-l-4 ${stripeClass} border-border bg-body p-6 sm:p-7`,
      ]}
    >
      {
        eyebrow && (
          <p class="mb-4 inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.14em] text-text-light">
            <span class="h-px w-8 bg-border" aria-hidden="true"></span>
            {eyebrow}
          </p>
        )
      }

      <Heading id={headingId} class:list={["flex items-start gap-2.5 min-w-0", variant === "card" ? "max-w-[24ch] text-balance" : "font-secondary text-h6 font-bold text-text-dark"]}>
        <svg
          class:list={["mt-1 shrink-0 text-primary", variant === "card" ? "h-5 w-5" : "h-4 w-4"]}
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
        </svg>
        <span class="min-w-0 break-words">{title}</span>
      </Heading>

      {
        variant === "card" && tone !== "neutral" ? (
          <p class:list={["mt-5 inline-flex items-center rounded-full px-3.5 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-text-dark", chipClass]}>
            {tone === "critical" ? "Critical perspective" : "Supportive perspective"}
          </p>
        ) : null
      }

      <div
        class:list={["content mt-3 max-w-[62ch] leading-relaxed text-text", variant === "aside" ? "text-sm" : "text-base"]}
        set:html={markdownify(body, true)}
      />
    </div>
  </div>
</section>
