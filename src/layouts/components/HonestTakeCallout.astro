---
import { bodyParts } from "@/lib/service/text";
import { slugify } from "@/lib/utils/textConverter";

type Props = {
  bg?: string;
  /** Micro-label above the heading; keeps the label editable from markdown. */
  eyebrow?: string;
  title?: string;
  body: string;
  /** Tone only changes the accent color and chip tint — it never restates or edits the copy. */
  tone?: "neutral" | "critical" | "supportive";
  /** "callout" is the default band block; "aside" is a tighter inline-tint block; "card" is the elevated block for hero placements in long posts. */
  variant?: "callout" | "aside" | "card";
  anchor?: string;
  headingLevel?: "h2" | "h3";
  ui?: { criticalLabel?: string; supportiveLabel?: string };
};

const {
  eyebrow,
  title,
  body,
  anchor,
  headingLevel = "h2",
  bg = "white",
} = Astro.props as Props;

const titleSlug = slugify(title);
const headingId = titleSlug === "honest-take" ? "honest-take" : `honest-take-${titleSlug}`;
const Heading = headingLevel;

const { html, parts } = bodyParts(body);
---

<section id={anchor} class:list={["sp-sec sp-sec-s", `hp-${bg}`]} aria-labelledby={headingId}>
  <div class="hp-in">
    <div class="sp-box sp-stack">
      <div class="sp-title">
        {eyebrow && <p class="sp-eyebrow">{eyebrow}</p>}
        <Heading id={headingId} class="sp-h2">{title}</Heading>
      </div>
      {parts && parts.every((p) => p.kind === "p")
        ? <div class="sp-cols" style={`--n:${Math.min(3, parts.length)}`}>{parts.map((p) => <p class="sp-box-p" set:html={p.html} />)}</div>
        : <div class="content sp-prose" set:html={html} />}
    </div>
  </div>
</section>
