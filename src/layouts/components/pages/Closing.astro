---
import { getClosingCta, getPartnerCta } from "@/lib/sanity/queries";
const { title } = Astro.props as { title?: string };
const cta = await getClosingCta();
const partner = await getPartnerCta();
const label = partner.label || cta?.primaryLabel, link = partner.link || cta?.primaryLink;
const email = "sales@marylandinsights.com";
// Keeps Cloudflare from swapping the address for a placeholder that breaks after in-page navigation.
const mail = `<!--email_off--><a class="pg-close-mail" href="mailto:${email}">${email}</a><!--/email_off-->`;
---

{cta && (
  <section class="pg-close" aria-labelledby="pg-close-title">
    <div class="pg-close-top">
      <img src="/images/pages/map-ink.svg" alt="" width="1012" height="536" loading="lazy" decoding="async" />
      <div class="hp-in"><h2 id="pg-close-title">{title ?? cta.title}</h2><p>{cta.description}</p></div>
    </div>
    <div class="pg-close-bar">
      {link && <a class="pg-close-go" href={link}>{label}</a>}
      <Fragment set:html={mail} />
    </div>
  </section>
)}
