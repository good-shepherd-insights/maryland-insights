---
import FlagBand from "./FlagBand.astro";
const { partners = [], title, label } = Astro.props as { partners: any[]; title: string; label?: string };
---

<section class="hp-partners" aria-label={label}>
  <FlagBand height={48} />
  <div class="hp-in hp-partners-in">
    <h2 class="hp-h2">{title}</h2>
    <ul>
      {partners.filter((p) => p?.name && p?.file).map((p) => (
        <li>
          <a href={p.url} target="_blank" rel="noopener noreferrer">
            <span class:list={["hp-partner-logo", { "hp-plate": /businessexpress/.test(p.file) }]}><img src={p.file} alt="" loading="lazy" /></span>
            <span>{p.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
