---
import { heroMaps } from "@/lib/home/heroArt.mjs";
import type { HomeCopy } from "@/lib/home/copy";

const { hero = {}, copy } = Astro.props as { hero: any; copy: HomeCopy };
// "More calls for Maryland businesses. Measured, not guessed."
const [lead = "", ...after] = copy.heroTitle.split(/(?<=\.)\s+/);
const claim = after.join(" ");
const comma = claim.indexOf(",");
const first = comma > 0 ? claim.slice(0, comma + 1) : claim;
const second = comma > 0 ? claim.slice(comma + 1).trim() : "";
// The first word is part of the title, so the heading reads as one real sentence.
// The others take turns in its place, in a block as wide as the widest of them.
const words = copy.heroWords;
const at = words.length > 1 ? lead.indexOf(` ${words[0]} `) : -1;
const before = lead.slice(0, at);
const behind = lead.slice(at + (words[0]?.length ?? 0) + 2);
const map = heroMaps(copy.counts);
const buttons = [hero?.buttonSolid, hero?.buttonUnderline].filter((b: any) => b?.label && b?.link);
const stats = (hero?.stats ?? []).filter((s: any) => s?.value && s?.label);
---

<section class="hp-hero" id="designs-banner">
  <div class="hp-hero-in">
    <h1 class="hp-hero-h">
      {at < 0 ? <span class="hp-hero-lead">{lead}</span> : (
        <span class="hp-hero-lead hp-hero-swap"><span>{before}</span>{" "}<span class="hp-words" data-hero-words><span class="hp-word hp-word-first" data-on><span>{words[0]}</span></span>{words.slice(1).map((w) => <span class="hp-word" aria-hidden="true"><span data-word={w}></span></span>)}<span class="hp-words-edge" aria-hidden="true"></span></span>{" "}<span>{behind}</span></span>
      )}{" "}
      {first && <span class="hp-hero-first">{first}</span>}{" "}
      {second && <span class="hp-hero-second">{second}</span>}
    </h1>
    {at >= 0 && (
      <button type="button" class="hp-words-btn" data-hero-words-btn data-pause={copy.heroPause} data-play={copy.heroPlay} aria-label={copy.heroPause}>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" fill="currentColor"><path class="hp-i-pause" d="M5 3h3.4v14H5zM11.6 3H15v14h-3.4z" /><path class="hp-i-play" d="M5 2.5L17 10L5 17.5Z" /></svg>
      </button>
    )}
    <div class="hp-hero-body">
      <p class="hp-hero-copy">{hero?.content}</p>
      <div class="hp-btns">
        {buttons.map((b: any, i: number) => <a href={b.link} class:list={["hp-btn", i === 0 ? "hp-btn-ink" : "hp-btn-line"]}>{b.label}</a>)}
      </div>
    </div>
    <div class="hp-hero-map">
      <picture>
        <source media="(min-width: 1024px)" srcset="/images/home/hero-map.svg" width="850" height="545" />
        <img src="/images/home/hero-map-mobile.svg" width="980" height="670" alt="Maryland raised by the number of businesses in each county, above the same map left blank" fetchpriority="high" />
      </picture>
      <svg class="hp-wide" viewBox={map.wide.box} aria-hidden="true">
        {map.wide.labels.map((l) => <text x={l.x} y={l.y} text-anchor="middle" font-size={l.size} font-weight="800">{l.calls}</text>)}
        <text class="hp-hero-tag" x="1298" y="554" font-size="24">{copy.heroMeasured}</text>
        <text class="hp-hero-tag" x="590" y="716" font-size="24" fill="#706A62">{copy.heroGuessed}</text>
      </svg>
      <svg class="hp-narrow" viewBox={map.narrow.box} aria-hidden="true">
        {map.narrow.labels.map((l) => <text x={l.x} y={l.y} text-anchor="middle" font-size={l.size} font-weight="800">{l.calls}</text>)}
        <text class="hp-hero-tag" x="10" y="94" font-size="40">{copy.heroMeasured}</text>
        <text class="hp-hero-tag" x="10" y="496" font-size="40" fill="#6E685F">{copy.heroGuessed}</text>
      </svg>
    </div>
    <p class="hp-hero-note">{copy.heroNote}</p>
    <dl class="hp-stats">
      {stats.map((s: any) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
    </dl>
  </div>
</section>

<script>
  const HOLD = 5000;
  const LOAD = 900;

  const start = () => {
    const box = document.querySelector<HTMLElement>("[data-hero-words]");
    const button = document.querySelector<HTMLButtonElement>("[data-hero-words-btn]");
    const edge = box?.querySelector<HTMLElement>(".hp-words-edge");
    if (!box || !button || !edge || "ready" in box.dataset) return;
    box.dataset.ready = "";
    const items = [...box.querySelectorAll<HTMLElement>(".hp-word")];
    const still = window.matchMedia("(prefers-reduced-motion: reduce)");
    let now = 0;
    let paused = false;
    let seen = true;
    let timer: number | undefined;

    const next = () => {
      const from = items[now];
      now = (now + 1) % items.length;
      const to = items[now];
      items.forEach((item) => item.removeAttribute("data-under"));
      from.removeAttribute("data-on");
      from.setAttribute("data-under", "");
      to.setAttribute("data-on", "");
      // Only transforms change, so nothing is repainted: the block slides in while its text
      // slides back by the same amount and stays put. One clock moves all three parts.
      const text = to.firstElementChild as HTMLElement;
      const place = (x: number) => {
        to.style.transform = `translateX(${x - 100}%)`;
        text.style.transform = `translateX(${100 - x}%)`;
        edge.style.transform = `translateX(${x}%)`;
      };
      let began = 0;
      const frame = (time: number) => {
        began ||= time;
        const t = Math.min(1, (time - began) / LOAD);
        place(100 * (t < 0.5 ? 4 * t ** 3 : 1 - (2 - 2 * t) ** 3 / 2));
        if (t < 1) requestAnimationFrame(frame);
      };
      place(0);
      requestAnimationFrame(frame);
    };

    const sync = () => {
      window.clearInterval(timer);
      if (!paused && seen && !still.matches && !document.hidden) timer = window.setInterval(next, HOLD);
    };

    button.addEventListener("click", () => {
      paused = !paused;
      button.toggleAttribute("data-paused", paused);
      button.setAttribute("aria-label", (paused ? button.dataset.play : button.dataset.pause) ?? "");
      sync();
    });
    still.addEventListener("change", sync);
    document.addEventListener("visibilitychange", sync);
    new IntersectionObserver(([entry]) => { seen = entry.isIntersecting; sync(); }).observe(box);
    button.setAttribute("data-ready", "");
    sync();
  };

  start();
  document.addEventListener("astro:page-load", start);
</script>
