---
import { drawing, serviceIcon } from "@/lib/home/serviceArt";
import ImageMod from "@/components/ImageMod.astro";
import type { HomeCopy } from "@/lib/home/copy";

const { stack = {}, copy } = Astro.props as { stack: any; copy: HomeCopy };
const TONES = ["ink", "gold", "cream", "red", "sand", "white"];
const NOTES: Record<string, string> = {
  "website-hosting": "The page exists before anyone asks for it. Nothing is assembled on the tap.",
  "local-seo": "Same line everywhere. Sample listing.",
  "analytics-reporting": "Page A wins. That is how pages are ranked here. One dot is 10 visits.",
};
const LISTINGS = [["Google", "google_business_profile"], ["Google Maps", "google_maps"], ["Yelp", "yelp"], ["Facebook", "facebook/facebook"], ["Apple", "apple"]];
const LISTING = "Your client, (410) 555-0142";
const rows = LISTINGS.map(([, file], k) =>
  `<rect x=".75" y="${138.75 + k * 48}" width="316.5" height="42.5" fill="#fff" stroke="#121212" stroke-width="1.5"></rect><image href="/images/icons/${file}.svg" x="12" y="${147 + k * 48}" width="26" height="26"></image><text x="50" y="${166 + k * 48}" font-size="16" font-weight="600" fill="#121212">${LISTING}</text>`).join("");
const cards = (stack?.cards ?? []).filter((c: any) => c?.label).map((c: any, i: number) => {
  const slug = String(c.button?.link ?? "").split("/").pop() ?? "";
  const tone = TONES[i % TONES.length];
  const wide = drawing(slug, "wide");
  return {
    ...c, slug, tone,
    icon: serviceIcon(c.image, tone, c.label),
    wide: slug === "local-seo" ? wide?.replace("</svg>", `${rows}</svg>`) : wide,
    narrow: drawing(slug, "narrow"),
    note: NOTES[slug],
    points: (c.points ?? []).filter((p: unknown) => typeof p === "string").map((p: string) => {
      const m = /^\*\*(.+?)\*\*:\s*(.+)$/s.exec(p);
      return m ? { label: m[1], text: m[2] } : { label: "", text: p };
    }),
  };
});
---

<section class="hp-services" id="be-the-answer">
  <div class="hp-in hp-services-head"><h2 class="hp-h2 hp-xl">{copy.servicesTitle}</h2></div>
  {cards.map((c: any, i: number) => (
    <article class:list={["hp-band", `hp-${c.tone}`, { "hp-flip": i % 2 === 1 }]}>
      <div class="hp-in hp-band-in">
        <div class="hp-band-text">
          {c.icon ? <Fragment set:html={c.icon} /> : c.image && <ImageMod src={c.image} alt={c.label} width={120} height={88} />}
          <h3>{c.label}</h3>
          <p>{c.description}</p>
          {c.button?.link && <a href={c.button.link}>{c.button.label}</a>}
        </div>
        <div class="hp-band-art">
          {c.wide && <div class="hp-wide" set:html={c.wide} />}
          {c.narrow && <div class="hp-narrow" set:html={c.narrow} />}
          {c.slug === "local-seo" && (
            <ul class="hp-narrow hp-listings">
              {LISTINGS.map(([name, file]) => <li><img src={`/images/icons/${file}.svg`} alt={name} width="26" height="26" loading="lazy" /><span>{LISTING}</span></li>)}
            </ul>
          )}
          {c.slug === "marketing-automation" && <p class="hp-sixty">60 seconds</p>}
          {c.note && <p class="hp-band-note">{c.note}</p>}
        </div>
        <details class="hp-points">
          <summary aria-label={`${copy.servicesIncluded}: ${c.label}`}>{copy.servicesIncluded}<svg width="20" height="20" viewBox="0 0 30 30" aria-hidden="true"><path d="M3 15H27M15 3V27" stroke="currentColor" stroke-width="3.5" /></svg></summary>
          <ul>{c.points.map((p: any) => <li>{p.label && <strong>{p.label}:</strong>} {p.text}</li>)}</ul>
        </details>
      </div>
    </article>
  ))}
</section>

<script>
  // Bullets are always open on wide screens and a toggle on phones.
  const wide = window.matchMedia("(min-width: 1024px)");
  const sync = () => {
    document.querySelectorAll<HTMLDetailsElement>(".hp-points").forEach((d) => { d.open = wide.matches; });
  };
  document.addEventListener("astro:page-load", sync);
  wide.addEventListener("change", sync);
</script>
