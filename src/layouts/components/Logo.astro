---
import ImageMod from "./ImageMod.astro";
import { getSiteSettings } from "@/lib/sanity/queries";

const {
  src,
  className,
  width,
  height,
  style,
  homeUrl,
}: {
  src?: string;
  className?: string;
  width?: number;
  height?: number;
  style?: any;
  homeUrl?: string;
} = Astro.props;

const settings = (await getSiteSettings()) ?? {};
const brand = String(settings.logoText || settings.siteTitle || "");
const brandWords = brand.split(/\s+/).filter(Boolean);
const logo = src || settings.logo;
const logoHeight = String(settings.logoHeight ?? "").replace("px", "");

// The mark is square; logoHeight from siteSettings drives its size.
const iconSize = height ? height : Number(logoHeight);
---

<a href={homeUrl ?? "/"} class={`navbar-brand inline-flex items-center gap-2 ${className ? className : ""}`}>
  {
    logo ? (
      <ImageMod
        src={logo}
        class="inline-block shrink-0"
        width={iconSize * 2}
        height={iconSize * 2}
        alt={brand}
        style={
          style
            ? style
            : {
                height: iconSize + "px",
                width: iconSize + "px",
              }
        }
        format={logo.endsWith(".svg") ? "svg" : "webp"}
      />
    ) : null
  }
  {
    brandWords.length > 0 ? (
      <span class="logo-wordmark text-text-dark text-[25px] font-semibold leading-[1.05] md:text-[29px]">
        {brandWords.map((word: string, i: number) => (
          <>{i > 0 && <br />}{word}</>
        ))}
      </span>
    ) : null
  }
</a>
