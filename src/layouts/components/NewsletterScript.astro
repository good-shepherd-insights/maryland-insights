---
// Submits the footer newsletter form. Shared by every footer.
---

<script>
  document.querySelectorAll<HTMLFormElement>("[data-newsletter-form]").forEach((newsletterForm) => {
    const consent = newsletterForm.querySelector<HTMLInputElement>("[data-newsletter-consent]");
    const submit = newsletterForm.querySelector<HTMLButtonElement>("[type=submit]");
    const submitIcon = newsletterForm.querySelector<HTMLElement>("[data-newsletter-submit-icon]");
    const successIcon = newsletterForm.querySelector<HTMLElement>("[data-newsletter-success-icon]");

    const hint = newsletterForm.querySelector<HTMLElement>("[data-newsletter-hint]");

    const setHint = (message: string, state: "neutral" | "success" | "error" = "neutral") => {
      if (!hint) return;
      hint.style.display = "block";
      hint.textContent = message;
      hint.classList.toggle("text-green-700", state === "success");
      hint.classList.toggle("text-red-700", state === "error");
      hint.classList.toggle("font-semibold", state !== "neutral");
    };

    const setSuccessIcon = (enabled: boolean) => {
      submitIcon?.classList.toggle("hidden", enabled);
      successIcon?.classList.toggle("hidden", !enabled);
    };

    const updateNewsletterState = () => {
      if (hint) {
        hint.style.display = consent?.checked === true ? "none" : "block";
      }
      setSuccessIcon(false);
    };

    consent?.addEventListener("change", updateNewsletterState);
    newsletterForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (consent && !consent.checked) {
        setHint(newsletterForm.dataset.uiAccepting ?? "", "error");
        return;
      }

      if (submit) submit.disabled = true;
      setSuccessIcon(false);
      setHint(newsletterForm.dataset.uiSubscribing ?? "");

      const res = await fetch("/api/newsletter", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: new FormData(newsletterForm).get("email") }),
      }).catch(() => null);

      if (res?.ok) {
        newsletterForm.reset();
        setSuccessIcon(true);
        setHint(newsletterForm.dataset.uiSubscribed ?? "", "success");
      } else {
        setSuccessIcon(false);
        setHint(newsletterForm.dataset.uiFailed ?? "", "error");
      }
      if (submit) submit.disabled = false;
    });
    updateNewsletterState();
  });
</script>
