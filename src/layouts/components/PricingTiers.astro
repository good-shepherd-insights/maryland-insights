---
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Tier = {
  name: string;
  /** Published price or honest label (e.g. "Custom quote"). Optional so a tier with no real number can omit it rather than invent one. */
  priceRange?: string;
  /** One-line plain description of what the tier is. */
  description?: string;
  includes?: string[];
  excludes?: string[];
  ctaLabel?: string;
  ctaHref?: string;
  /** When set, the card CTA is an email field plus submit button instead of a link. */
  collectEmail?: boolean;
  /** Highlight treatment carried over from the existing pricing surface: the ReplacesTable `isUs` tint adapted to a border tint plus the LeadCaptureForm pill. Pass a string to author the pill label; `true` renders "Recommended". */
  recommended?: boolean | string;
};

type Props = {
  bg?: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  tiers?: Tier[];
  disclaimer?: string;
  /** cards: tier cards side by side; table: tier rows in the ServiceTrust dl recipe. */
  variant?: "cards" | "table";
  anchor?: string;
  headingLevel?: "h2" | "h3";
  ui?: {
    recommendedLabel?: string;
    includedLabel?: string;
    notIncludedLabel?: string;
    emailLabel?: string;
    joiningLabel?: string;
    joinedLabel?: string;
    joinFailedLabel?: string;
  };
};

const {
  eyebrow,
  title,
  intro,
  tiers = [],
  disclaimer,
  anchor,
  headingLevel = "h2",
  ui,
  bg = "cream",
} = Astro.props as Props;

const headingId = `pricing-${slugify(title)}`;
const Heading = headingLevel;
const TierHeading = headingLevel === "h2" ? "h3" : "h4";

// Defensive: drop malformed tiers so the section can never render an empty card row.
const shown = tiers
  .filter((tier) => tier && typeof tier.name === "string" && tier.name.trim() !== "")
  .map((tier) => ({
    ...tier,
    includes: (tier.includes ?? []).filter((item) => typeof item === "string" && item.trim() !== ""),
    excludes: (tier.excludes ?? []).filter((item) => typeof item === "string" && item.trim() !== ""),
  }));

const count = shown.length;

// Authored label wins; `true` falls back to the plain word. Never fabricated by the component itself.
const recommendedLabel = (tier: Tier): string =>
  typeof tier.recommended === "string" && tier.recommended.trim() !== ""
    ? tier.recommended.trim()
    : tier.recommended === true
      ? ui?.recommendedLabel ?? ""
      : "";
---

{
  count > 0 && (
    <section id={anchor} class:list={["sp-sec", `hp-${bg}`]} aria-labelledby={headingId}>
      <div class="hp-in sp-stack">
        <div class="sp-title">
          {eyebrow && <p class="sp-eyebrow">{eyebrow}</p>}
          <Heading id={headingId} class="sp-h2 sp-h2-lg">{title}</Heading>
          {intro && <p class="sp-lead-p" set:html={markdownify(intro)} />}
        </div>
        <ul class="sp-tiers">
          {shown.map((tier) => (
            <li class="sp-tier">
              <div class="sp-tier-a hp-gold">
                {recommendedLabel(tier) !== "" && <p class="sp-strong">{recommendedLabel(tier)}</p>}
                <TierHeading class="sp-h3">{tier.name}</TierHeading>
                {tier.priceRange && <p class="sp-price">{tier.priceRange}</p>}
                {tier.description && <p set:html={markdownify(tier.description)} />}
                {tier.collectEmail && tier.ctaLabel && (
                  <form data-waitlist-form action="/api/waitlist" method="post" data-ui-joining={ui?.joiningLabel} data-ui-joined={ui?.joinedLabel} data-ui-failed={ui?.joinFailedLabel}>
                    <label for={`waitlist-email-${slugify(tier.name)}`}>{ui?.emailLabel}</label>
                    <input id={`waitlist-email-${slugify(tier.name)}`} name="email" type="email" autocomplete="email" required />
                    <button type="submit" class="hp-btn hp-btn-ink">{tier.ctaLabel}</button>
                    <p data-waitlist-status aria-live="polite" hidden></p>
                  </form>
                )}
                {!tier.collectEmail && tier.ctaLabel && tier.ctaHref && <a href={tier.ctaHref} class="hp-btn hp-btn-ink sp-btn">{tier.ctaLabel}</a>}
              </div>
              {tier.includes.length > 0 && <div class="sp-tier-b"><p class="sp-h3">{ui?.includedLabel}</p><ul class="sp-checks sp-checks-gold">{tier.includes.map((item) => <li class="on"><span set:html={markdownify(item)} /></li>)}</ul></div>}
              {tier.excludes.length > 0 && <div class="sp-tier-b"><p class="sp-h3">{ui?.notIncludedLabel}</p><ul class="sp-checks">{tier.excludes.map((item) => <li><span set:html={markdownify(item)} /></li>)}</ul></div>}
            </li>
          ))}
        </ul>
        {disclaimer && <p class="sp-small" set:html={markdownify(disclaimer)} />}
      </div>
    </section>
  )
}

<script>
  document.querySelectorAll<HTMLFormElement>("[data-waitlist-form]").forEach((form) => {
    const status = form.querySelector<HTMLElement>("[data-waitlist-status]");
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (button) button.disabled = true;
      if (status) {
        status.hidden = false;
        status.textContent = form.dataset.uiJoining ?? "";
      }

      const email = String(new FormData(form).get("email") ?? "");
      const res = await fetch("/api/waitlist", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      }).catch(() => null);

      if (status) {
        status.textContent = res?.ok ? form.dataset.uiJoined ?? "" : form.dataset.uiFailed ?? "";
      }
      if (res?.ok) form.reset();
      if (button) button.disabled = false;
    });
  });
</script>
