---
import { bodyParts } from "@/lib/service/text";
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Step = { number: string; title: string; description: string; details?: string };
type Props = { title: string; intro?: string; steps: Step[]; bg?: string };
const { title, intro, steps, bg = "cream" } = Astro.props as Props;
const headingId = `service-${slugify(title)}`;
const BANDS = ["sand", "gold", "red", "ink"];
---

<section aria-labelledby={headingId}>
  <div class:list={["sp-sec", `hp-${bg}`]}>
    <div class="hp-in sp-title">
      <h2 id={headingId} class="sp-h2 sp-h2-xl" set:html={markdownify(title)} />
      {intro && <p class="sp-lead-p" set:html={markdownify(intro)} />}
    </div>
  </div>
  <ol class="sp-stages">
    {steps.map((step, index) => {
      const { html, parts } = bodyParts(step.details);
      return (
        <li class={`hp-${BANDS[index % BANDS.length]}`}>
          <div class="hp-in sp-stage">
            <div><span class="sp-stage-n" aria-hidden="true">{step.number}</span><p>Stage {String(index + 1).padStart(2, "0")}</p></div>
            <div class="sp-stage-t"><h3 set:html={markdownify(step.title)} /><p set:html={markdownify(step.description)} /></div>
            {step.details && (parts && parts.every((p) => p.kind === "p")
              ? <div class="sp-stage-d">{parts.map((p) => <p set:html={p.html} />)}</div>
              : <div class="content sp-prose" set:html={html} />)}
          </div>
        </li>
      );
    })}
  </ol>
</section>
