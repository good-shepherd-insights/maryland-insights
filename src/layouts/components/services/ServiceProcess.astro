---
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Step = {
  number: string;
  title: string;
  description: string;
  details?: string;
};

type Props = {
  title: string;
  intro?: string;
  steps: Step[];
};

const { title, intro, steps } = Astro.props as Props;
const headingId = `service-${slugify(title)}`;
---

<section class="service-process section border-y border-border/70 bg-light" aria-labelledby={headingId}>
  <div class="container mx-auto lg:w-[88%] xl:w-[80%]">
    <div class="grid items-start gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:col-span-4 lg:self-start">
        <h2 id={headingId} class="text-balance text-5xl font-semibold leading-tight lg:text-[2.75rem] xl:text-5xl" set:html={markdownify(title)} />
        {intro && <p class="mt-5 max-w-md text-text-dark/75" set:html={markdownify(intro)} />}
      </div>

      <ol class="service-process-rail relative lg:col-span-8">
        {
          steps.map((step, index) => (
            <li class="service-process-step relative grid gap-5 pb-12 pl-16 last:pb-0 sm:grid-cols-[5rem_1fr] sm:gap-8 sm:pl-0">
              <div class="service-process-marker font-secondary absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-full border border-primary bg-light text-xs font-semibold tracking-[0.12em] text-text-dark sm:static sm:h-auto sm:w-auto sm:justify-center sm:rounded-none sm:border-0 sm:bg-transparent sm:pt-1 sm:text-5xl sm:font-normal sm:tracking-[-0.06em] sm:text-text-light">
                {step.number}
              </div>
              <div class="service-process-detail max-w-xl">
                <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-text-dark">
                  Stage {String(index + 1).padStart(2, "0")}
                </p>
                <h3 class="h4 mt-4 mb-3 text-balance" set:html={markdownify(step.title)} />
                <p class="text-text-dark/75" set:html={markdownify(step.description)} />
                {step.details && (
                  <div class="content mt-5 border-l-2 border-primary/40 pl-5 text-sm" set:html={markdownify(step.details, true) as string} />
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .service-process-rail::before {
    content: "";
    position: absolute;
    top: 1.25rem;
    bottom: 1.25rem;
    left: 1.25rem;
    width: 1px;
    background: var(--color-border);
  }

  .service-process-step:nth-child(even) .service-process-detail {
    margin-left: 0;
  }

  @media (min-width: 640px) {
    .service-process-rail::before {
      left: 2.5rem;
    }

    .service-process-step:nth-child(even) .service-process-detail {
      margin-left: 2rem;
    }
  }

  @media (max-width: 639px) {
    .service-process-step::before {
      content: "";
      position: absolute;
      top: 2.5rem;
      bottom: 0;
      left: 1.25rem;
      width: 1px;
      background: var(--color-border);
    }

    .service-process-step:last-child::before {
      display: none;
    }
  }
</style>
