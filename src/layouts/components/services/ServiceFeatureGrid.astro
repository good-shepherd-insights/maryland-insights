---
import ImageMod from "@/components/ImageMod.astro";
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Feature = { title: string; description: string; icon?: string };
type Props = { title: string; items: Feature[]; bg?: string };
const { title, items, bg = "white" } = Astro.props as Props;
const headingId = `service-${slugify(title)}`;
---

<section class:list={["sp-sec", `hp-${bg}`]} aria-labelledby={headingId}>
  <div class="hp-in sp-stack">
    <h2 id={headingId} class="sp-h2 sp-h2-lg" set:html={markdownify(title)} />
    <div class="sp-feats">
      {items.map((item, index) => (
        <article class="sp-feat">
          <span class="sp-feat-n">{String(index + 1).padStart(2, "0")}</span>
          <div>
            {item.icon && <ImageMod src={item.icon} width={32} height={32} alt="" aria-hidden="true" />}
            <h3 set:html={markdownify(item.title)} />
            <p set:html={markdownify(item.description)} />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
