---
import ImageMod from "@/components/ImageMod.astro";
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Feature = {
  title: string;
  description: string;
  icon?: string;
};

type Props = {
  eyebrow?: string;
  title: string;
  items: Feature[];
};

const { eyebrow, title, items } = Astro.props as Props;
const headingId = `service-${slugify(title)}`;
---

<section class="section-sm border-y border-border/70 bg-body" aria-labelledby={headingId}>
  <div class="container">
    <div class="mb-10 max-w-2xl">
      {
        eyebrow && (
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-text-light">
            {eyebrow}
          </p>
        )
      }
      <h2 id={headingId} class="text-balance" set:html={markdownify(title)} />
    </div>

    <div class="grid gap-x-8 gap-y-0 md:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item, index) => (
          <article class="border-t border-border py-7 lg:py-8">
            <div class="mb-5 flex items-center gap-3">
              {item.icon && (
                <ImageMod
                  src={item.icon}
                  width={32}
                  height={32}
                  alt=""
                  aria-hidden="true"
                  class="h-8 w-8 object-contain"
                />
              )}
              <span class="text-xs font-semibold tracking-[0.12em] text-text-light">
                {String(index + 1).padStart(2, "0")}
              </span>
            </div>
            <h3 class="h5 mb-2 text-balance" set:html={markdownify(item.title)} />
            <p class="text-text-dark/75" set:html={markdownify(item.description)} />
          </article>
        ))
      }
    </div>
  </div>
</section>
