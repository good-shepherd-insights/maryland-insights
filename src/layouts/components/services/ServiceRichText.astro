---
import { bodyParts } from "@/lib/service/text";
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Props = { title: string; body: string; tone?: string; eyebrow?: string; headingLevel?: "h1" | "h2"; bg?: string };
const { title, body, eyebrow, headingLevel = "h2", bg = "white" } = Astro.props as Props;
const Heading = headingLevel;
const headingId = `service-${slugify(title)}`;
const { html, parts } = bodyParts(body);
const hasList = parts?.some((p) => p.kind === "list");
// Short copy reads as columns, long copy as a ledger, lists as rows.
const layout = !parts ? "plain" : hasList ? "rows" : parts.length > 3 ? "ledger" : "columns";
---

<section class:list={["sp-sec", `hp-${bg}`]} aria-labelledby={headingId}>
  <div class="hp-in sp-stack">
    <div class="sp-title">
      {eyebrow && <p class="sp-eyebrow">{eyebrow}</p>}
      <Heading id={headingId} class="sp-h2 sp-h2-lg" set:html={markdownify(title)} />
    </div>
    {layout === "plain" && <div class="content sp-prose" set:html={html} />}
    {layout === "columns" && <div class="sp-cols" style={`--n:${parts!.length}`}>{parts!.map((p) => <p class="sp-rule" set:html={p.html} />)}</div>}
    {layout === "ledger" && (
      <div>
        {parts!.map((p) => p.number ? (
          <div class="sp-ledger sp-ledger-n"><span class="sp-ledger-num">{p.number}.</span><p set:html={p.rest} /></div>
        ) : p.lead ? (
          <div class="sp-ledger"><p class="sp-ledger-lead"><strong set:html={p.lead} /></p><p set:html={p.rest} /></div>
        ) : (
          <p class="sp-ledger-full" set:html={p.html} />
        ))}
      </div>
    )}
    {layout === "rows" && (
      <div class="sp-rows">
        {parts!.map((p) => p.kind === "list" ? (
          <ul>{p.items!.map((item) => item.lead ? <li class="sp-row"><strong set:html={item.lead} /><span set:html={item.rest} /></li> : <li class="sp-row-full" set:html={item.rest} />)}</ul>
        ) : <p set:html={p.html} />)}
      </div>
    )}
  </div>
</section>
