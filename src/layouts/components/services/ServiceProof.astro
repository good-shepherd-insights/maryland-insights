---
import { figures } from "@/lib/service/text";
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Props = {
  title: string; anchorTitle?: string; metricLabel: string; before: string; after: string; context: string; sourceLabel?: string; sourceUrl?: string; changes?: string; bg?: string;
  ui?: { beforeLabel?: string; afterLabel?: string; contextLabel?: string; changesLabel?: string };
};
const { title, anchorTitle, metricLabel, before, after, context, sourceLabel, sourceUrl, changes, ui, bg = "gold" } = Astro.props as Props;
const headingId = `service-${slugify(anchorTitle ?? title)}`;
const rows = [{ label: ui?.beforeLabel, value: before, nums: figures(before), side: "before" }, { label: ui?.afterLabel, value: after, nums: figures(after), side: "after" }];
// Bars only when both sides are numbers, always to the same scale. Words get equal panels.
const measured = rows.every((r) => r.nums.length > 0 && r.nums.length <= 2);
const max = Math.max(...rows.flatMap((r) => r.nums), 1);
const share = (n: number) => ((n / max) * 100).toFixed(2);
---

<section class:list={["sp-sec", `hp-${bg}`]} aria-labelledby={headingId}>
  <div class="hp-in"><figure class="sp-stack">
    <div class="sp-head sp-head-end">
      <h2 id={headingId} class="sp-h2 sp-h2-lg" set:html={markdownify(title)} />
      <p class="sp-metric">{metricLabel}</p>
    </div>
    <div class="sp-proof">
      {rows.map((row) => (
        <div class="sp-proof-row">
          <p class="sp-proof-l">{row.label}</p>
          {measured ? (
            <div class={`sp-bar sp-bar-${row.side}`}>
              <span aria-hidden="true" style={`--w:${share(row.nums[0])}`}></span>
              {row.nums.length > 1 && <span aria-hidden="true" class="sp-bar-range" style={`--w:${share(row.nums[1] - row.nums[0])}`}></span>}
              <p class="sp-bar-v">{row.value}</p>
            </div>
          ) : (
            <p class={`sp-word sp-word-${row.side}`}>{row.value}</p>
          )}
        </div>
      ))}
    </div>
    <figcaption class="sp-two">
      <div class="sp-rule"><p class="sp-strong">{ui?.contextLabel}</p><p set:html={markdownify(context)} /></div>
      {changes && <div class="sp-rule"><p class="sp-strong">{ui?.changesLabel}</p><div class="content sp-prose" set:html={markdownify(changes, true) as string} /></div>}
    </figcaption>
    {sourceLabel && sourceUrl && <a class="sp-link" href={sourceUrl} target="_blank" rel="noopener noreferrer">Source: {sourceLabel}</a>}
  </figure></div>
</section>
