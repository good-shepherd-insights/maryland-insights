---
// The result that takes the place of the hero's art, text and points once a website has been read.
---

<div class="sc-result" data-schema-result tabindex="-1" hidden>
  <div class="sc-top">
    <img data-schema-logo alt="" width="52" height="52" referrerpolicy="no-referrer" hidden />
    <div><p>Website schema</p><h2 data-schema-name></h2></div>
    <p class="sc-count" data-schema-count></p>
  </div>
  <p class="sc-note" data-schema-note hidden></p>
  <ul data-schema-rows></ul>
</div>

<script>
  type Row = { label: string; value: string; status: "found" | "blank" | "missing" | "generic" };
  type Result = { name: string; logo: string | null; hasSchema: boolean; invalidBlocks: number; hasMicrodata: boolean; rows: Row[] };

  const ICON = { yes: "M4 12l5 5L20 6", no: "M6 6l12 12M18 6L6 18" };
  const SAY: Record<string, string> = {
    "bad-address": "Enter a website address, such as yourbusiness.com.",
    "rate-limited": "Too many checks. Please try again in a few minutes.",
  };
  const NS = "http://www.w3.org/2000/svg";

  function rowFor(row: Row): HTMLLIElement {
    const ok = row.status === "found";
    const li = document.createElement("li");
    if (!ok) li.className = "sc-no";
    const svg = document.createElementNS(NS, "svg");
    svg.setAttribute("viewBox", "0 0 24 24");
    svg.setAttribute("aria-hidden", "true");
    const path = document.createElementNS(NS, "path");
    path.setAttribute("d", ok ? ICON.yes : ICON.no);
    svg.append(path);
    const label = document.createElement("strong");
    label.textContent = row.label;
    const value = document.createElement("span");
    value.textContent = row.status === "generic" ? `${row.value}, not a local business` : ok ? row.value : row.status === "blank" ? "Left blank" : "Missing";
    li.append(svg, label, value);
    return li;
  }

  function bind() {
    document.querySelectorAll<HTMLFormElement>("form[data-schema-check]").forEach((form) => {
      if ("ready" in form.dataset) return;
      form.dataset.ready = "";
      const section = form.closest("section");
      const panel = section?.querySelector<HTMLElement>("[data-schema-result]");
      const status = form.querySelector<HTMLElement>(".lead-capture-status");
      const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
      const input = form.querySelector<HTMLInputElement>("input[name=business]");
      const heading = section?.querySelector<HTMLElement>(".lead-heading");
      if (!section || !panel || !status || !button || !input || !heading) return;
      const prefix = (heading.textContent ?? "").trim().match(/^(.*?\bfor)\s/i)?.[1];
      const first = button.textContent ?? "";
      const part = (name: string) => panel.querySelector<HTMLElement>(`[data-schema-${name}]`)!;

      function show(result: Result) {
        const good = result.rows.filter((r) => r.status === "found").length;
        if (prefix) {
          const words = prefix.split(" "), half = Math.ceil(words.length / 2);
          const br = () => document.createElement("br");
          heading!.replaceChildren(words.slice(0, half).join(" "), br(), words.slice(half).join(" "), br(), result.name);
          heading!.toggleAttribute("data-long", result.name.split(/\s/).some((w) => w.length > 15));
        }
        part("name").textContent = result.name;
        const bad = document.createElement("span");
        bad.textContent = `${result.rows.length - good} missing`;
        part("count").replaceChildren(`${good} found, `, bad);
        part("rows").replaceChildren(...result.rows.map(rowFor));
        const notes = [
          !result.hasSchema && !result.invalidBlocks && "No JSON-LD schema on this homepage. It may be on another page of the site.",
          result.invalidBlocks > 0 && `${result.invalidBlocks} schema ${result.invalidBlocks === 1 ? "block has" : "blocks have"} an error and could not be read.`,
          result.hasMicrodata && "This homepage also has microdata, which this check does not read.",
        ].filter(Boolean) as string[];
        part("note").textContent = notes.join(" ");
        part("note").hidden = notes.length === 0;
        const logo = part("logo") as HTMLImageElement;
        logo.hidden = true;
        logo.removeAttribute("src");
        if (result.logo) {
          logo.onload = () => { logo.hidden = false; };
          logo.src = result.logo;
        }
        panel!.hidden = false;
        section!.setAttribute("data-schema-done", "");
        button!.textContent = "Check another website";
        input!.value = "";
        panel!.focus({ preventScroll: true });
        heading!.scrollIntoView({ block: "center" });
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const label = button.textContent ?? first;
        button.disabled = true;
        button.textContent = "Reading the website…";
        status.hidden = true;
        try {
          const response = await fetch("/api/schema-check", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
          const data = await response.json().catch(() => ({}));
          button.textContent = label;
          if (response.ok) show(data as Result);
          else throw new Error(data.error);
        } catch (error) {
          button.textContent = label;
          status.textContent = SAY[error instanceof Error ? error.message : ""] ?? "We could not read that website. Check the address and try again.";
          status.hidden = false;
        }
        button.disabled = false;
      });
    });
  }
  bind();
  document.addEventListener("astro:page-load", bind);
</script>
