---
import ImageMod from "@/components/ImageMod.astro";
import { getHomePage } from "@/lib/sanity/queries";
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Feature = { title: string; slug: string; subtitle?: string };
type Props = { title?: string; items: Feature[] };
const { title = "What this delivers for your clients", items } = Astro.props as Props;
const headingId = `service-${slugify(title)}`;
// Each feature's own drawing, from the homepage.
const home = await getHomePage();
const art = new Map<string, string>(((home?.features?.features ?? []) as any[]).map((f) => [String(f.button?.link ?? "").split("/").pop() ?? "", f.image]));
const one = items.length === 1;
---

<section class="sp-sec hp-ink" aria-labelledby={headingId}>
  {one ? (
    <div class="hp-in"><div class="sp-one">
      {art.get(items[0].slug) && <div class="sp-one-art"><ImageMod src={art.get(items[0].slug)!} alt="" width={522} height={396} loading="lazy" /></div>}
      <div class="sp-one-t hp-gold">
        <h2 id={headingId} class="sp-h3" set:html={markdownify(title)} />
        <a href={`/features/${items[0].slug}`} class="sp-rel-t"><h3>{items[0].title}</h3>{items[0].subtitle && <p>{items[0].subtitle}</p>}<span class="sp-link">See {items[0].title}</span></a>
      </div>
    </div></div>
  ) : (
    <div class="hp-in sp-side">
      <h2 id={headingId} class="sp-h2" set:html={markdownify(title)} />
      <div class="sp-rel">
        {items.map((item) => (
          <a href={`/features/${item.slug}`} class="sp-rel-a">
            {art.get(item.slug) && <span class="sp-rel-art"><ImageMod src={art.get(item.slug)!} alt="" width={522} height={396} loading="lazy" /></span>}
            <span class="sp-rel-t"><h3>{item.title}</h3>{item.subtitle && <p>{item.subtitle}</p>}<span class="sp-link">See {item.title}</span></span>
          </a>
        ))}
      </div>
    </div>
  )}
</section>
