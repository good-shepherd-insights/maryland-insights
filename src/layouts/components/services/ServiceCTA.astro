---
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Props = {
  title: string;
  description: string;
  buttonLabel: string;
  buttonLink: string;
};

const { title, description, buttonLabel, buttonLink } = Astro.props as Props;
const headingId = `service-${slugify(title)}`;
---

<section class="section service-cta section-divider bg-dark text-white" aria-labelledby={headingId}>
  <div class="container mx-auto lg:w-[88%] xl:w-[80%]">
    <div class="grid items-end gap-10 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-7">
        <h2 id={headingId} class="text-balance text-white" set:html={markdownify(title)} />
      </div>

      <div class="lg:col-span-5">
        <p class="max-w-xl text-lg leading-relaxed text-white/75" set:html={markdownify(description)} />
        <a href={buttonLink} class="btn mt-8 inline-flex border-secondary bg-secondary px-8 py-4 font-semibold text-dark transition hover:border-primary hover:bg-primary hover:text-white">
          {buttonLabel}
        </a>
      </div>
    </div>
  </div>
</section>
