---
import FlagBand from "@/components/home/FlagBand.astro";
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Props = { title: string; description: string; buttonLabel: string; buttonLink: string };
const { title, description, buttonLabel, buttonLink } = Astro.props as Props;
const headingId = `service-${slugify(title)}`;
---

<section class="sp-cta" aria-labelledby={headingId}>
  <FlagBand height={56} />
  <div class="sp-sec hp-ink">
    <div class="hp-in sp-head">
      <h2 id={headingId} class="sp-h2 sp-h2-xl" set:html={markdownify(title)} />
      <div class="sp-title sp-mid">
        <p class="sp-lead-p sp-mut" set:html={markdownify(description)} />
        {buttonLink && <a href={buttonLink} class="hp-btn hp-btn-gold sp-btn">{buttonLabel}</a>}
      </div>
    </div>
  </div>
</section>
