---
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Props = {
  title: string;
  intro: string;
  counties: string[];
};

const { title, intro, counties } = Astro.props as Props;
const headingId = `service-${slugify(title)}`;
---

<section class="section-sm border-y border-border/70 bg-body" aria-labelledby={headingId}>
  <div class="container mx-auto lg:w-[88%] xl:w-[80%]">
    <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <h2 id={headingId} class="text-balance" set:html={markdownify(title)} />
        <p class="mt-5 max-w-xl text-text-dark/75" set:html={markdownify(intro)} />
      </div>

      <div class="lg:col-span-7">
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.14em] text-text-light">Areas named in our work</p>
        <ul class="grid border-t border-border sm:grid-cols-2">
          {
            counties.map((county, index) => (
              <li class="flex items-baseline gap-4 border-b border-border py-5 sm:pr-6">
                <span class="text-xs font-semibold tracking-[0.12em] text-primary">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="text-lg text-text-dark">{county}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
