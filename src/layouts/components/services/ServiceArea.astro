---
import { LAND } from "@/lib/home/land";
import { mapName } from "@/lib/service/text";
import { markdownify, slugify } from "@/lib/utils/textConverter";

type County = { name: string; edoUrl?: string };
type Props = { title: string; intro: string; counties: (string | County)[]; bg?: string; ui?: { namedAreasLabel?: string; newTabNote?: string; countyLinksNote?: string } };
const { title, intro, counties, ui, bg = "ink" } = Astro.props as Props;
const headingId = `service-${slugify(title)}`;
const items = counties.map((c) => (typeof c === "string" ? { name: c } : c)) as County[];
const hasLinks = items.some((c) => c.edoUrl);
const named = new Set(items.map((c) => mapName(c.name)));
---

<section class:list={["sp-sec", "sp-area", `hp-${bg}`]} aria-labelledby={headingId}>
  <div class="hp-in sp-side">
    <div class="sp-title">
      <h2 id={headingId} class="sp-h2" set:html={markdownify(title)} />
      <p class="sp-mut" set:html={markdownify(intro)} />
    </div>
    <div class="sp-title">
      <svg class="sp-map" viewBox="-4 -4 1008 532" aria-hidden="true">{Object.entries(LAND).map(([name, d]) => <path class:list={[{ on: named.has(name) }]} d={d} />)}</svg>
      <div>
        <p class="sp-area-l">{ui?.namedAreasLabel}</p>
        <ul class="sp-counties">
          {items.map((county, index) => (
            <li>
              <span class="sp-n">{String(index + 1).padStart(2, "0")}</span>
              {county.edoUrl
                ? <a href={county.edoUrl} target="_blank" rel="noopener noreferrer">{county.name}<span class="sr-only"> {ui?.newTabNote}</span></a>
                : <span>{county.name}</span>}
            </li>
          ))}
        </ul>
        {hasLinks && <p class="sp-small sp-mut">{ui?.countyLinksNote}</p>}
      </div>
    </div>
  </div>
</section>
