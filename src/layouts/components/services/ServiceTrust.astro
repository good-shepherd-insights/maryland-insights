---
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Props = {
  title: string; intro: string; backupPolicy: string; uptimePolicy: string; migrationPolicy: string; included: string[]; extraCost: string[]; bg?: string;
  ui?: { backupsLabel?: string; uptimeLabel?: string; migrationLabel?: string; includedLabel?: string; extraCostLabel?: string };
};
const { title, intro, backupPolicy, uptimePolicy, migrationPolicy, included, extraCost, ui, bg = "white" } = Astro.props as Props;
const headingId = `service-${slugify(title)}`;
const policies = [[ui?.backupsLabel, backupPolicy], [ui?.uptimeLabel, uptimePolicy], [ui?.migrationLabel, migrationPolicy]];
---

<section aria-labelledby={headingId}>
  <div class:list={["sp-sec", `hp-${bg}`]}>
    <div class="hp-in sp-stack">
      <div class="sp-title">
        <h2 id={headingId} class="sp-h2 sp-h2-lg" set:html={markdownify(title)} />
        <p class="sp-lead-p sp-mut" set:html={markdownify(intro)} />
      </div>
      <dl class="sp-cols" style="--n:3">
        {policies.map(([label, text]) => <div class="sp-rule sp-rule-3"><dt class="sp-label">{label}</dt><dd set:html={markdownify(text)} /></div>)}
      </dl>
    </div>
  </div>
  <div class="sp-split">
    <div class="hp-gold"><h3 class="sp-h3">{ui?.includedLabel}</h3><ul class="sp-checks">{included.map((item) => <li class="on"><span set:html={markdownify(item)} /></li>)}</ul></div>
    <div class="hp-sand"><h3 class="sp-h3">{ui?.extraCostLabel}</h3><ul class="sp-checks">{extraCost.map((item) => <li><span set:html={markdownify(item)} /></li>)}</ul></div>
  </div>
</section>
