---
import CompanyLogo from "../../components/CompanyLogo.astro";
import config from "@/config/config.json";

type Plan = { label: string; logo?: string; isUs?: boolean };
type Row = { name: string; description?: string; values: string[] };
type Category = { category: string; rows: Row[] };

type Props = {
  categories: Category[];
  planNames: Plan[];
};

const { categories, planNames } = Astro.props;
const VISIBLE_ROWS = 4;
---

<div class="md:hidden flex flex-col gap-8">
  {
    planNames.map((plan, planIndex) => (
      <div class="rounded-xl border border-border overflow-hidden">
        <div class="bg-light border-b border-border p-6 flex items-center justify-center">
          {plan.isUs ? (
            <img src={config.site.logo} alt={plan.label} class="h-7 w-auto" />
          ) : plan.logo ? (
            <CompanyLogo name={plan.label} domain={plan.logo} size={96} format="webp" class="h-7 w-auto" />
          ) : null}
        </div>

        <div class="flex flex-col">
          {categories.map((category, catIndex) => (
            <div>
              <div class="p-3 px-6 bg-light/50 border-b border-border text-xs font-bold tracking-wide text-text-light">
                {category.category}
              </div>
              {category.rows.map((row, i) => {
                const value = row.values[planIndex];
                const isLastRow = i === category.rows.length - 1;
                const isExtra = i >= VISIBLE_ROWS;
                const key = `${planIndex}-${catIndex}`;
                return (
                  <div
                    class={`p-6 flex items-start justify-between gap-3 ${!isLastRow ? "border-b border-border" : ""} ${isExtra ? "hidden" : ""}`}
                    data-category-extra={isExtra ? key : undefined}
                  >
                    <div>
                      <h3 class="font-semibold">{row.name}</h3>
                      {row.description && (
                        <p class="mt-1 text-sm text-text-dark/70">{row.description}</p>
                      )}
                    </div>
                    {value === "active" ? (
                      <img src="/images/icons/active.svg" alt={`${row.name}: Included`} />
                    ) : value === "cross" ? (
                      <img src="/images/icons/cross.svg" alt={`${row.name}: Not included`} />
                    ) : (
                      <span class="text-sm shrink-0"><span class="sr-only">{row.name}: </span>{value}</span>
                    )}
                  </div>
                );
              })}
              {category.rows.length > VISIBLE_ROWS && (
                <div class="p-3 px-6 border-b border-border text-center">
                  <button
                    type="button"
                    class="text-sm font-semibold text-primary hover:underline"
                    data-category-toggle={`${planIndex}-${catIndex}`}
                    data-more-label={`View ${category.rows.length - VISIBLE_ROWS} more`}
                    data-less-label="View less"
                  >
                    {`View ${category.rows.length - VISIBLE_ROWS} more`}
                  </button>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-category-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.categoryToggle;
      const rows = document.querySelectorAll<HTMLElement>(`[data-category-extra="${id}"]`);
      const expanded = rows[0]?.classList.contains("hidden") === false;
      rows.forEach((row) => row.classList.toggle("hidden", expanded));
      btn.textContent = expanded ? btn.dataset.moreLabel ?? "View more" : btn.dataset.lessLabel ?? "View less";
    });
  });
</script>
