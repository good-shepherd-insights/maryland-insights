---
import { markdownify } from "@/lib/utils/textConverter";

type SocialLink = {
  platform: string;
  url: string;
};

type Reviewer = {
  name: string;
  role?: string;
};

type Props = {
  name: string;
  role: string;
  image?: string;
  bio?: string;
  socialLinks?: SocialLink[];
  datePublished?: string;
  dateModified?: string;
  reviewer?: Reviewer;
  variant?: "inline" | "card" | "minimal";
  /** Optional extra classes on the outer wrapper (spacing handled by the host layout). */
  className?: string;
  locale?: string;
  ui?: {
    publishedLabel?: string;
    updatedLabel?: string;
    byPrefix?: string;
    writtenByLabel?: string;
    reviewedByTemplate?: string;
  };
};

const {
  name,
  role,
  image,
  bio,
  socialLinks = [],
  datePublished,
  dateModified,
  reviewer,
  className,
  locale,
  ui,
} = Astro.props as Props;

const formatDate = (iso?: string): string | undefined => {
  if (!iso) return undefined;
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return undefined;
  return new Intl.DateTimeFormat(locale?.replace("_", "-"), {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(date);
};

const publishedText = formatDate(datePublished);
const modifiedText = formatDate(dateModified);


const linkedinIcon = "/images/integrations/linkedin.svg";

const hasSocialLinks = socialLinks.length > 0;
const displayName = name;
const reviewerName = reviewer?.name;
const reviewerRole = reviewer?.role;
const reviewerLabelText = reviewerName && ui?.reviewedByTemplate
  ? ui.reviewedByTemplate.replace("{name}", reviewerName).replace("{role}", reviewerRole ? `, ${reviewerRole}` : "")
  : undefined;
---

<div class:list={["sp-by", className]}>
  <div class="sp-by-who">
    {image
      ? <img src={image} alt={name} loading="lazy" width="48" height="48" />
      : <span class="sp-by-in" aria-hidden="true"><img src={linkedinIcon} alt="" width="30" height="30" loading="lazy" /></span>}
    <address>
      {ui?.writtenByLabel && <p class="sp-small">{ui.writtenByLabel}</p>}
      <p><strong>{displayName}</strong>{role && <>{" — "}{role}</>}</p>
      {reviewerLabelText && <p class="sp-small">{reviewerLabelText}</p>}
      {bio && <p class="sp-small" set:html={markdownify(bio)} />}
    </address>
  </div>
  <div class="sp-by-dates">
    {publishedText && <p>{ui?.publishedLabel && <span>{ui.publishedLabel} </span>}<time datetime={datePublished}>{publishedText}</time></p>}
    {modifiedText && <p>{ui?.updatedLabel && <span>{ui.updatedLabel} </span>}<time datetime={dateModified}>{modifiedText}</time></p>}
  </div>
  {hasSocialLinks && <ul class="sp-by-social">{socialLinks.map((link) => <li><a href={link.url} target="_blank" rel="me noopener noreferrer">{link.platform}</a></li>)}</ul>}
</div>
