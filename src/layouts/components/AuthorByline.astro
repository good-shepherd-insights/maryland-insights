---
import { markdownify } from "@/lib/utils/textConverter";

type SocialLink = {
  platform: string;
  url: string;
};

type Reviewer = {
  name: string;
  role?: string;
};

type Props = {
  name: string;
  role: string;
  image?: string;
  bio?: string;
  socialLinks?: SocialLink[];
  datePublished?: string;
  dateModified?: string;
  reviewer?: Reviewer;
  variant?: "inline" | "card" | "minimal";
  /** Optional extra classes on the outer wrapper (spacing handled by the host layout). */
  className?: string;
};

const {
  name,
  role,
  image,
  bio,
  socialLinks = [],
  datePublished,
  dateModified,
  reviewer,
  variant = "inline",
  className,
} = Astro.props as Props;

const formatDate = (iso?: string): string | undefined => {
  if (!iso) return undefined;
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return undefined;
  return new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(date);
};

const publishedText = formatDate(datePublished);
const modifiedText = formatDate(dateModified);

const initials = name
  .trim()
  .split(/\s+/)
  .slice(0, 2)
  .map((word) => word.charAt(0).toUpperCase())
  .join("");

const socialIconPaths: Record<string, string> = {
  x: '<path d="M2.8 2.8l10.4 10.4"/><path d="M13.2 2.8L2.8 13.2"/>',
  linkedin:
    '<rect x="1.9" y="1.9" width="12.2" height="12.2" rx="2.6"/><circle cx="5.1" cy="5.1" r="0.85" fill="currentColor" stroke="none"/><path d="M5.1 7.7v4.1"/><path d="M8.4 11.8V7.7"/><path d="M8.4 9.4c0-1 .7-1.7 1.7-1.7s1.5.8 1.5 1.9v2.2"/>',
  facebook:
    '<circle cx="8" cy="8" r="6.1"/><path d="M10.3 5.3H9.1c-.9 0-1.5.6-1.5 1.5v7.9"/><path d="M6.7 8.7h3.2"/>',
  instagram:
    '<rect x="2" y="2" width="12" height="12" rx="3.5"/><circle cx="8" cy="8" r="2.6"/><circle cx="11.5" cy="4.6" r="0.6" fill="currentColor" stroke="none"/>',
  youtube:
    '<rect x="1.5" y="3.4" width="13" height="9.2" rx="2.6"/><path d="M6.8 6.3l3.7 1.7-3.7 1.7z" fill="currentColor" stroke-linejoin="round"/>',
  website:
    '<circle cx="8" cy="8" r="6.1"/><path d="M1.9 8h12.2"/><path d="M8 1.9c1.8 1.7 2.8 3.9 2.8 6.1s-1 4.4-2.8 6.1c-1.8-1.7-2.8-3.9-2.8-6.1s1-4.4 2.8-6.1z"/>',
};

const socialIconKey = (platform: string): string | undefined => {
  const p = platform.toLowerCase();
  if (p === "x" || p.includes("twitter")) return "x";
  if (p.includes("linkedin")) return "linkedin";
  if (p.includes("facebook")) return "facebook";
  if (p.includes("instagram")) return "instagram";
  if (p.includes("youtube")) return "youtube";
  if (p.includes("website") || p.includes("homepage") || p.includes("portfolio")) return "website";
  return undefined;
};

const hasSocialLinks = socialLinks.length > 0;
const linkedInUrl = socialLinks.find((l) => socialIconKey(l.platform) === "linkedin")?.url;
const reviewerName = reviewer?.name;
const reviewerLabelText = reviewerName
  ? `Reviewed by ${reviewerName}${reviewer?.role ? `, ${reviewer.role}` : ""}`
  : undefined;
const hasDates = Boolean(publishedText || modifiedText);
const checkPath = "M2.5 8.5l3.5 3.5 7.5-8";
---

<div class:list={[`author-byline author-byline-${variant}`, "min-w-0", className]}>
  {
    variant === "card" && (
      <div class="ab-hoverzone min-w-0 rounded-xl border border-border bg-body p-6 shadow-[0_1px_2px_rgba(18,18,18,0.04),0_16px_40px_-16px_rgba(18,18,18,0.14)] sm:p-8">
        <div class="flex min-w-0 flex-col gap-5 sm:flex-row sm:items-start sm:gap-6">
          <span class="ab-ring shrink-0 self-start rounded-full border border-primary/40 p-[3px]">
            {image ? (
              <img
                src={image}
                alt={name}
                loading="lazy"
                width="64"
                height="64"
                class="h-16 w-16 rounded-full object-cover"
              />
            ) : (
              <span
                class="grid h-16 w-16 place-items-center rounded-full bg-light font-secondary text-lg font-bold text-text-dark"
                aria-hidden="true"
              >
                {initials}
              </span>
            )}
          </span>

          <div class="min-w-0 flex-1">
            <p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.14em] text-text-light">
              <span class="ab-rule" aria-hidden="true"></span>
              Written by
            </p>
            <address class="not-italic mt-2">
              <p class="break-words text-balance font-secondary text-h5 font-bold leading-[1.15] text-text-dark">
                {name}
              </p>
              {
                role && (
                  <p class="mt-2 break-words text-xs font-semibold uppercase tracking-[0.14em] text-text-light">
                    {role}
                  </p>
                )
              }
            </address>
          </div>
        </div>

        {
          bio && (
            <p
              class="mt-5 max-w-[62ch] leading-relaxed text-text"
              set:html={markdownify(bio)}
            />
          )
        }

        {
          (hasDates || reviewerLabelText) && (
            <div class="mt-6 flex flex-wrap items-end gap-x-8 gap-y-4 border-t border-border pt-5">
              {
                publishedText && (
                  <div class="min-w-0">
                    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-text-light">
                      Published
                    </p>
                    <p class="mt-1 break-words font-secondary text-sm font-semibold tabular-nums text-text-dark">
                      <time datetime={datePublished}>{publishedText}</time>
                    </p>
                  </div>
                )
              }
              {
                modifiedText && (
                  <div class="min-w-0">
                    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-text-light">
                      Updated
                    </p>
                    <p class="mt-1 break-words font-secondary text-sm font-semibold tabular-nums text-text-dark">
                      <time datetime={dateModified}>{modifiedText}</time>
                    </p>
                  </div>
                )
              }
              {
                reviewerLabelText && (
                  <div class="flex min-w-0 items-center gap-2 sm:ml-auto">
                    <span class="grid size-6 shrink-0 place-items-center rounded-full border border-border text-text-dark">
                      <svg
                        class="h-3.5 w-3.5"
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d={checkPath} />
                      </svg>
                    </span>
                    <p class="break-words text-sm text-text">{reviewerLabelText}</p>
                  </div>
                )
              }
            </div>
          )
        }

        {
          hasSocialLinks && (
            <ul class="mt-5 flex list-none flex-wrap items-center gap-2 border-t border-border pt-4">
              {socialLinks.map((link) => {
                const iconKey = socialIconKey(link.platform);
                return (
                  <li class="min-w-0 list-none">
                    {iconKey && socialIconPaths[iconKey] ? (
                      <a
                        href={link.url}
                        target="_blank"
                        rel="me noopener noreferrer"
                        aria-label={link.platform}
                        class="grid size-9 place-items-center rounded-lg border border-border bg-light text-text transition-colors duration-200 hover:border-primary hover:text-primary"
                      >
                        <svg
                          class="h-4 w-4 shrink-0"
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                          set:html={socialIconPaths[iconKey]}
                        />
                      </a>
                    ) : (
                      <a
                        href={link.url}
                        target="_blank"
                        rel="me noopener noreferrer"
                        class="inline-flex max-w-full items-center rounded-lg border border-border bg-light px-3 py-2 text-xs font-semibold text-text transition-colors duration-200 hover:border-primary hover:text-primary"
                      >
                        <span class="break-words">{link.platform}</span>
                      </a>
                    )}
                  </li>
                );
              })}
            </ul>
          )
        }
      </div>
    )
  }

  {
    variant === "inline" && (
      <div class="ab-hoverzone flex min-w-0 flex-wrap items-center gap-x-5 gap-y-4">
        <span class="ab-ring shrink-0 rounded-full border border-border/80 p-[3px]">
          {image ? (
            <img
              src={image}
              alt={name}
              loading="lazy"
              width="44"
              height="44"
              class="h-11 w-11 rounded-full object-cover"
            />
          ) : (
            <span
              class="grid h-11 w-11 place-items-center rounded-full bg-light font-secondary text-sm font-bold text-text-dark"
              aria-hidden="true"
            >
              {initials}
            </span>
          )}
        </span>

        <address class="not-italic min-w-0 grow basis-48">
          <p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.14em] text-text-light">
            <span class="ab-rule" aria-hidden="true"></span>
            Written by
          </p>
          <p class="mt-1.5 break-words font-secondary text-base font-bold leading-snug text-text-dark">
            {linkedInUrl ? (
              <a
                href={linkedInUrl}
                target="_blank"
                rel="me noopener noreferrer"
                class="transition-colors hover:text-primary"
              >
                {name}
              </a>
            ) : (
              name
            )}
            {
              role && (
                <span class="font-primary text-sm font-medium text-text-light">
                  {" — "}
                  {role}
                </span>
              )
            }
          </p>
          {
            hasSocialLinks && (
              <ul class="mt-2 flex list-none flex-wrap items-center gap-2">
                {socialLinks.map((link) => {
                  const iconKey = socialIconKey(link.platform);
                  return (
                    <li class="min-w-0 list-none">
                      {iconKey && socialIconPaths[iconKey] && (
                        <a
                          href={link.url}
                          target="_blank"
                          rel="me noopener noreferrer"
                          aria-label={link.platform}
                          class="grid size-7 place-items-center rounded-lg border border-border bg-light text-text transition-colors duration-200 hover:border-primary hover:text-primary"
                        >
                          <svg
                            class="h-3.5 w-3.5 shrink-0"
                            viewBox="0 0 16 16"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                            set:html={socialIconPaths[iconKey]}
                          />
                        </a>
                      )}
                    </li>
                  );
                })}
              </ul>
            )
          }
          {
            reviewerLabelText && (
              <p class="mt-2 flex flex-wrap items-center gap-x-2 text-sm text-text">
                <svg
                  class="h-4 w-4 shrink-0 text-text-dark"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={checkPath} />
                </svg>
                <span class="break-words">{reviewerLabelText}</span>
              </p>
            )
          }
        </address>

        {
          hasDates && (
            <div class="min-w-0 shrink-0 space-y-1 sm:ml-auto sm:text-right">
              {
                publishedText && (
                  <p class="break-words text-sm text-text-light">
                    <span class="text-xs font-semibold uppercase tracking-[0.14em]">Published</span>
                    {" "}
                    <time datetime={datePublished} class="font-medium tabular-nums text-text-dark">
                      {publishedText}
                    </time>
                  </p>
                )
              }
              {
                modifiedText && (
                  <p class="break-words text-sm text-text-light">
                    <span class="text-xs font-semibold uppercase tracking-[0.14em]">Updated</span>
                    {" "}
                    <time datetime={dateModified} class="font-medium tabular-nums text-text-dark">
                      {modifiedText}
                    </time>
                  </p>
                )
              }
            </div>
          )
        }
      </div>
    )
  }

  {
    variant === "minimal" && (
      <address class="not-italic author-byline-minimal min-w-0">
        <p class="break-words text-sm leading-relaxed text-text">
          <span class="text-text-light">By </span>
          <span class="font-secondary font-bold text-text-dark">{name}</span>
          {
            role && (
              <span class="text-text-light">
                {", "}
                {role}
              </span>
            )
          }
          {
            reviewerLabelText && (
              <>
                <span aria-hidden="true">{" · "}</span>
                <span class="break-words">{reviewerLabelText}</span>
              </>
            )
          }
          {
            (publishedText || modifiedText) && (
              <>
                <span aria-hidden="true">{" · "}</span>
                {publishedText && (
                  <span class="text-text-light">
                    Published{" "}
                    <time datetime={datePublished} class="font-medium tabular-nums text-text-dark">
                      {publishedText}
                    </time>
                  </span>
                )}
                {publishedText && modifiedText && <span aria-hidden="true">{" · "}</span>}
                {modifiedText && (
                  <span class="text-text-light">
                    Updated{" "}
                    <time datetime={dateModified} class="font-medium tabular-nums text-text-dark">
                      {modifiedText}
                    </time>
                  </span>
                )}
              </>
            )
          }
        </p>
      </address>
    )
  }
</div>

<style>
  .ab-rule {
    display: block;
    width: 2rem;
    height: 1px;
    flex-shrink: 0;
    background-color: var(--color-primary);
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ab-hoverzone:hover .ab-rule,
  .ab-hoverzone:focus-within .ab-rule {
    width: 3.25rem;
  }
  .ab-ring {
    transition: border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ab-hoverzone:hover .ab-ring,
  .ab-hoverzone:focus-within .ab-ring {
    border-color: var(--color-primary);
  }
  @media (prefers-reduced-motion: reduce) {
    .ab-rule,
    .ab-ring {
      transition: none;
    }
  }
</style>
