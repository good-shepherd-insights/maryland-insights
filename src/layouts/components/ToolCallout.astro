---
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Item = {
  name: string;
  purpose?: string;
  link?: string;
  icon?: string;
};

type Props = {
  bg?: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  items?: Item[];
  /** "aligned-with" frames the list as surfaces the work is aligned with, never endorsements. */
  tone?: "neutral" | "aligned-with";
  footerNote?: string;
  anchor?: string;
  headingLevel?: "h2" | "h3";
  ui?: { alignedWithLabel?: string; namedOnPageLabel?: string };
};

const {
  eyebrow,
  title,
  intro,
  items = [],
  tone = "neutral",
  footerNote,
  anchor,
  headingLevel = "h2",
  ui,
  bg = "gold",
} = Astro.props as Props;

const headingId = `tool-${slugify(title)}`;
const label = eyebrow ?? (tone === "aligned-with" ? ui?.alignedWithLabel : ui?.namedOnPageLabel);
const shownItems = items;
const Heading = headingLevel;
// Contents lists link to the title without its leading "The".
const linkId = headingId.replace(/^tool-the-/, "tool-");
---

{!anchor && headingId !== linkId && <span id={linkId} class="sp-anchor"></span>}
<section id={anchor} class:list={["sp-sec", `hp-${bg}`]} aria-labelledby={headingId}>
  <div class="hp-in sp-stack">
    <div class="sp-head sp-head-end">
      <div class="sp-title">
        {label && <p class="sp-eyebrow">{label}</p>}
        <Heading id={headingId} class="sp-h2">{title}</Heading>
      </div>
      {intro && <p set:html={markdownify(intro)} />}
    </div>
    {shownItems.length > 0 && (
      <ul class="sp-tools">
        {shownItems.map((item) => (
          <li>
            <div class="sp-tool-n">{item.icon && <img src={item.icon} alt="" aria-hidden="true" loading="lazy" width="36" height="36" />}{item.link ? <a href={item.link} target="_blank" rel="noopener noreferrer nofollow">{item.name}</a> : <span>{item.name}</span>}</div>
            {item.purpose && <p set:html={markdownify(item.purpose)} />}
          </li>
        ))}
      </ul>
    )}
    {footerNote && <p class="sp-small" set:html={markdownify(footerNote)} />}
  </div>
</section>
