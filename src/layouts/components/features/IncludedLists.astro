---
// 11 What each engagement includes, and what it doesn't (canvas: v-aut-11-faq-b).
import Cta from "./Cta.astro";
const { heading, lead, includedTitle, includedItems = [], excludedTitle, excludedItems = [], cta } = Astro.props;
---
<section class="mi m-sec m-incl" style="padding: 96px 24px">
  <div class="wrap">
    <div class="m-contents" style="display: flex; flex-wrap: wrap; gap: 24px 48px; justify-content: space-between; align-items: flex-end">
      <div class="m-contents" style="display: flex; flex-direction: column; gap: 16px">
        <h2 class="h2">{heading}</h2>
        <p class="lead muted">{lead}</p>
      </div>
      <Cta cta={cta} class="m-last" />
    </div>
    <div class="m-incl__row" style="margin-top: 48px; display: flex; flex-wrap: wrap">
      <div class="m-incl__in" style="flex: 1.15 1 420px; background: #FFB612; padding: 36px 40px 40px"><p class="h4" style="font-weight: 700; padding-bottom: 14px">{includedTitle}</p><ul>{includedItems.map((t: string) => <li style="display: flex; align-items: center; gap: 14px; padding: 13px 0; border-top: 1px solid #121212"><span aria-hidden="true" style="flex: none; width: 16px; height: 16px; background: #121212"></span><span class="stat m-incl__item" style="font-size: 21px">{t}</span></li>)}</ul></div>
      <div class="on-dark m-incl__out" style="flex: 1 1 380px; background: #121212; padding: 36px 40px 40px"><p class="h4" style="font-weight: 700; padding-bottom: 14px">{excludedTitle}</p><ul>{excludedItems.map((t: string) => <li style="display: flex; align-items: center; gap: 14px; padding: 13px 0; border-top: 1px solid rgba(245,245,245,0.25)"><span aria-hidden="true" style="flex: none; width: 16px; height: 16px; border: 2px solid rgba(245,245,245,0.6)"></span><span class="body" style="color: rgba(245,245,245,0.78)">{t}</span></li>)}</ul></div>
    </div>
  </div>
</section>
