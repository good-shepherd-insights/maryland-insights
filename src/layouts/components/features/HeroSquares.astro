---
// 01 Hero: headline beside a 100-square grid (canvas: cel-01-hero-a).
import Cta from "./Cta.astro";
const { eyebrow, heading, lead, cta, secondaryCta, filled = 0, figureValue, figureLabel, source, chartDescription } = Astro.props;
const cells = Array.from({ length: 100 }, (_, i) => i < filled);
---
<section class="mi m-herosq" style="padding: 96px 24px 104px; background: #FDFBF7">
  <div class="wrap m-herosq__wrap" style="display: flex; flex-wrap: wrap; gap: 56px 80px; align-items: center">
    <div style="flex: 1.1 1 460px; display: flex; flex-direction: column; gap: 28px">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="d1 m-herosq__h">{heading}</h1>
      <p class="lead muted">{lead}</p>
      <div class="stack-sm" style="display: flex; flex-wrap: wrap; gap: 12px"><Cta cta={cta} /><Cta cta={secondaryCta} variant="btn-ghost" /></div>
    </div>
    <figure role="img" aria-label={chartDescription} style="flex: 1 1 420px; margin: 0; display: flex; flex-direction: column; gap: 20px">
      <div aria-hidden="true" class="m-herosq__grid" style="display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 6px">
        {cells.map((on) => <span style={`display: block; aspect-ratio: 1; background: ${on ? "#FFB612" : "#E7DFD0"}`}></span>)}
      </div>
      <figcaption style="display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: baseline"><span class="stat m-herosq__v" style="font-size: 64px; line-height: 1">{figureValue}</span><span class="body">{figureLabel}</span></figcaption>
      <p class="tiny muted">{source}</p>
    </figure>
  </div>
</section>
