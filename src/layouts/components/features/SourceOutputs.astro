---
// 06 One content layer feeding a list of outputs (canvas: wv-06-content-ai-a).
const { heading, sourceTitle, sourceDetail, outputs = [], chartDescription } = Astro.props;
---
<section class="mi m-srcout" style="padding: 96px 24px">
  <div class="wrap">
    <h2 class="h2" style="max-width: 820px">{heading}</h2>
    <div role="img" aria-label={chartDescription} class="mi-d" style="margin-top: 56px; display: flex; flex-wrap: wrap; align-items: stretch">
      <div style="flex: 1 1 340px; background: #FFB612; border: 2px solid #121212; padding: 36px; display: flex; flex-direction: column; justify-content: space-between; min-height: 360px">
        <p class="stat" style="font-size: 56px; line-height: 0.95">{sourceTitle}</p>
        <p class="body">{sourceDetail}</p>
      </div>
      <span aria-hidden="true" style="flex: 0 0 40px; align-self: center; height: 2px; background: #121212"></span>
      <ul style="flex: 1.4 1 480px; display: flex; flex-direction: column; justify-content: space-between; gap: 10px; border-left: 2px solid #121212">
        {outputs.map((o: string) => (
          <li style="display: flex; align-items: center"><span aria-hidden="true" style="flex: 0 0 40px; height: 2px; background: #121212"></span><span class="h4" style="flex: 1; border: 2px solid #121212; padding: 18px 22px; background: #FDFBF7">{o}</span></li>
        ))}
      </ul>
    </div>
    <div role="img" aria-label={chartDescription} class="mi-m m-fan" style="margin-top: 28px">
      <div class="m-fan__source" style="background: #FFB612; color: #121212; border: 2px solid #121212">
        <p class="stat m-fan__title" style="color: #121212">{sourceTitle}</p>
        <p class="body m-fan__detail" style="color: #121212">{sourceDetail}</p>
      </div>
      <ul class="m-fan__list">
        <span aria-hidden="true" class="m-fan__rail"></span>
        {outputs.map((o: string) => (
          <li><span aria-hidden="true" class="m-fan__tick"></span><span class="h4 m-fan__box">{o}</span></li>
        ))}
      </ul>
    </div>
  </div>
</section>
