---
// Steps rising left to right, the last one dark (canvas: v-rep-02-intro-c).
import Cta from "./Cta.astro";
const { heading, body, steps = [], chartDescription, cta } = Astro.props;
// Heights from the board for four steps; other counts rise evenly to 100%.
const BOARD = [34, 54, 76, 100];
const height = (i: number) =>
  steps.length === 4 ? BOARD[i] : Math.round(34 + (66 * i) / Math.max(steps.length - 1, 1));
---
<section class="mi" style="background: #FFB612; padding: clamp(64px, 7vw, 104px) 24px">
  <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 48px 72px; align-items: flex-end">
    <div style="flex: 1 1 360px; display: flex; flex-direction: column; gap: 24px">
      <h2 class="stat" style="font-size: clamp(48px, 5.6vw, 80px); line-height: 0.92; letter-spacing: -0.045em">{heading}</h2>
      <p class="body" style="max-width: 440px">{body}</p>
      <div><Cta cta={cta} variant="btn-ink" /></div>
    </div>
    <div role="img" aria-label={chartDescription} class="mi-steps" style="flex: 1.4 1 560px; min-width: 0; display: flex; gap: 10px; align-items: flex-end; height: 440px">
      {steps.map((step: { title: string; detail: string }, i: number) => {
        const last = i === steps.length - 1;
        return (
          <div style="flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; justify-content: flex-end; height: 100%">
            <div style={`height: ${height(i)}%; background: ${last ? "#121212" : "#FDFBF7"}; color: ${last ? "#FFB612" : "#121212"}; border: 2px solid #121212; padding: 18px; display: flex; flex-direction: column; justify-content: space-between; gap: 8px`}>
              <p class="stat" style="font-size: clamp(18px, 2.3vw, 34px); line-height: 0.95">{step.title}</p>
              <p class="small" style="font-weight: 600">{step.detail}</p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
