---
// Questions, heading left and questions right (canvas: local-seo-11, the live-site original).
// Native <details> so it works without JavaScript; the first question starts open, as on the board.
import { markdownify } from "@/lib/utils/textConverter";
const { heading, items = [] } = Astro.props;
---
<section class="mi mi-faq" id="faq" style="padding: 96px 32px">
  <div class="mi-faq__grid" style="max-width: 1240px; margin: 0 auto">
    <h2 class="mi-faq__title">{heading}</h2>
    <div>
      {items.map((faq: { question: string; answer: string }, i: number) => (
        <details class="mi-faq__item" open={i === 0}>
          <summary>
            <h3 class="mi-faq__q">{faq.question}</h3>
            <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6l4 4 4-4"></path></svg>
          </summary>
          <div class="mi-faq__a"><p set:html={markdownify(faq.answer)} /></div>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .mi-faq__grid { display: grid; gap: 40px; }
  @media (min-width: 1024px) { .mi-faq__grid { grid-template-columns: 1fr 1.6fr; gap: 64px; } }
  .mi-faq .mi-faq__title { font-size: 2rem; line-height: 1.05; letter-spacing: -0.03em; }
  @media (min-width: 768px) { .mi-faq .mi-faq__title { font-size: 3rem; line-height: 1.04; letter-spacing: -0.035em; } }
  .mi-faq__item { border-bottom: 1px solid #e7dfd0; }
  .mi-faq__item:last-child { border-bottom: 0; }
  .mi-faq__item summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 0; cursor: pointer; list-style: none; }
  .mi-faq__item summary::-webkit-details-marker { display: none; }
  .mi-faq .mi-faq__q { font-family: "MI Hanken", Arial, sans-serif; font-size: 18px; font-weight: 500; line-height: 1.5; letter-spacing: normal; text-wrap: wrap; }
  .mi-faq__item svg { width: 16px; height: 16px; flex-shrink: 0; transition: transform 0.2s; }
  .mi-faq__item[open] svg { transform: rotate(180deg); }
  .mi-faq__a { padding: 0 32px 16px 0; }
  .mi-faq__a p { font-size: 18px; line-height: 1.8281rem; color: #5b554b; }
  @media (max-width: 767px) { .mi-faq { padding: 40px 20px !important; } .mi-faq__a p { line-height: 1.6875rem; } }
</style>
