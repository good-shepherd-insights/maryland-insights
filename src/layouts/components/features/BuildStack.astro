---
// 04 A stack of versioned builds (canvas: wv-04-edits-b).
import Cta from "./Cta.astro";
const { heading, body, liveName, liveLabel, previousName, previousLabel, olderName, note, chartDescription, cta } = Astro.props;
---
<section class="mi m-builds" style="padding: 96px 24px; background: #F6F0E5">
  <div class="wrap m-builds__wrap" style="display: flex; flex-wrap: wrap; gap: 56px 80px; align-items: center">
    <div class="m-contents" style="flex: 1 1 380px; display: flex; flex-direction: column; gap: 24px">
      <h2 class="h2 m-o1">{heading}</h2>
      <p class="body muted m-o2">{body}</p>
      <div class="m-o5"><Cta cta={cta} /></div>
    </div>
    <div role="img" aria-label={chartDescription} class="mi-d" style="flex: 1.3 1 520px; position: relative; height: 480px">
      <div style="position: absolute; left: 96px; right: 0; top: 0; height: 120px; border: 2px solid #121212; background: #FDFBF7; padding: 20px 28px; display: flex; justify-content: space-between; align-items: flex-end"><span class="stat" style="font-size: 36px; color: #8A8173">{olderName}</span></div>
      <div style="position: absolute; left: 48px; right: 48px; top: 110px; height: 140px; border: 2px solid #121212; background: #FDFBF7; padding: 20px 28px; display: flex; justify-content: space-between; align-items: flex-end"><span class="stat" style="font-size: 44px">{previousName}</span><span class="small" style="font-weight: 600">{previousLabel}</span></div>
      <div style="position: absolute; left: 0; right: 96px; top: 240px; height: 200px; border: 2px solid #121212; background: #FFB612; padding: 28px; display: flex; justify-content: space-between; align-items: flex-end"><span class="stat" style="font-size: 72px">{liveName}</span><span class="small" style="font-weight: 600">{liveLabel}</span></div>
      <p class="tiny muted" style="position: absolute; left: 0; bottom: 0">{note}</p>
    </div>
    <div role="img" aria-label={chartDescription} class="mi-m m-o3 m-builds__m" style="display: flex; flex-direction: column; gap: 8px">
      <div style="border: 2px solid #121212; background: #FFB612; padding: 22px 20px; display: flex; justify-content: space-between; align-items: flex-end"><span class="stat" style="font-size: 48px; line-height: 1">{liveName}</span><span class="small" style="font-weight: 600">{liveLabel}</span></div>
      <div style="margin: 0 12px; border: 2px solid #121212; background: #FDFBF7; padding: 18px; display: flex; justify-content: space-between; align-items: flex-end; gap: 12px"><span class="stat" style="font-size: 34px; line-height: 1">{previousName}</span><span class="small" style="font-weight: 600; text-align: right">{previousLabel}</span></div>
      <div style="margin: 0 24px; border: 2px solid #121212; background: #FDFBF7; padding: 14px 16px"><span class="stat" style="font-size: 26px; line-height: 1; color: #8A8173">{olderName}</span></div>
      <p class="tiny muted" style="margin-top: 4px">{note}</p>
    </div>
  </div>
</section>
