---
// Stages in a row, a band underneath for what carries through (canvas: v-rep-04-origin-a).
import Cta from "./Cta.astro";
const { heading, stages = [], bandTitle, bandDetail, note, chartDescription, cta } = Astro.props;
---
<section class="mi" style="padding: clamp(64px, 7vw, 104px) 24px">
  <div class="wrap">
    <h2 class="h2" style="max-width: 780px">{heading}</h2>
    <div role="img" aria-label={chartDescription} style="margin-top: 56px; border: 2px solid #121212; border-left: 0">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr))">
        {stages.map((s: { title: string; detail: string }, i: number) => {
          const last = i === stages.length - 1;
          return (
            <div style={`padding: 28px 24px 32px; border-left: 2px solid #121212;${last ? " background: #121212; color: #FFB612;" : ""} display: flex; flex-direction: column; justify-content: space-between; gap: 32px; min-height: 240px`}>
              <p class="stat" style="font-size: clamp(32px, 3.4vw, 48px); line-height: 0.92">{s.title}</p>
              <p class="small" style="font-weight: 600">{s.detail}</p>
            </div>
          );
        })}
      </div>
      <div style="background: #FFB612; border-left: 2px solid #121212; border-top: 2px solid #121212; padding: 18px 24px; display: flex; flex-wrap: wrap; gap: 8px 32px; align-items: baseline">
        <p class="stat" style="font-size: clamp(24px, 2.6vw, 36px)">{bandTitle}</p>
        <p class="small" style="font-weight: 600">{bandDetail}</p>
      </div>
    </div>
    <div style="margin-top: 40px; display: flex; flex-wrap: wrap; gap: 20px 40px; align-items: center; justify-content: space-between">
      <p class="body muted">{note}</p>
      <Cta cta={cta} />
    </div>
  </div>
</section>
