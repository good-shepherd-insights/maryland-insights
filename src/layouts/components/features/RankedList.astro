---
// Intro beside a ranked list with values, first row highlighted (canvas: rev-04-volume-c).
import Cta from "./Cta.astro";
const { heading, body, cta, listTitle, items = [], source } = Astro.props;
---
<section class="mi m-sec m-ranked" style="padding: 96px 24px; background: #FDFBF7">
  <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 48px 80px; align-items: flex-start">
    <div class="m-contents" style="flex: 1 1 340px; display: flex; flex-direction: column; gap: 24px">
      <h2 class="h2">{heading}</h2>
      <p class="body muted">{body}</p>
      <div class="m-last"><Cta cta={cta} /></div>
    </div>
    <div style="flex: 1.4 1 560px">
      <p class="small" style="font-weight: 600; margin-bottom: 12px">{listTitle}</p>
      <ol>
        {items.map((it: { value: string; label: string }, i: number) => (
          <li class="m-ranked__row" style={`display: grid; grid-template-columns: 48px 1fr 72px; gap: 16px; align-items: center; padding: 18px 12px; border-top: 2px solid #121212;${i === 0 ? " background: #FFB612;" : ""}`}>
            <p class="stat m-ranked__n" style="font-size: 28px">{i + 1}</p><p class="h4">{it.label}</p><p class="stat m-ranked__v" style="font-size: 32px; text-align: right">{it.value}</p>
          </li>
        ))}
      </ol>
      <p class="tiny muted" style="margin-top: 16px">{source}</p>
    </div>
  </div>
</section>
