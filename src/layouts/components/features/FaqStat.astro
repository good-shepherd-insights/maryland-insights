---
// Questions beside a dark stat panel (canvas: rev-11-faq-b).
import Cta from "./Cta.astro";
const { heading, panelQuestion, panelValue, panelBody, panelSource, items = [], cta } = Astro.props;
---
<section class="mi m-sec m-faqstat" style="padding: 96px 24px; background: #F6F0E5">
  <div class="wrap">
    <h2 class="h2">{heading}</h2>
    <div class="m-faqstat__grid" style="margin-top: 48px; display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 0; border-top: 2px solid #121212">
      <div class="m-faqstat__panel" style="background: #121212; color: #F5F5F5; padding: 40px 36px; display: flex; flex-direction: column; gap: 20px">
        <h3 class="h3">{panelQuestion}</h3>
        <p class="stat m-faqstat__v" style="font-size: 96px; line-height: 0.85; color: #FFB612">{panelValue}</p>
        <p class="body">{panelBody}</p>
        <p class="tiny" style="color: rgba(245,245,245,0.7)">{panelSource}</p>
      </div>
      <div>
        {items.map((q: { question: string; answer: string }) => (
          <details class="m-faqstat__q" style="border-bottom: 2px solid #121212">
            <summary style="padding: 22px 28px; display: flex; justify-content: space-between; gap: 16px; align-items: center; cursor: pointer; list-style: none; min-height: 44px"><span class="h4">{q.question}</span><span aria-hidden="true" class="stat m-faqstat__plus" style="font-size: 28px">+</span></summary>
            <p class="body muted" style="padding: 0 28px 22px">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
    <div style="margin-top: 40px"><Cta cta={cta} /></div>
  </div>
</section>
