import ClosingStars from "./ClosingStars.astro";
import HeroSquares from "./HeroSquares.astro";
import DarkTiles from "./DarkTiles.astro";
import BarsWide from "./BarsWide.astro";
import Multipliers from "./Multipliers.astro";
import MinuteBar from "./MinuteBar.astro";
import BigStatSplit from "./BigStatSplit.astro";
import LeadTable from "./LeadTable.astro";
import Funnel from "./Funnel.astro";
import FaqStats from "./FaqStats.astro";
import ClosingLead from "./ClosingLead.astro";

const COMPONENTS: Record<string, any> = {
  featureHeroMap: HeroMap,
  featureMonthlyGrid: MonthlyGrid,
  featureHoursStat: HoursStat,
  featureEveryJob: EveryJob,
  featureCountyPages: CountyPages,
  featureCityPlaces: CityPlaces,
  featureStatBars: StatBars,
  featureFanout: Fanout,
  featureChecklistMap: ChecklistMap,
  featureTwoLists: TwoLists,
  featureBarChart: BarChart,
  featureCountyCount: CountyCount,
  featureFaq: Faq,
  featureClosingMap: ClosingMap,
  featureHeroWide: HeroWide,
  featureRisingSteps: RisingSteps,
  featureCarries: Carries,
  featureStages: Stages,
  featureCountyLeads: CountyLeads,
  featureLeadJourney: LeadJourney,
  featureInputsReport: InputsReport,
  featureTrendList: TrendList,
  featureRelationship: Relationship,
  featureGridStats: GridStats,
  featureCountyMapStat: CountyMapStat,
  featureOneQuestion: OneQuestion,
  featureClosingPhoto: ClosingPhoto,
  featureHeroInkBlock: HeroInkBlock,
  featureNumberGrid: NumberGrid,
  featureSquares: Squares,
  featureBuildStack: BuildStack,
  featureWaffleStat: WaffleStat,
  featureWatchList: WatchList,
  featureStatCode: StatCode,
  featureSourceOutputs: SourceOutputs,
  featureTimeline: Timeline,
  featureRoster: Roster,
  featureFitLists: FitLists,
  featureCountyMapLight: CountyMapLight,
  featureShortAnswers: ShortAnswers,
  featureClosingBlock: ClosingBlock,
  featureHeroSplit: HeroSplit,
  featureEventResponses: EventResponses,
  featureWeekStat: WeekStat,
  featureMinuteTimeline: MinuteTimeline,
  featureRoutingMap: RoutingMap,
  featureRoutingFigures: RoutingFigures,
  featureConsentHub: ConsentHub,
  featureRegistration: Registration,
  featureNested: Nested,
  featureAutoHuman: AutoHuman,
  featureWatchBig: WatchBig,
  featureIncludedLists: IncludedLists,
  featureClosingBand: ClosingBand,
  featureHeroStatPanel: HeroStatPanel,
  featureTileGrid: TileGrid,
  featureBarList: BarList,
  featureMonthRows: MonthRows,
  featureRankedList: RankedList,
  featureStatCells: StatCells,
  featureStatWaffle: StatWaffle,
  featureTwoListsCompact: TwoListsCompact,
  featureYearBars: YearBars,
  featureColumnPair: ColumnPair,
  featureFaqStat: FaqStat,
  featureClosingStars: ClosingStars,
  featureHeroSquares: HeroSquares,
  featureDarkTiles: DarkTiles,
  featureBarsWide: BarsWide,
  featureMultipliers: Multipliers,
  featureMinuteBar: MinuteBar,
  featureBigStatSplit: BigStatSplit,
  featureLeadTable: LeadTable,
  featureFunnel: Funnel,
  featureFaqStats: FaqStats,
  featureClosingLead: ClosingLead,
};

const { sections = [] } = Astro.props;
---
<div class="mi-page">
  {sections.map((section: { _type: string; _key: string }) => {
    const Component = COMPONENTS[section._type];
    return Component ? <Component {...section} /> : null;
  })}
</div>
