---
// 07 Also included: registration in 24 to 72 hours (canvas: v-aut-07-included-a).
import Cta from "./Cta.astro";
const { heading, lead, statValue, statDetail, scaleLabels = [], items = [], chartDescription, cta } = Astro.props;
const ticks = Array.from({ length: 13 }, (_, i) => i);
const at = [0, 33.333, 66.667, 100];
---
<section class="mi m-sec m-reg" style="padding: 96px 24px">
  <div class="wrap">
    <div class="m-contents" style="display: flex; flex-wrap: wrap; gap: 24px 48px; justify-content: space-between; align-items: flex-end">
      <div class="m-contents" style="max-width: 760px; display: flex; flex-direction: column; gap: 16px">
        <h2 class="h2">{heading}</h2>
        <p class="lead muted">{lead}</p>
      </div>
      <Cta cta={cta} class="m-last" />
    </div>
    <div role="img" aria-label={chartDescription} class="m-reg__chart" style="margin-top: 64px">
      <div style="display: flex; min-height: 150px">
        <div style="flex: 0 0 33.333%; border-bottom: 2px solid #121212"></div>
        <div class="m-reg__bar" style="flex: 1; background: #FFB612; border: 2px solid #121212; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; gap: 12px">
          <p class="stat m-reg__value" style="font-size: clamp(36px, 5vw, 72px); line-height: 0.9">{statValue}</p>
          <p class="small m-reg__detail">{statDetail}</p>
        </div>
      </div>
      <div style="position: relative; height: 44px">
        {ticks.map((i) => <span aria-hidden="true" style={`position: absolute; left: ${(i * 8.3333).toFixed(3)}%; top: -8px; width: 2px; height: 16px; ${i === 0 ? "" : "margin-left: -1px; "}background: #121212`}></span>)}
        {scaleLabels.map((l: string, i: number) => <span class="small muted m-reg__lbl" style={`position: absolute; white-space: nowrap; left: ${at[i]}%; top: 16px; ${i === 0 ? "" : i === scaleLabels.length - 1 ? "transform: translateX(-100%)" : "transform: translateX(-50%)"}`}>{l}</span>)}
      </div>
    </div>
    <ul class="m-reg__list" style="margin-top: 40px; display: flex; flex-wrap: wrap; gap: 24px">
      {items.map((it: { title: string; detail: string }) => <li style="flex: 1 1 260px; padding: 20px 24px 0 0; border-top: 2px solid #121212"><p class="stat m-reg__title" style="font-size: 22px">{it.title}</p><p class="small muted" style="margin-top: 6px">{it.detail}</p></li>)}
    </ul>
  </div>
</section>
