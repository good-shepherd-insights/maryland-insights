---
// Five solid stars (decorative row used by the review sections).
interface Props { size: number; gap: number; color: string; label?: string; class?: string }
const { size, gap, color, label, class: cls } = Astro.props;
const five = [0, 1, 2, 3, 4];
---
<div role="img" aria-label={label} class={cls} style={`display: flex; gap: ${gap}px`}>
  {five.map(() => (
    <svg aria-hidden="true" viewBox="0 0 24 24" style={`width: ${size}px; height: ${size}px; display: block`}><path d="M12 1.8l3.1 6.6 7.2.9-5.3 5 1.4 7.1L12 17.9l-6.4 3.5 1.4-7.1-5.3-5 7.2-.9z" fill={color} stroke={color} stroke-width="1.4"></path></svg>
  ))}
</div>
