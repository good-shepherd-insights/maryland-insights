---
// 11 Questions with one-line answers (canvas: wv-11-faq-a).
import Cta from "./Cta.astro";
const { heading, items = [], cta } = Astro.props;
---
<section class="mi m-short" style="padding: 96px 24px">
  <div class="wrap">
    <h2 class="h2">{heading}</h2>
    <dl style="margin: 48px 0 0">
      {items.map((q: { question: string; answer: string }) => (
        <div class="m-short__row" style="display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px; align-items: baseline; padding: 28px 0; border-top: 2px solid #121212"><dt class="h3 m-short__q" style="font-weight: 600">{q.question}</dt><dd class="stat m-short__a" style="margin: 0; font-size: clamp(56px, 6vw, 88px); line-height: 0.95; color: #121212">{q.answer}</dd></div>
      ))}
    </dl>
    <div class="m-short__foot" style="border-top: 2px solid #121212; padding-top: 32px; display: flex; flex-wrap: wrap; gap: 20px 40px; justify-content: flex-end; align-items: center">
      <Cta cta={cta} />
    </div>
  </div>
</section>
