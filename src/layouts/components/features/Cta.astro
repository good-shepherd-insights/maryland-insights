---
// "Partner with us" style button used by every feature section.
interface Props {
  cta?: { label?: string; link?: string } | null;
  variant?: "btn-y" | "btn-ink" | "btn-ghost";
  style?: string;
  class?: string;
}
const { cta, variant = "btn-y", style, class: extra } = Astro.props;
---
{cta?.label && cta?.link && <a class={`btn ${variant}${extra ? ` ${extra}` : ""}`} href={cta.link} style={style}>{cta.label}</a>}
