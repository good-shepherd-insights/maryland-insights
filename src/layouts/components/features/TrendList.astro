---
// Illustrative line over monthly bars, beside a short list (canvas: v-rep-07-included-a).
// The values are the board's illustrative shape, kept in code; labels come from Sanity.
import Cta from "./Cta.astro";
const { heading, chartTitle, lineLabel, barLabel, periodLabels = [], caption, listTitle, items = [], chartDescription, cta } = Astro.props;
const HANKEN = "MI Hanken, Arial, sans-serif";
const ARCHIVO = "MI Archivo, Arial, sans-serif";
const BARS = [140, 150, 130, 150, 220, 240];
const LINE = [171, 145, 158, 92, 39, 57];
const xs = [80, 244, 408, 572, 736, 900];
// Phone version (mobile board): same values at half scale in a 342-wide chart.
const mx = [28.5, 85.5, 142.5, 199.5, 256.5, 313.5];
const my = (v: number) => v / 2 + 30;
---
<section class="mi m-sec m-trend" style="padding: clamp(64px, 7vw, 104px) 24px">
  <div class="wrap">
    <h2 class="h2">{heading}</h2>
    <div class="m-trend__body" style="margin-top: 48px; display: flex; flex-wrap: wrap; gap: 40px 64px; align-items: flex-end">
      <div style="flex: 3 1 600px; min-width: 0">
        <p class="stat m-trend__title" style="font-size: 28px">{chartTitle}</p>
        <div class="m-trend__chart" style="margin-top: 24px">
          <svg role="img" aria-label={chartDescription} class="mi-d" viewBox="0 0 1000 460" style="display: block; width: 100%; height: auto">
            {xs.map((x, i) => <rect x={x - 28} y={400 - BARS[i]} width="56" height={BARS[i]} fill="#FFB612"></rect>)}
            <line x1="20" y1="400" x2="980" y2="400" stroke="#121212" stroke-width="3"></line>
            <path d={"M" + xs.map((x, i) => `${x} ${LINE[i]}`).join(" L")} fill="none" stroke="#121212" stroke-width="5"></path>
            {xs.map((x, i) => <rect x={x - 8} y={LINE[i] - 8} width="16" height="16" fill="#121212"></rect>)}
            <text x="68" y="145" font-family={ARCHIVO} font-weight="700" font-size="22" fill="#121212">{lineLabel}</text>
            <text x="52" y="246" font-family={ARCHIVO} font-weight="700" font-size="22" fill="#121212">{barLabel}</text>
            {periodLabels.slice(0, 6).map((label: string, i: number) => (
              <text x={xs[i]} y="440" text-anchor="middle" font-family={HANKEN} font-size="20" fill="#5B554B">{label}</text>
            ))}
          </svg>
          <svg role="img" aria-label={chartDescription} class="mi-m" viewBox="0 0 342 262" style="width: 100%; height: auto">
            {mx.map((x, i) => <rect x={x - 13} y={230 - BARS[i] / 2} width="26" height={BARS[i] / 2} fill="#FFB612"></rect>)}
            <line x1="0" y1="230" x2="342" y2="230" stroke="#121212" stroke-width="2"></line>
            <path d={"M" + mx.map((x, i) => `${x} ${my(LINE[i])}`).join(" L")} fill="none" stroke="#121212" stroke-width="3"></path>
            {mx.map((x, i) => <rect x={x - 5} y={my(LINE[i]) - 5} width="10" height="10" fill="#121212"></rect>)}
            <text x="14" y="84" font-family={ARCHIVO} font-weight="700" font-size="13" fill="#121212">{lineLabel}</text>
            <text x="14" y="152" font-family={ARCHIVO} font-weight="700" font-size="13" fill="#121212">{barLabel}</text>
            {periodLabels.slice(0, 6).map((label: string, i: number) => (
              <text x={mx[i]} y="252" text-anchor="middle" font-family={HANKEN} font-size="12" fill="#5B554B">{label}</text>
            ))}
          </svg>
        </div>
        <p class="tiny muted" style="margin-top: 8px">{caption}</p>
      </div>
      <div style="flex: 1 1 260px">
        <p class="small muted m-trend__listtitle" style="margin-bottom: 12px; font-weight: 600">{listTitle}</p>
        <ul class="m-trend__list" style="border-bottom: 2px solid #121212">{items.map((t: string) => <li class="h4" style="padding: 14px 0; border-top: 2px solid #121212">{t}</li>)}</ul>
        <div style="margin-top: 28px"><Cta cta={cta} /></div>
      </div>
    </div>
  </div>
</section>
