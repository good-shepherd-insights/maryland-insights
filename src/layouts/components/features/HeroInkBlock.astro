---
// 01 Hero: photo with the headline in an ink block (canvas: wv-01-hero-a).
import Cta from "./Cta.astro";
import { FEATURE_PHOTOS } from "./photos";
const { eyebrow, heading, lead, cta, secondaryCta, photo, imageAlt } = Astro.props;
---
<section class="mi m-ink" style="padding: 24px">
  <div class="m-ink__frame" style="position: relative; min-height: 772px; display: flex; align-items: flex-end">
    <img src={FEATURE_PHOTOS[photo]} alt={imageAlt} class="m-ink__photo" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block" />
    <div class="on-dark m-ink__block" style="position: relative; background: #121212; max-width: 760px; padding: 48px 48px 44px; display: flex; flex-direction: column; gap: 28px">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="d1 m-ink__h1">{heading}</h1>
      <p class="lead muted">{lead}</p>
      <div class="stack-sm" style="display: flex; flex-wrap: wrap; gap: 12px">
        <Cta cta={cta} variant="btn-y" />
        <Cta cta={secondaryCta} variant="btn-ghost" />
      </div>
    </div>
  </div>
</section>
