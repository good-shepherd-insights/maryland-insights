---
// Client, agency and engineers: who talks to whom (canvas: v-rep-08-agency-c).
import Cta from "./Cta.astro";
const { heading, body, clientLines = [], agencyLines = [], engineerLines = [], leftNote, rightNote, chartDescription, cta } = Astro.props;
const HANKEN = "MI Hanken, Arial, sans-serif";
const ARCHIVO = "MI Archivo, Arial, sans-serif";
---
<section class="mi m-sec m-rel" style="padding: clamp(64px, 7vw, 104px) 24px">
  <div class="wrap">
    <h2 class="h2" style="max-width: 760px">{heading}</h2>
    <p class="body muted" style="margin-top: 16px; max-width: 620px">{body}</p>
    <div class="mi-d" style="margin-top: 56px">
      <svg role="img" aria-label={chartDescription} viewBox="0 0 1200 360" style="display: block; width: 100%; height: auto">
        <line x1="300" y1="150" x2="500" y2="150" stroke="#121212" stroke-width="16"></line>
        <line x1="800" y1="150" x2="900" y2="150" stroke="#121212" stroke-width="4"></line>
        <rect x="0" y="60" width="300" height="180" fill="#FDFBF7" stroke="#121212" stroke-width="4"></rect>
        {clientLines.map((l: string, i: number) => <text x="28" y={140 + i * 48} font-family={ARCHIVO} font-weight="700" font-size="40" fill="#121212">{l}</text>)}
        <rect x="500" y="40" width="300" height="220" fill="#FFB612"></rect>
        {agencyLines.map((l: string, i: number) => <text x="528" y={140 + i * 52} font-family={ARCHIVO} font-weight="700" font-size="44" fill="#121212">{l}</text>)}
        <rect x="900" y="60" width="300" height="180" fill="#121212"></rect>
        {engineerLines.map((l: string, i: number) => <text x="928" y={140 + i * 44} font-family={ARCHIVO} font-weight="700" font-size="34" fill="#FDFBF7">{l}</text>)}
        <text x="300" y="310" font-family={HANKEN} font-size="22" font-weight="600" fill="#121212">{leftNote}</text>
        <text x="760" y="310" font-family={HANKEN} font-size="22" font-weight="600" fill="#121212">{rightNote}</text>
      </svg>
    </div>
    <div role="img" aria-label={chartDescription} class="mi-m m-relm">
      <div class="m-relm__box m-relm__client"><p class="stat">{clientLines.join(" ")}</p></div>
      <div class="m-relm__link"><span aria-hidden="true" class="m-relm__thick"></span><p>{leftNote}</p></div>
      <div class="m-relm__box m-relm__agency"><p class="stat">{agencyLines.join(" ")}</p></div>
      <div class="m-relm__link"><span aria-hidden="true" class="m-relm__thin"></span><p>{rightNote}</p></div>
      <div class="m-relm__box m-relm__eng"><p class="stat">{engineerLines.join(" ")}</p></div>
    </div>
    <div class="m-rel__foot" style="margin-top: 40px; border-top: 2px solid #121212; padding-top: 28px"><Cta cta={cta} /></div>
  </div>
</section>
