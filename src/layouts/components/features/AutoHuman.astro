---
// 09 What runs automatically, and what stays human (canvas: v-aut-09-why-c).
import Cta from "./Cta.astro";
const { heading, autoTitle, autoItems = [], humanTitle, humanStat, humanNote, cta } = Astro.props;
---
<section class="mi m-sec m-autohuman" style="padding: 96px 24px">
  <div class="wrap">
    <div class="m-contents" style="display: flex; flex-wrap: wrap; gap: 24px 48px; justify-content: space-between; align-items: flex-end">
      <h2 class="h2" style="max-width: 800px">{heading}</h2>
      <Cta cta={cta} class="m-last" />
    </div>
    <div class="m-autohuman__row" style="margin-top: 48px; display: flex; flex-wrap: wrap">
      <div class="m-autohuman__auto" style="flex: 1.3 1 440px; background: #FFB612; padding: 40px">
        <p class="h4" style="font-weight: 700">{autoTitle}</p>
        <ul style="margin-top: 20px">{autoItems.map((t: string) => <li class="stat m-autohuman__item" style="font-size: clamp(22px, 2.6vw, 34px); padding: 14px 0; border-top: 2px solid #121212">{t}</li>)}</ul>
      </div>
      <div class="on-dark m-autohuman__human" style="flex: 1 1 360px; background: #121212; padding: 40px; display: flex; flex-direction: column; justify-content: space-between; gap: 32px">
        <p class="h4" style="font-weight: 700">{humanTitle}</p>
        <p class="stat m-autohuman__stat" style="font-size: clamp(40px, 5vw, 72px); line-height: 0.95">{humanStat}</p>
        <p class="small muted">{humanNote}</p>
      </div>
    </div>
  </div>
</section>
