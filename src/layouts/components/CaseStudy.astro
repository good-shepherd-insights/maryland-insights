---
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Outcome = {
  metric: string;
  value: string;
  source?: string;
};

type Props = {
  bg?: string;
  eyebrow?: string;
  title: string;
  /** Real client name, or an industry descriptor when the engagement is anonymized. */
  client?: string;
  /** Maryland county or market served. */
  location?: string;
  /** Engagement period, e.g. "Feb-May 2026". */
  dateRange?: string;
  situation?: string;
  whatWeFound?: string;
  whatChanged?: string;
  outcomes?: Outcome[];
  permissionLine?: string;
  variant?: "compact" | "expanded";
  ui?: {
    clientLabel?: string;
    locationLabel?: string;
    periodLabel?: string;
    situationLabel?: string;
    findingsLabel?: string;
    actionsLabel?: string;
    outcomeLabel?: string;
    publishingNoteLabel?: string;
  };
};

const {
  eyebrow,
  title,
  client,
  location,
  dateRange,
  situation,
  whatWeFound,
  whatChanged,
  outcomes = [],
  permissionLine,
  variant = "expanded",
  ui,
  bg = "cream",
} = Astro.props as Props;

const headingId = `service-${slugify(title)}`;

const meta = [
  { label: ui?.clientLabel, value: client },
  { label: ui?.locationLabel, value: location },
  { label: ui?.periodLabel, value: dateRange },
].filter((entry) => Boolean(entry.value));

const narrative: { label: string | undefined; body?: string }[] = [
  { label: ui?.situationLabel, body: situation },
  { label: ui?.findingsLabel, body: whatWeFound },
  { label: ui?.actionsLabel, body: whatChanged },
].filter((entry) => Boolean(entry.body));
---

<section aria-labelledby={headingId}>
  <div class:list={["sp-sec", `hp-${bg}`]}>
    <div class="hp-in sp-stack">
      <div class="sp-title">
        {eyebrow && <p class="sp-eyebrow">{eyebrow}</p>}
        <h2 id={headingId} class="sp-h2 sp-h2-lg" set:html={markdownify(title)} />
        {meta.length > 0 && <dl class="sp-meta">{meta.map((entry) => <div><dt>{entry.label}</dt><dd>{entry.value}</dd></div>)}</dl>}
      </div>
      {narrative.length > 0 && <dl class="sp-cols" style="--n:3">{narrative.map((entry) => <div class="sp-rule sp-rule-3"><dt class="sp-label">{entry.label}</dt><dd set:html={markdownify(entry.body)} /></div>)}</dl>}
      {outcomes.length === 0 && permissionLine && <p class="sp-small" set:html={`<strong>${ui?.publishingNoteLabel ?? ""}</strong> ${markdownify(permissionLine)}`} />}
    </div>
  </div>
  {outcomes.length > 0 && (
    <div class="sp-sec sp-sec-s hp-ink">
      <div class="hp-in sp-outcome">
        <ul>
          {outcomes.map((outcome) => (
            <li><div><p class="sp-mut">{ui?.outcomeLabel}</p><p class="sp-outcome-v">{outcome.value}</p></div><div><p class="sp-label">{outcome.metric}</p>{outcome.source && <p class="sp-mut">{outcome.source}</p>}</div></li>
          ))}
        </ul>
        {permissionLine && <div class="sp-note"><p class="sp-strong">{ui?.publishingNoteLabel}</p><p class="sp-mut" set:html={markdownify(permissionLine)} /></div>}
      </div>
    </div>
  )}
</section>
