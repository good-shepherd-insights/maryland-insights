---
import ImageMod from "@/components/ImageMod.astro";
import { markdownify, slugify } from "@/lib/utils/textConverter";

type RelatedArticle = {
  title: string;
  url: string;
  image?: string;
  excerpt?: string;
  date?: string | Date;
};

type Props = {
  bg?: string;
  title?: string;
  articles?: RelatedArticle[];
  layout?: "grid" | "list" | "inline";
  maxItems?: number;
  locale?: string;
};

const {
  title,
  articles = [],
  maxItems = 4,
  locale,
  bg = "gold",
} = Astro.props as Props;

const headingId = `related-${slugify(title)}`;

const shown = articles
  .filter((article) => article && typeof article.title === "string" && article.title.trim() !== "" && typeof article.url === "string" && article.url.trim() !== "")
  .slice(0, Math.max(1, Math.floor(maxItems)));

const count = shown.length;

// Dates may arrive as ISO strings or Date objects (YAML frontmatter) via props.
const articleDate = (value?: string | Date): { iso: string; label: string } | undefined => {
  if (!value) return undefined;
  const date = value instanceof Date ? value : new Date(value);
  if (Number.isNaN(date.getTime())) return undefined;
  return {
    iso: date.toISOString().slice(0, 10),
    label: new Intl.DateTimeFormat(locale?.replace("_", "-"), {
      month: "short",
      day: "numeric",
      year: "numeric",
      timeZone: "UTC",
    }).format(date),
  };
};

---

{
  count > 0 && (
    <section class:list={["sp-sec", `hp-${bg}`]} aria-labelledby={headingId}>
      <div class="hp-in sp-stack">
        <h2 id={headingId} class="sp-h2 sp-h2-lg">{title}</h2>
        <ul class="sp-arts" style={`--n:${Math.min(3, count)}`}>
          {shown.map((article) => {
            const date = articleDate(article.date);
            return (
              <li>
                <a href={article.url}>
                  {article.image && <ImageMod src={article.image} alt={article.title} width={696} height={528} loading="lazy" />}
                  {date && <time datetime={date.iso}>{date.label}</time>}
                  <span class="sp-h3">{article.title}</span>
                  {article.excerpt && <span class="sp-art-x" set:html={markdownify(article.excerpt)} />}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}
