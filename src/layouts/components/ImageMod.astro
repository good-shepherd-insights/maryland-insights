---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { parseImage, sanityUrl } from "@/lib/images.mjs";

// Props interface for the component
interface Props {
  /** A Sanity image, a cdn.sanity.io address, or a path under /public/images. */
  src: any;
  alt?: string;
  width: number;
  height: number;
  loading?: "eager" | "lazy" | null | undefined;
  decoding?: "async" | "auto" | "sync" | null | undefined;
  layout?: "constrained" | "fixed" | "full-width" | "none";
  fit?: "contain" | "cover" | "fill" | "none" | "scale-down";
  sizes?: string;
  widths?: number[];
  densities?: (number | `${number}x`)[];
  format?: "auto" | "avif" | "jpeg" | "png" | "svg" | "webp";
  class?: string;
  style?: any;
}

// Destructuring Astro.props to get the component's props
let {
  src,
  alt,
  width,
  height,
  loading,
  decoding,
  layout,
  fit,
  sizes,
  widths,
  densities,
  class: className,
  format,
  style,
} = Astro.props;

const parsed = parseImage(src);
const remote = parsed?.kind === "sanity" ? parsed : undefined;
const steps = [...new Set((widths ?? [width, width * 2]).filter((w) => w <= (remote?.width ?? 0)))].sort((a, b) => a - b);
const remoteSrc = (w: number) => sanityUrl(remote!, { width: w, height: (w * height) / width, fit });
src = parsed?.kind === "local" ? `/public${parsed.path}` : "";

// Glob pattern to load images from the /public/images folder
const images = import.meta.glob("/public/images/**/*.{jpeg,jpg,png,gif,svg,webp,avif}");

// Check if the source path is valid
const isValidPath = images[src] ? true : false;

// Log a warning message in red if the image is not found
!isValidPath &&
  !remote &&
  console.error(
    `\x1b[31mImage not found - ${JSON.stringify(Astro.props.src)}.\x1b[0m Use a Sanity image, its cdn.sanity.io address, or a file in /public/images.`,
  );
---

{
  remote && (
    <img
      src={remoteSrc(Math.min(width, remote.width))}
      srcset={!remote.svg && steps.length > 1 ? steps.map((w) => `${remoteSrc(w)} ${w}w`).join(", ") : undefined}
      sizes={!remote.svg && steps.length > 1 ? (sizes ?? `(min-width: ${width}px) ${width}px, 100vw`) : undefined}
      alt={remote.alt ?? alt ?? ""}
      width={width}
      height={height}
      loading={loading ?? "lazy"}
      decoding={decoding ?? "async"}
      class={className}
      style={style}
    />
  )
}
{
  isValidPath && (
    <Image
      src={images[src]() as Promise<{ default: ImageMetadata }>}
      alt={alt ?? null}
      width={width}
      height={height}
      loading={loading}
      decoding={decoding}
      layout={layout as any}
      fit={fit as any}
      sizes={sizes}
      widths={widths as any}
      densities={densities}
      class={className}
      format={format}
      style={style}
    />
  )
}
