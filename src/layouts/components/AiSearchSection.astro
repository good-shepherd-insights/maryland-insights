---
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Card = {
  title: string;
  body: string;
};

type HonestTake = {
  title?: string;
  body: string;
};

type Props = {
  bg?: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  cards?: Card[];
  engines?: string[];
  /** Micro-label above the engine chips; keeps the label editable from markdown. */
  enginesLabel?: string;
  honestTake?: HonestTake;
  /** "compact" is a tighter band for hubs and long editorial pages. */
  variant?: "section" | "compact";
  anchor?: string;
  headingLevel?: "h2" | "h3";
};

const {
  eyebrow,
  title,
  intro,
  cards = [],
  engines = [],
  enginesLabel,
  honestTake,
  variant = "section",
  anchor,
  headingLevel = "h2",
  bg = "cream",
} = Astro.props as Props;

const headingId = `ai-${slugify(title)}`;
const enginesLabelId = `${headingId}-engines-label`;
const Heading = headingLevel;
const CardHeading = headingLevel === "h2" ? "h3" : "h4";
const shownEngines = engines;
---

<section id={anchor} aria-labelledby={headingId}>
  <div class:list={["sp-sec", `hp-${bg}`]}>
    <div class="hp-in sp-stack">
      <div class="sp-title">
        {eyebrow && <p class="sp-eyebrow">{eyebrow}</p>}
        <Heading id={headingId} class="sp-h2 sp-h2-lg">{title}</Heading>
        {intro && <p class="sp-lead-p" set:html={markdownify(intro)} />}
      </div>
      {cards.length > 0 && (
        <ul class="sp-cols" style="--n:3">
          {cards.map((card, index) => (
            <li class="sp-rule sp-rule-3"><span class="sp-big sp-red">{String(index + 1).padStart(2, "0")}</span><CardHeading class="sp-h3">{card.title}</CardHeading><p set:html={markdownify(card.body)} /></li>
          ))}
        </ul>
      )}
      {shownEngines.length > 0 && (
        <div class="sp-engines"><p id={enginesLabelId}>{enginesLabel}</p><ul aria-labelledby={enginesLabelId}>{shownEngines.map((engine) => <li>{engine}</li>)}</ul></div>
      )}
    </div>
  </div>
  {honestTake && (
    <aside class="sp-sec sp-sec-s hp-red"><div class="hp-in sp-head"><p class="sp-h2 sp-h2-s">{honestTake.title}</p><div class="content sp-prose" set:html={markdownify(honestTake.body, true) as string} /></div></aside>
  )}
</section>
