---
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Card = {
  title: string;
  body: string;
};

type HonestTake = {
  title?: string;
  body: string;
};

type Props = {
  eyebrow?: string;
  title: string;
  intro?: string;
  cards?: Card[];
  engines?: string[];
  /** Micro-label above the engine chips; keeps the label editable from markdown. */
  enginesLabel?: string;
  honestTake?: HonestTake;
  /** "compact" is a tighter band for hubs and long editorial pages. */
  variant?: "section" | "compact";
  anchor?: string;
  headingLevel?: "h2" | "h3";
};

const {
  eyebrow,
  title,
  intro,
  cards = [],
  engines = [],
  enginesLabel = "Answer engines",
  honestTake,
  variant = "section",
  anchor,
  headingLevel = "h2",
} = Astro.props as Props;

const headingId = `ai-${slugify(title)}`;
const enginesLabelId = `${headingId}-engines-label`;
const Heading = headingLevel;
const CardHeading = headingLevel === "h2" ? "h3" : "h4";
---

<section
  id={anchor}
  class:list={[
    variant === "compact" ? "section-sm" : "section",
    "border-y border-border/70 bg-body overflow-x-hidden",
  ]}
  aria-labelledby={headingId}
>
  <div class="container mx-auto lg:w-[88%] xl:w-[80%]">
    <div class="mx-auto max-w-3xl">
      {
        eyebrow && (
          <p class="mb-5 inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.14em] text-primary">
            <span class="h-px w-8 bg-primary" aria-hidden="true"></span>
            {eyebrow}
          </p>
        )
      }

      <Heading id={headingId} class="max-w-[22ch] text-balance">
        {title}
      </Heading>

      {
        intro && (
          <p class="mt-4 max-w-[62ch] text-lg leading-relaxed text-text" set:html={markdownify(intro)} />
        )
      }
    </div>

    {
      cards.length > 0 && (
        <ul class="mx-auto mt-10 grid max-w-6xl gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
          {cards.map((card, index) => (
            <li class="min-w-0">
              <div
                class:list={[
                  "h-full rounded-xl border border-border bg-body p-6",
                  variant === "section" &&
                    "shadow-[0_1px_2px_rgba(18,18,18,0.04),0_16px_40px_-16px_rgba(18,18,18,0.14)]",
                ]}
              >
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-text-light">
                  {String(index + 1).padStart(2, "0")}
                </p>
                <CardHeading class="mt-2 min-w-0 break-words font-secondary text-h6 font-bold text-text-dark">
                  {card.title}
                </CardHeading>
                <p class="mt-3 leading-relaxed text-text" set:html={markdownify(card.body)} />
              </div>
            </li>
          ))}
        </ul>
      )
    }

    {
      engines.length > 0 && (
        <div class="mx-auto mt-10 max-w-6xl">
          <p id={enginesLabelId} class="text-xs font-semibold uppercase tracking-[0.14em] text-text-light">
            {enginesLabel}
          </p>
          <ul class="mt-3 flex flex-wrap gap-2" aria-labelledby={enginesLabelId}>
            {engines.map((engine) => (
              <li class="min-w-0 break-words rounded-full border border-border bg-light px-3.5 py-1.5 text-sm text-text-dark">
                {engine}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      honestTake && (
        <aside class="mx-auto mt-10 max-w-3xl rounded-xl border border-border bg-light p-6 sm:p-7">
          <p class="flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.14em] text-text-dark">
            <svg
              class="h-4 w-4 shrink-0 text-primary"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
            {honestTake.title ?? "Honest take"}
          </p>
          <div class="content mt-3 text-sm leading-relaxed text-text" set:html={markdownify(honestTake.body, true) as string} />
        </aside>
      )
    }
  </div>
</section>
