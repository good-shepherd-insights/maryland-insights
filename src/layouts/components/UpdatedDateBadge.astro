---
type Props = {
  dateModified: string;
  datePublished?: string;
  label?: string;
  variant?: "inline" | "badge" | "minimal";
  showPublished?: boolean;
  class?: string;
};

const {
  dateModified,
  datePublished,
  label = "Last updated",
  variant = "inline",
  showPublished = true,
  class: className,
} = Astro.props as Props;

const DAY_MS = 86_400_000;
const STALE_DAYS = 180;
const PUBLISH_DIFF_DAYS = 7;

const parseDate = (raw: string | undefined): Date | null => {
  if (!raw || typeof raw !== "string") return null;
  const d = new Date(raw.trim());
  return Number.isNaN(d.getTime()) ? null : d;
};

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});

const datetimeAttr = (raw: string, d: Date): string => {
  const trimmed = raw.trim();
  return /^\d{4}-\d{2}-\d{2}$/.test(trimmed) ? trimmed : d.toISOString();
};

const modified = parseDate(dateModified);
if (!modified) return null;

const modifiedText = dateFormatter.format(modified);
const modifiedDatetime = datetimeAttr(dateModified, modified);

const published = parseDate(datePublished);
const showPublishedContext =
  showPublished &&
  published !== null &&
  Math.abs(modified.getTime() - published.getTime()) >= PUBLISH_DIFF_DAYS * DAY_MS;
const publishedText = published ? dateFormatter.format(published) : "";
const publishedDatetime =
  published && datePublished ? datetimeAttr(datePublished, published) : "";

const isStale = new Date().getTime() - modified.getTime() > STALE_DAYS * DAY_MS;
const showStaleNote = isStale && variant !== "minimal";
---

{
  variant === "badge" ? (
    <span
      class:list={[
        "inline-flex max-w-full min-w-0 flex-wrap items-center gap-x-2 gap-y-1 rounded-full border border-border bg-light px-3 py-1 text-xs font-semibold tracking-[0.14em] text-text-dark",
        className,
      ]}
    >
      <svg
        class="h-3.5 w-3.5 shrink-0 text-primary"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="1.75" y="2.75" width="12.5" height="11.5" rx="2" />
        <path d="M1.75 6.25h12.5" />
        <path d="M5 1.5v2.5" />
        <path d="M11 1.5v2.5" />
      </svg>
      <span class="min-w-0 break-words uppercase">{label}</span>
      <time datetime={modifiedDatetime} class="min-w-0 break-words tabular-nums">
        {modifiedText}
      </time>
      {showPublishedContext && (
        <span class="min-w-0 break-words uppercase text-text-light">
          <span aria-hidden="true">· </span>Published <time datetime={publishedDatetime} class="normal-case tracking-normal tabular-nums">{publishedText}</time>
        </span>
      )}
      {showStaleNote && (
        <span class="min-w-0 break-words normal-case tracking-normal text-text-light">
          (this page may be out of date)
        </span>
      )}
    </span>
  ) : variant === "minimal" ? (
    <span
      class:list={["inline-block max-w-full min-w-0 break-words text-sm tabular-nums text-text-light", className]}
    >
      <time datetime={modifiedDatetime}>{modifiedText}</time>
    </span>
  ) : (
    <div
      class:list={["flex max-w-full min-w-0 flex-wrap items-baseline gap-x-2 gap-y-0.5", className]}
    >
      <span class="text-xs font-semibold uppercase tracking-[0.14em] text-text-light">
        {label}
      </span>
      <time datetime={modifiedDatetime} class="min-w-0 break-words text-sm font-medium tabular-nums text-text-dark">
        {modifiedText}
      </time>
      {showPublishedContext && (
        <span class="min-w-0 break-words text-xs text-text-light">
          <span aria-hidden="true">·</span>
          <span class="uppercase tracking-[0.14em] font-semibold">Published</span>{" "}
          <time datetime={publishedDatetime} class="tabular-nums">{publishedText}</time>
        </span>
      )}
      {showStaleNote && (
        <span class="min-w-0 break-words text-xs text-text-light">
          (this page may be out of date)
        </span>
      )}
    </div>
  )
}
