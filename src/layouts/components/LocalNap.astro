---
import { LAND } from "@/lib/home/land";
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Props = {
  bg?: string;
  /** Business name shown with the address; falls back as the heading text when no title is given. */
  name?: string;
  street: string;
  city: string;
  /** Two-letter state/region code, e.g. "MD". */
  region: string;
  postal: string;
  country?: string;
  phone: string;
  email: string;
  hours?: string;
  mapUrl?: string;
  variant?: "inline" | "card" | "compact";
  eyebrow?: string;
  /** Section heading for the card/inline variants; defaults to `name`, then "Contact details". */
  title?: string;
  /** Short prose under the card heading. */
  intro?: string;
  /** Small honesty/context caption rendered below the details. */
  note?: string;
  headingLevel?: "h2" | "h3";
  /** Jump-link id on the section. */
  anchor?: string;
  ui?: {
    addressLabel?: string;
    phoneLabel?: string;
    emailLabel?: string;
    hoursLabel?: string;
    mapLabel?: string;
    viewOnMapsLabel?: string;
  };
};

const {
  name,
  street,
  city,
  region,
  postal,
  country = "US",
  phone,
  email,
  hours,
  mapUrl,
  eyebrow,
  title,
  intro,
  note,
  headingLevel = "h2",
  anchor,
  ui,
  bg = "white",
} = Astro.props as Props;

const heading = title ?? name;
const headingId = `nap-${slugify(heading)}`;

const line2 = [[city, [region, postal].filter(Boolean).join(" ")].filter(Boolean).join(", "), country !== "US" ? country : null]
  .filter(Boolean)
  .join(", ");
const telHref = `tel:${phone.replace(/[^\d+]/g, "")}`;

type Row = { label?: string; value?: string; href?: string; tabular?: boolean };

const rows: Row[] = [
  { label: ui?.addressLabel, value: [street, line2].filter(Boolean).join("\n") },
  { label: ui?.phoneLabel, value: phone, href: telHref, tabular: true },
  { label: ui?.emailLabel, value: email, href: `mailto:${email}` },
  ...(hours ? [{ label: ui?.hoursLabel, value: hours }] : []),
  ...(mapUrl ? [{ label: ui?.mapLabel, value: ui?.viewOnMapsLabel, href: mapUrl }] : []),
];
---

<section id={anchor} class:list={["sp-sec", `hp-${bg}`]} aria-labelledby={headingId}>
  <div class="hp-in sp-nap">
    <div class="sp-title">
      {eyebrow && <p class="sp-eyebrow">{eyebrow}</p>}
      {headingLevel === "h2" ? <h2 id={headingId} class="sp-h2" set:html={markdownify(heading)} /> : <h3 id={headingId} class="sp-h2" set:html={markdownify(heading)} />}
      {intro && <p class="sp-lead-p sp-mut" set:html={markdownify(intro)} />}
      {note && <p class="sp-small" set:html={markdownify(note)} />}
      <svg class="sp-map sp-map-light" viewBox="-4 -4 1008 532" aria-hidden="true">{Object.entries(LAND).map(([county, d]) => <path class:list={[{ on: county === "Prince George's" }]} d={d} />)}<path class="sp-pin" d="M610 258c-13-28-42-48-42-82a42 42 0 1 1 84 0c0 34-29 54-42 82z" /><circle cx="610" cy="176" r="16" fill="#fff" /></svg>
    </div>
    <div class="sp-nap-card hp-ink">
      {name && <p class="sp-h3">{name}</p>}
      <ul>
        {rows.map((row) => (
          <li>
            <p>{row.label}</p>
            {row.href
              ? <a href={row.href} target={row.href.startsWith("http") ? "_blank" : undefined} rel={row.href.startsWith("http") ? "noopener noreferrer" : undefined}>{row.value}</a>
              : <p>{row.value?.split("\n").map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
