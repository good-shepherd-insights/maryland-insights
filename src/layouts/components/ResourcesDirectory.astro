---
import { markdownify, slugify } from "@/lib/utils/textConverter";

type ResourceItem = {
  name: string;
  url: string;
  /** Short label chip (e.g. "EDO", "County site"). Keep it brief — it sits on one line. */
  type?: string;
  /** Official mark. Square SVG when the organization publishes one; PNG when they don't. */
  logo?: string;
  /** The mark already contains the name, so the row shows the logo with the link under it. */
  wordmark?: boolean;
};

type ResourceGroup = {
  category: string;
  description?: string;
  items?: ResourceItem[];
};

type Props = {
  bg?: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  groups?: ResourceGroup[];
  /** grid: group cards; list: stacked directory rows; compact: inline pills for dense surfaces. */
  variant?: "grid" | "list" | "compact";
  footerNote?: string;
  anchor?: string;
  headingLevel?: "h2" | "h3";
};

const {
  eyebrow,
  title,
  intro,
  groups = [],
  variant = "grid",
  footerNote,
  anchor,
  headingLevel = "h2",
  bg = "cream",
} = Astro.props as Props;

const headingId = `resources-${slugify(title)}`;
const GroupHeading = headingLevel === "h2" ? "h3" : "h4";
const Heading = headingLevel;

// Defensive: drop malformed groups/items so the section can never render empty anchors or dead links.
const shown = groups
  .filter((group) => group && typeof group.category === "string" && group.category.trim() !== "")
  .map((group) => {
    const items = (group.items ?? []).filter(
      (item) =>
        item &&
        typeof item.name === "string" &&
        item.name.trim() !== "" &&
        typeof item.url === "string" &&
        item.url.trim() !== "",
    );

    return {
      ...group,
      items,
    };
  })
  .filter((group) => group.items.length > 0);

const count = shown.length;

// Root-relative paths are internal; everything else opens as an external reference.
const isInternal = (url: string) => url.trim().startsWith("/") && !url.trim().startsWith("//");

// Host is shown as a plain readable line so the destination is visible, not guessed.
const hostOf = (url: string): string => {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return "";
  }
};

---

{
  count > 0 && (
    <section id={anchor === headingId ? undefined : anchor} class:list={["sp-sec", `hp-${bg}`]} aria-labelledby={headingId}>
      <div class="hp-in sp-stack">
        <div class="sp-title">
          {eyebrow && <p class="sp-eyebrow">{eyebrow}</p>}
          <Heading id={headingId} class="sp-h2 sp-h2-lg">{title}</Heading>
          {intro && <p class="sp-lead-p" set:html={markdownify(intro)} />}
        </div>
        <div>
          {shown.map((group) => (
            <div class="sp-res">
              <div><GroupHeading class="sp-h3">{group.category}</GroupHeading>{group.description && <p class="sp-mut" set:html={markdownify(group.description)} />}</div>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <a href={item.url} target={isInternal(item.url) ? undefined : "_blank"} rel={isInternal(item.url) ? undefined : "noopener noreferrer nofollow"}>
                      {item.logo && <img src={item.logo} alt={item.wordmark ? item.name : ""} loading="lazy" />}
                      {!item.wordmark && <span class="sp-res-n">{item.name}</span>}
                      {!isInternal(item.url) && hostOf(item.url) !== "" && <span class="sp-res-h">{hostOf(item.url)}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        {footerNote && <p class="sp-small" set:html={markdownify(footerNote)} />}
      </div>
    </section>
  )
}
