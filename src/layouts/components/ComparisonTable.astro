---
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Column = {
  name: string;
  key: string;
  /** Optional fixed width as a percentage of the table; auto columns share what's left. */
  width?: number;
};

type CellValue = string | boolean | null | undefined;

type Row = {
  key: string;
  label: string;
  description?: string;
  values: Record<string, CellValue>;
};

type Props = {
  bg?: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  columns: Column[];
  rows: Row[];
  footerNote?: string;
  /** Row key to tint and accent — usually the Maryland Insights row (passed as content, never hardcoded). */
  highlightRow?: string;
  /** table: desktop table with stacked cards below md (mirrors ReplacesTable + ReplacesTableMobile); stacked-cards: cards at every width. */
  variant?: "table" | "stacked-cards";
  /** Header text of the row-label column (the analog's hardcoded "Features"). */
  firstColumnLabel?: string;
  anchor?: string;
  headingLevel?: "h2" | "h3";
  ui?: { includedLabel?: string; notIncludedLabel?: string };
};

const {
  eyebrow,
  title,
  intro,
  columns = [],
  rows = [],
  footerNote,
  highlightRow,
  variant = "table",
  firstColumnLabel,
  anchor,
  headingLevel = "h2",
  ui,
  bg = "cream",
} = Astro.props as Props;

const headingId = `comparison-${slugify(title)}`;
const Heading = headingLevel;

// Defensive: malformed columns/rows are dropped so the table never renders dead cells or empty sections.
const shownColumns = columns.filter(
  (col) =>
    col &&
    typeof col.key === "string" &&
    col.key.trim() !== "" &&
    typeof col.name === "string" &&
    col.name.trim() !== "",
);
const shownRows = rows.filter(
  (row) =>
    row &&
    typeof row.key === "string" &&
    row.key.trim() !== "" &&
    typeof row.label === "string" &&
    row.label.trim() !== "",
);
const has = shownColumns.length > 0 && shownRows.length > 0;

// "Included" is a full bar, a word such as "Basic" is a half bar, anything else is empty.
const cell = (value: CellValue) =>
  value === true ? { state: "full", text: ui?.includedLabel } : typeof value === "string" && value.trim() !== "" ? { state: "half", text: value } : { state: "none", text: ui?.notIncludedLabel };
---

{
  has && (
    <section id={anchor} class:list={["sp-sec", `hp-${bg}`]} aria-labelledby={headingId}>
      <div class="hp-in sp-stack">
        <div class="sp-head sp-head-end">
          <div class="sp-title">
            {eyebrow && <p class="sp-eyebrow">{eyebrow}</p>}
            <Heading id={headingId} class="sp-h2">{title}</Heading>
          </div>
          {intro && <p set:html={markdownify(intro)} />}
        </div>
        <table class="sp-cmp" role="table">
          <caption class="sr-only">{title}</caption>
          <thead role="rowgroup"><tr role="row"><th role="columnheader" scope="col">{firstColumnLabel}</th>{shownColumns.map((col) => <th role="columnheader" scope="col" class="sr-only">{col.name}</th>)}</tr></thead>
          <tbody role="rowgroup">
            {shownRows.map((row) => (
              <tr role="row" class:list={[{ us: row.key === highlightRow || row.label === highlightRow }]} style={`--n:${shownColumns.length}`}>
                <th role="rowheader" scope="row">{row.label}{row.description && <span>{row.description}</span>}</th>
                {shownColumns.map((col) => { const c = cell(row.values?.[col.key]); return <td role="cell" data-col={col.name}><i class={`sp-c-${c.state}`} aria-hidden="true"></i><b>{c.text}</b></td>; })}
              </tr>
            ))}
          </tbody>
        </table>
        {footerNote && <p class="sp-small" set:html={markdownify(footerNote)} />}
      </div>
    </section>
  )
}
