---
import { markdownify, slugify } from "@/lib/utils/textConverter";

type Column = {
  name: string;
  key: string;
  /** Optional fixed width as a percentage of the table; auto columns share what's left. */
  width?: number;
};

type CellValue = string | boolean | null | undefined;

type Row = {
  key: string;
  label: string;
  description?: string;
  values: Record<string, CellValue>;
};

type Props = {
  eyebrow?: string;
  title: string;
  intro?: string;
  columns: Column[];
  rows: Row[];
  footerNote?: string;
  /** Row key to tint and accent — usually the Maryland Insights row (passed as content, never hardcoded). */
  highlightRow?: string;
  /** table: desktop table with stacked cards below md (mirrors ReplacesTable + ReplacesTableMobile); stacked-cards: cards at every width. */
  variant?: "table" | "stacked-cards";
  /** Header text of the row-label column (the analog's hardcoded "Features"). */
  firstColumnLabel?: string;
  anchor?: string;
  headingLevel?: "h2" | "h3";
};

const {
  eyebrow,
  title,
  intro,
  columns = [],
  rows = [],
  footerNote,
  highlightRow,
  variant = "table",
  firstColumnLabel = "Features",
  anchor,
  headingLevel = "h2",
} = Astro.props as Props;

const headingId = `comparison-${slugify(title)}`;
const Heading = headingLevel;

// Defensive: malformed columns/rows are dropped so the table never renders dead cells or empty sections.
const shownColumns = columns.filter(
  (col) =>
    col &&
    typeof col.key === "string" &&
    col.key.trim() !== "" &&
    typeof col.name === "string" &&
    col.name.trim() !== "",
);
const shownRows = rows.filter(
  (row) =>
    row &&
    typeof row.key === "string" &&
    row.key.trim() !== "" &&
    typeof row.label === "string" &&
    row.label.trim() !== "",
);
const has = shownColumns.length > 0 && shownRows.length > 0;

// Width shares mirror the analog's CSS (.feature-column { width: 28% }).
const LABEL_WIDTH = 28;
const isFixed = (col: Column) =>
  typeof col.width === "number" && col.width > 0 && col.width < 100;
const definedWidth = shownColumns.reduce((sum, col) => sum + (isFixed(col) ? col.width! : 0), 0);
const autoCount = shownColumns.filter((col) => !isFixed(col)).length;
const autoWidth = autoCount > 0 ? Math.max(0, 100 - LABEL_WIDTH - definedWidth) / autoCount : 0;
const widthOf = (col: Column) => (isFixed(col) ? col.width! : autoWidth);

// Inline SVG mirrors the analog's check/cross sprite assets (active.svg stroke 2, cross.svg stroke 1.5,
// active-accent.svg as the primary-tinted check for highlighted rows).
const yesIcon = (accent: boolean) =>
  `<svg class="block h-4 w-4 ${accent ? "text-primary" : "text-text-dark"}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 14L8.5 17.5L19 6.5"/></svg><span class="sr-only">Included</span>`;
const noIcon =
  '<svg class="block h-4 w-4 text-text-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19.0005 5L5.00049 19M5.00049 5L19.0005 19"/></svg><span class="sr-only">Not included</span>';
---

{
  has && (
    <section
      id={anchor}
      class="section-sm border-y border-border/70 bg-body overflow-x-hidden"
      aria-labelledby={headingId}
    >
      <div class="container mx-auto lg:w-[88%] xl:w-[80%]">
        <header class="max-w-3xl">
          {
            eyebrow && (
              <p class="mb-5 inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.14em] text-primary">
                <span class="h-px w-8 bg-primary" aria-hidden="true"></span>
                {eyebrow}
              </p>
            )
          }

          <Heading id={headingId} class="max-w-[18ch] text-balance">
            {title}
          </Heading>

          {
            intro && (
              <p class="mt-4 max-w-[62ch] leading-relaxed text-text" set:html={markdownify(intro)} />
            )
          }
        </header>

        {variant === "table" && (
          <div class="mt-10 hidden md:block">
            <div class="comparison-frame rounded-2xl border border-border p-4 sm:p-6">
              <table class="comparison-table min-w-full text-left table-fixed">
                <caption class="sr-only">{title}</caption>
                <colgroup>
                  <col style={`width:${LABEL_WIDTH}%`} />
                  {shownColumns.map((col) => (
                    <col style={`width:${widthOf(col)}%`} />
                  ))}
                </colgroup>
                <thead>
                  <tr>
                    <th scope="col" class="bg-light p-5 border-b border-r border-border">
                      <span class="font-semibold break-words [overflow-wrap:anywhere]">
                        {firstColumnLabel}
                      </span>
                    </th>
                    {shownColumns.map((col, index) => (
                      <th
                        scope="col"
                        class:list={[
                          "bg-light p-5 border-b text-center",
                          index !== shownColumns.length - 1 && "border-r border-border",
                        ]}
                      >
                        <span class="text-sm font-semibold break-words [overflow-wrap:anywhere]">
                          {col.name}
                        </span>
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {shownRows.map((row, rowIndex) => {
                    const highlighted = row.key === highlightRow;
                    const lastRow = rowIndex === shownRows.length - 1;
                    return (
                      <tr>
                        <th
                          scope="row"
                          class:list={[
                            "bg-light p-5 text-left font-normal border-r border-border",
                            !lastRow && "border-b border-border",
                          ]}
                        >
                          <span class="block font-primary text-base font-semibold break-words [overflow-wrap:anywhere]">
                            {row.label}
                          </span>
                          {row.description && (
                            <p class="mt-1 max-w-[68ch] text-sm text-text-dark/70">{row.description}</p>
                          )}
                        </th>
                        {shownColumns.map((col, index) => {
                          const value = row.values?.[col.key];
                          return (
                            <td
                              class:list={[
                                "p-5 text-center align-middle",
                                index !== shownColumns.length - 1 && "border-r border-border",
                                !lastRow && "border-b border-border",
                                highlighted && "bg-primary/5",
                              ]}
                            >
                              {value === true && <span class="flex w-full items-center justify-center" set:html={yesIcon(highlighted)} />}
                              {value === false && <span class="flex w-full items-center justify-center" set:html={noIcon} />}
                              {typeof value === "string" && value.trim() !== "" && (
                                <span class="text-sm leading-relaxed break-words [overflow-wrap:anywhere]">
                                  {value}
                                </span>
                              )}
                            </td>
                          );
                        })}
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        )}

        <div class:list={["mt-10 flex flex-col gap-8", variant === "table" && "md:hidden"]}>
          {shownRows.map((row) => {
            const highlighted = row.key === highlightRow;
            return (
              <div
                class:list={[
                  "rounded-xl border overflow-hidden bg-body",
                  highlighted ? "border-primary/40" : "border-border",
                ]}
              >
                <div
                  class:list={[
                    "border-b border-border p-6 flex items-center justify-center text-center",
                    highlighted ? "bg-primary/5" : "bg-light",
                  ]}
                >
                  <div class="min-w-0">
                    <span class="block font-primary text-base font-semibold break-words [overflow-wrap:anywhere]">
                      {row.label}
                    </span>
                    {row.description && (
                      <p class="mt-1 text-sm text-text-dark/70">{row.description}</p>
                    )}
                  </div>
                </div>

                <div class="flex flex-col">
                  {shownColumns.map((col, index) => {
                    const value = row.values?.[col.key];
                    const isLast = index === shownColumns.length - 1;
                    return (
                      <div
                        class:list={[
                          "p-6 flex items-start justify-between gap-3",
                          !isLast && "border-b border-border",
                        ]}
                      >
                        <span class="min-w-0 flex-1 font-primary text-base font-semibold break-words [overflow-wrap:anywhere]">
                          {col.name}
                        </span>
                        {value === true && <span class="flex min-h-6 shrink-0 items-center justify-center" set:html={yesIcon(highlighted)} />}
                        {value === false && <span class="flex min-h-6 shrink-0 items-center justify-center" set:html={noIcon} />}
                        {typeof value === "string" && value.trim() !== "" && (
                          <span class="min-w-0 max-w-[58%] text-right text-sm leading-relaxed break-words [overflow-wrap:anywhere]">
                            {value}
                          </span>
                        )}
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>

        {
          footerNote && (
            <p
              class="mt-10 max-w-[62ch] text-sm leading-relaxed text-text-light"
              set:html={markdownify(footerNote)}
            />
          )
        }
      </div>
    </section>
  )
}

<style>
  .comparison-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
  }

  .comparison-table :is(th, td) {
    padding-inline: clamp(12px, 1.5vw, 20px);
    overflow-wrap: anywhere;
  }
</style>
