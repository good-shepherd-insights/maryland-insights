---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import social from "@/config/social.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import trackingConfig from "@/config/tracking.json";
import TrackingManager from "../components/tracking/TrackingManager.astro";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { GoogleTagmanagerNoscript } from "@digi4care/astro-google-tagmanager";
import { AstroFont } from "astro-font";
import { ClientRouter } from "astro:transitions";
import { SEO } from "astro-seo";
import JsonLd from "@/lib/seo/JsonLd.astro";
import { buildWebSite, buildOrganization, buildBreadcrumbList, buildWebPage, buildNavigation } from "@/lib/seo/graph";
import { canonicalUrl } from "@/lib/seo/ids";
import { getOpenGraphImagePath } from "@/lib/seo/openGraphImagePath";

// font families
const pf = theme.fonts.font_family.primary;
const sf = theme.fonts.font_family.secondary;

let fontPrimary, fontSecondary;
const cleanName = (f: string) => f.split(":")[0].replace(/\+/g, " ");
if (theme.fonts.font_family.primary) {
  fontPrimary = cleanName(theme.fonts.font_family.primary);
}
if (theme.fonts.font_family.secondary) {
  fontSecondary = cleanName(theme.fonts.font_family.secondary);
}

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  schema?: any[];
  head_links?: { rel: string; href: string; crossorigin?: string }[];
  og_type?: "website" | "article";
  date_published?: string;
  date_modified?: string;
  author_name?: string;
  author_twitter?: string;
  article_tags?: string[];
  article_section?: string;
  googlebot?: string;
}

// Derive Twitter handle from social.json ("x" entry)
const twitterEntry = social.main.find((s) => s.name === "x");
const twitterHandle = twitterEntry
  ? `@${twitterEntry.link.split("/").filter(Boolean).pop()}`
  : undefined;

// Resolve locale for inLanguage — derived from config only
const resolvedLocale = config.metadata.locale ? config.metadata.locale.replace("_", "-") : undefined;

// destructure frontmatter
const {
  title, meta_title, description, noindex, canonical,
  og_type = "website", date_published, date_modified, author_name,
  author_twitter, article_tags, article_section, googlebot,
  head_links = []
} = Astro.props;

const resolvedImage = getOpenGraphImagePath(Astro.url.pathname);

// Combine all graph items — shared nodes come from typed builders in @/lib/seo/graph
// so canonical/@id generation can't diverge per page (see @/lib/seo/ids canonicalUrl).
const graphItems: unknown[] = [
  buildWebSite(),
  buildOrganization(),
  buildBreadcrumbList(Astro.url.pathname),
  buildWebPage({
    pathname: Astro.url.pathname,
    name: meta_title ? meta_title : title ? title : config.site.title,
    description: description ? description : config.metadata.meta_description,
    canonical,
    image: resolvedImage ? `${config.site.base_url}${resolvedImage}` : undefined,
    locale: resolvedLocale,
  }),
  buildNavigation(),
  ...(Astro.props.schema || []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <!-- unified tracking manager -->
    <TrackingManager />
    
    <SEO
      title={plainify(meta_title ? meta_title : title ? title : config.site.title)}
      description={plainify(description ? description : config.metadata.meta_description)}
      canonical={canonical || canonicalUrl(Astro.url.pathname)}
      noindex={noindex}
      openGraph={{
        basic: {
          title: plainify(meta_title ? meta_title : title ? title : config.site.title),
          type: og_type,
          image: `${config.site.base_url}${resolvedImage}`,
          url: canonical || canonicalUrl(Astro.url.pathname)
        },
        optional: {
          description: plainify(description ? description : config.metadata.meta_description),
          locale: config.metadata.locale,
          siteName: config.site.logo_text || config.site.title,
        },
        image: {
          alt: plainify(meta_title ? meta_title : title ? title : config.site.title),
          width: config.metadata.meta_image_width,
          height: config.metadata.meta_image_height,
        },
        article: og_type === "article" ? {
          publishedTime: date_published,
          modifiedTime: date_modified,
          authors: author_name ? [author_name] : undefined,
          tags: article_tags,
          section: article_section,
        } : undefined
      }}
      twitter={{
        card: "summary_large_image",
        site: twitterHandle,
        creator: author_twitter ? `@${author_twitter}` : twitterHandle,
        title: plainify(meta_title ? meta_title : title ? title : config.site.title),
        description: plainify(description ? description : config.metadata.meta_description),
        image: `${config.site.base_url}${resolvedImage}`,
        imageAlt: plainify(meta_title ? meta_title : title ? title : config.site.title)
      }}
      extend={{
        meta: [
          { name: "referrer", content: "strict-origin-when-cross-origin" },
          ...(config.metadata.bot_directives
            ? Object.entries(config.metadata.bot_directives).map(
                ([bot, directive]) => ({
                  name: bot,
                  content: (bot === "googlebot" && googlebot) ? googlebot : directive as string,
                })
              )
            : []),
          { name: "theme-name", content: "Maryland-Insights" },
          { name: "msapplication-TileColor", content: "#000000" },
          { name: "theme-color", content: "#fff", media: "(prefers-color-scheme: light)" },
          { name: "theme-color", content: "#000", media: "(prefers-color-scheme: dark)" },
          { name: "author", content: config.metadata.meta_author }
        ],
        link: [
          { rel: "shortcut icon", href: config.site.favicon },
          { rel: "security", href: "/.well-known/security.txt" },
          { rel: "search", type: "application/opensearchdescription+xml", title: "Maryland Insights", href: "/opensearch.xml" },
          ...(head_links as any[])
        ]
      }}
    />

    <meta name="generator" content={Astro.generator} />

    <!-- google font css -->
    <AstroFont
      config={[
        {
          src: [],
          preload: false,
          display: "swap",
          name: fontPrimary!,
          fallback: "sans-serif",
          cssVariable: "font-primary",
          googleFontsURL: `https://fonts.googleapis.com/css2?family=${pf}&display=swap`,
        },
        {
          src: [],
          preload: false,
          display: "swap",
          name: fontSecondary!,
          fallback: "sans-serif",
          cssVariable: "font-secondary",
          googleFontsURL: `https://fonts.googleapis.com/css2?family=${sf}&display=swap`,
        },
      ]}
    />

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <ClientRouter />

    <JsonLd graph={graphItems} />
  </head>

  <body>
    {/* google tag manager noscript */}
    {
      trackingConfig.tracking.gtm?.enable && trackingConfig.tracking.gtm?.id && (
        <GoogleTagmanagerNoscript id={trackingConfig.tracking.gtm.id} />
      )
    }

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-dark focus:rounded-lg focus:shadow-lg focus:outline-none"
    >
      Skip to main content
    </a>
    <TwSizeIndicator />
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <button
      type="button"
      id="back-to-top"
      aria-label="Back to top"
      aria-hidden="true"
      tabindex="-1"
      class="fixed bottom-6 left-6 z-40 p-3 rounded-full bg-primary text-dark shadow-lg transition-all duration-300 opacity-0 pointer-events-none hover:scale-105 focus:outline-none focus-visible:ring-2 focus-visible:ring-dark focus-visible:ring-offset-2"
    >
      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
        <path d="M12 4l-8 8h5v8h6v-8h5z"/>
      </svg>
    </button>
    <Footer />

    <script>
      import Lenis from "lenis";

      declare global {
        interface Window {
          __novaiBaseInit?: boolean;
        }
      }

      // Prevent duplicate listeners/instances (can happen with HMR or reinjected scripts)
      if (!window.__novaiBaseInit) {
        window.__novaiBaseInit = true;

        // Always start at the top (disable native scroll restoration)
        if ("scrollRestoration" in history) {
          history.scrollRestoration = "manual";
        }

        let lenis: Lenis | null = null;
        let rafId: number | null = null;

        function scrollToTop() {
          if (lenis) {
            lenis.scrollTo(0, { immediate: true });
            return;
          }
          window.scrollTo(0, 0);
        }

        function destroyLenis() {
          if (rafId !== null) cancelAnimationFrame(rafId);
          rafId = null;

          if (lenis) {
            lenis.destroy();
            lenis = null;
          }
        }

        function initLenis() {
          destroyLenis();

          // Disable Lenis on touch devices to prevent conflicts with native momentum scrolling
          if (window.matchMedia("(pointer: coarse)").matches) {
            return;
          }

          lenis = new Lenis({
            autoRaf: false,
          });

          const raf = (time: number) => {
            if (!lenis) return;
            lenis.raf(time);
            rafId = requestAnimationFrame(raf);
          };

          rafId = requestAnimationFrame(raf);
        }

        document.addEventListener("astro:page-load", () => {
          scrollToTop();
          initLenis();
          // Ensure Lenis (once initialized) also snaps to top
          scrollToTop();
        });

        // Scroll to top on route change
        document.addEventListener("astro:after-swap", () => {
          scrollToTop();
        });

        // Scroll to top on full page reloads too
        window.addEventListener(
          "load",
          () => {
            scrollToTop();
          },
          { once: true },
        );

        // Handle bfcache restores
        window.addEventListener("pageshow", (event) => {
          if (event.persisted) scrollToTop();
        });

        // Show the back-to-top button only after the visitor scrolls upward.
        let previousScrollY = window.scrollY;
        let upwardTravel = 0;
        const setBackToTopVisible = (visible: boolean) => {
          const button = document.getElementById("back-to-top");
          if (!button) return;
          if (!visible && document.activeElement === button) {
            document.getElementById("main-content")?.focus({ preventScroll: true });
          }
          button.classList.toggle("opacity-0", !visible);
          button.classList.toggle("pointer-events-none", !visible);
          button.classList.toggle("opacity-100", visible);
          button.setAttribute("aria-hidden", String(!visible));
          button.tabIndex = visible ? 0 : -1;
        };

        window.addEventListener("scroll", () => {
          const currentScrollY = window.scrollY;
          const delta = currentScrollY - previousScrollY;
          previousScrollY = currentScrollY;

          if (currentScrollY <= 500 || delta > 0) {
            upwardTravel = 0;
            setBackToTopVisible(false);
          } else if (delta < 0) {
            upwardTravel += -delta;
            if (upwardTravel >= 12) setBackToTopVisible(true);
          }
        });

        document.addEventListener("astro:page-load", () => {
          previousScrollY = window.scrollY;
          upwardTravel = 0;
          setBackToTopVisible(false);
        });

        document.addEventListener("click", (event) => {
          if (!(event.target instanceof Element) || !event.target.closest("#back-to-top")) return;
          scrollToTop();
          previousScrollY = window.scrollY;
          upwardTravel = 0;
          setBackToTopVisible(false);
        });

        // Cleanup before Astro swaps DOM
        document.addEventListener("astro:before-preparation", () => {
          destroyLenis();
        });
      }
    </script>
  </body>
</html>
