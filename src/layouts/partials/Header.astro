---
import Logo from "@/layouts/components/Logo.astro";
import { navTile } from "@/lib/navTiles";
import { getSiteSettings, getPartnerCta } from "@/lib/sanity/queries";

export interface ChildNavigationLink {
  name: string;
  url: string;
}

export interface NavigationLink {
  name: string;
  url?: string;
  hasChildren?: boolean;
  children?: ChildNavigationLink[];
}

// Site chrome comes from Sanity siteSettings, not config files.
const siteSettings = await getSiteSettings();
const main: NavigationLink[] = (siteSettings?.navLinks ?? []).map(
  (link: any): NavigationLink => ({
    name: link.label,
    url: link.href && link.href !== "#" ? link.href : undefined,
    hasChildren:
      Array.isArray(link.children) && link.children.length > 0,
    children: (link.children ?? []).map((child: any): ChildNavigationLink => ({
      name: child.label,
      url: child.href,
    })),
  })
);
const partner = await getPartnerCta();
const navigation_button = siteSettings?.navigationButton
  ? {
      enable: true,
      label: partner.label || siteSettings.navigationButton.label,
      link: partner.link || siteSettings.navigationButton.link,
    }
  : { enable: false, label: "", link: "" };
const { pathname } = Astro.url;
const isHere = (url?: string) => !!url && (pathname === url || pathname === `${url}/`);
const isInside = (url?: string) => !!url && (isHere(url) || pathname.startsWith(`${url}/`));
const isExternal = (url?: string) => !!url && url.startsWith("http");

type Props = {
  ui?: {
    toggleLabel?: string;
    menuOpenTitle?: string;
    menuCloseTitle?: string;
  };
};

const { ui } = Astro.props as Props;
---

<header class="header">
  <nav class="navbar">
    <div class="nav-logo"><Logo /></div>

    <input id="nav-toggle" type="checkbox" class="hidden" />
    <label
      for="nav-toggle"
      id="nav-toggle-label"
      class="nav-toggle-label"
      role="button"
      tabindex="0"
      aria-label={ui?.toggleLabel}
      aria-controls="nav-menu"
      aria-expanded="false"
    >
      <svg id="show-button" class="block" width="28" height="28" viewBox="0 0 28 28">
        <title>{ui?.menuOpenTitle}</title>
        <path d="M2 7h24M2 14h24M2 21h24" stroke="currentColor" stroke-width="3"></path>
      </svg>
      <svg id="hide-button" class="hidden" width="28" height="28" viewBox="0 0 28 28">
        <title>{ui?.menuCloseTitle}</title>
        <path d="M4 4l20 20M24 4L4 24" stroke="currentColor" stroke-width="3"></path>
      </svg>
    </label>

    <ul data-lenis-prevent id="nav-menu" class="navbar-nav">
      {
        main.map((menu, index) => {
          if (!menu.hasChildren)
            return (
              <li class="nav-item">
                <a href={menu.url} class:list={["nav-link", { active: isHere(menu.url) }]} aria-current={isHere(menu.url) ? "page" : undefined}>
                  <span>{menu.name}</span>
                </a>
              </li>
            );
          const children = menu.children ?? [];
          const wide = children.length < 4;
          const Trigger = menu.url ? "a" : "span";
          return (
            <li class="nav-item nav-dropdown">
              <Trigger
                {...(menu.url ? { href: menu.url } : { role: "button", tabindex: "0" })}
                aria-controls={`nav-dropdown-${index}`}
                aria-haspopup="true"
                aria-expanded="false"
                class:list={["nav-link", { active: isHere(menu.url) || children.some(({ url }) => isInside(url)) }]}
              >
                <span>
                  {menu.name}
                  <svg class="nav-arrow" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4">
                    <path class="chev" style="transform-origin: 7px 7px" d="M2 4.5l5 5 5-5" />
                    <path class="plus" d="M0.5 7h13" />
                    <path class="plus plus-v" d="M7 0.5v13" />
                  </svg>
                </span>
              </Trigger>
              <ul id={`nav-dropdown-${index}`} class="nav-dropdown-list" data-wide={wide ? "" : undefined} data-seven={children.length === 7 ? "" : undefined} style={`--tiles: ${wide || children.length === 7 ? children.length : children.length % 3 === 0 ? Math.min(children.length, 6) : 4}`}>
                {menu.url && (
                  <li class="nav-all">
                    <a href={menu.url}>All {menu.name.toLowerCase()}</a>
                  </li>
                )}
                {children.map((child, i) => {
                  const tile = navTile(child.url, i);
                  return (
                    <li class={!wide && i === children.length - 1 && i % 2 === 0 ? "nav-odd" : undefined}>
                      <a href={child.url} class="nav-tile" data-tone={tile.tone} aria-current={isHere(child.url) ? "page" : undefined}>
                        {tile.image && <img src={tile.image} alt="" width="118" height="96" loading="lazy" decoding="async" />}
                        <span>{child.name}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </li>
          );
        })
      }
      {
        navigation_button.enable && (
          <li class="nav-menu-cta">
            <a class="nav-cta" href={navigation_button.link} target={isExternal(navigation_button.link) ? "_blank" : undefined}>
              {navigation_button.label}
            </a>
          </li>
        )
      }
    </ul>
    {
      navigation_button.enable && (
        <a class="nav-cta nav-bar-cta" href={navigation_button.link} target={isExternal(navigation_button.link) ? "_blank" : undefined}>
          {navigation_button.label}
        </a>
      )
    }
  </nav>
</header>

<script>
  // Past the top of the page the bar lifts off the edges, shrinks and turns see-through.
  const syncScroll = () => document.querySelector(".header")?.toggleAttribute("data-scrolled", window.scrollY > 50);
  window.addEventListener("scroll", syncScroll, { passive: true });
  syncScroll();
  document.addEventListener("astro:after-swap", syncScroll);

  // Handle dropdown menus
  const initDropdownMenus = () => {
    const navDropdowns = document.querySelectorAll<HTMLElement>(".nav-dropdown");
    const wide = window.matchMedia("(min-width: 64rem)");

    const setExpanded = (dropdown: HTMLElement, open: boolean) => {
      dropdown.toggleAttribute("data-open", open);
      dropdown.querySelector(".nav-link")?.setAttribute("aria-expanded", String(open));
    };
    const closeOthers = (keep?: HTMLElement) =>
      navDropdowns.forEach((d) => d !== keep && setExpanded(d, false));

    navDropdowns.forEach((dropdown) => {
      const trigger = dropdown.querySelector<HTMLElement>(".nav-link");
      if (!trigger) return;

      const activate = (event: Event, pointer: string) => {
        const href = trigger.getAttribute("href");
        const leaves = href && new URL(href, window.location.href).pathname !== window.location.pathname;
        const isOpen = dropdown.hasAttribute("data-open");
        const onArrow = !wide.matches || (event.target instanceof Element && !!event.target.closest("svg"));
        // With a mouse or keyboard on a wide screen the menu is already showing.
        const alreadyShowing = wide.matches && (pointer === "mouse" || pointer === "keyboard");
        if (leaves && (alreadyShowing || (isOpen && !onArrow))) return;
        event.preventDefault();
        // Hovering already shows the menu; a click must not pin it open.
        if (wide.matches && pointer === "mouse") return;
        closeOthers(dropdown);
        setExpanded(dropdown, !isOpen);
        // A tap also counts as hovering, so closing has to outrank that.
        dropdown.toggleAttribute("data-dismissed", wide.matches && isOpen);
      };

      trigger.addEventListener("click", (event) => {
        const coarse = window.matchMedia("(pointer: coarse)").matches;
        const type = (event as PointerEvent).pointerType;
        activate(event, event.detail === 0 ? "keyboard" : type || (coarse ? "touch" : "mouse"));
      });
      if (!trigger.hasAttribute("href")) {
        trigger.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") activate(event, "keyboard");
        });
      }

      dropdown.addEventListener("focusin", () => trigger.setAttribute("aria-expanded", "true"));
      dropdown.addEventListener("focusout", (event) => {
        // Phones report no next element while a link inside is being tapped, so only
        // close when focus has clearly moved somewhere else.
        const next = event.relatedTarget;
        // Closing on phones would move the list under the finger mid-tap.
        if (wide.matches && next instanceof Node && !dropdown.contains(next)) setExpanded(dropdown, false);
      });
    });

    // Escape puts a menu away even while the mouse or focus is still on it.
    navDropdowns.forEach((dropdown) => {
      dropdown.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        dropdown.querySelector<HTMLElement>(".nav-link")?.focus();
        setExpanded(dropdown, false);
        dropdown.setAttribute("data-dismissed", "");
      });
      const restore = () => dropdown.removeAttribute("data-dismissed");
      dropdown.addEventListener("pointerenter", restore);
      dropdown.addEventListener("focusout", (event) => {
        if (!(event.relatedTarget instanceof Node && dropdown.contains(event.relatedTarget))) restore();
      });
    });

    document.addEventListener("pointerdown", (event) => {
      if (wide.matches && event.target instanceof Element && !event.target.closest(".nav-dropdown")) closeOthers();
    });
  };

  // Turn off nav-toggle on link click & sync aria-expanded (for mobile)
  const initMobileMenuClose = () => {
    const navToggle = document.getElementById("nav-toggle") as HTMLInputElement;
    const navToggleLabel = document.getElementById("nav-toggle-label");
    const navMenu = document.getElementById("nav-menu") as HTMLUListElement;

    if (!navToggle || !navMenu) return;

    const syncAria = () => {
      if (navToggleLabel) {
        navToggleLabel.setAttribute("aria-expanded", String(navToggle.checked));
      }
    };

    navToggle.addEventListener("change", syncAria);

    navToggleLabel?.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" && event.key !== " ") return;
      event.preventDefault();
      navToggle.checked = !navToggle.checked;
      syncAria();
    });

    const navLinks = navMenu.querySelectorAll("a");

    const handleClick = (event: Event) => {
      // Opening a submenu is not leaving the page, so the menu stays.
      if (!event.defaultPrevented && navToggle.checked) {
        navToggle.checked = false;
        syncAria();
      }
    };

    navLinks.forEach((link) => link.addEventListener("click", handleClick));
  };

  // Initialize all header functionality
  const initHeader = () => {
    initDropdownMenus();
    initMobileMenuClose();
  };

  // Run on initial load
  initHeader();

  // Re-run on route change (Astro navigation)
  document.addEventListener("astro:after-swap", () => {
    initHeader();
  });
</script>
