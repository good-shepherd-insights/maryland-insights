---
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";

const pageIndex = await getListPage("homepage", "-index");
const {
  eyebrow,
  title,
  content,
  button_solid,
  button_underline,
  fine_print,
  stats,
} = pageIndex.data.banner;

---

<section
  class="section bg-light pt-44 md:pt-36 pb-10 lg:pb-8 bg-4col-grid overflow-x-hidden touch-pan-y"
>
  <div class="mx-0 md:mx-8">
  <div class="container px-4 md:px-8">
    <div class="xl:max-w-6xl mb-8 xl:mb-10">
      {
        eyebrow && (
          <span class="mb-3.5 inline-flex items-center justify-center h-6 px-3 py-1 text-xs font-medium bg-primary text-text-dark rounded-full">
            {eyebrow}
          </span>
        )
      }
      <h1
        class="text-5xl xl:text-6xl leading-[1.08] font-bold tracking-tight text-balance"
        set:html={markdownify(title)}
      />

      <p class="mt-5 max-w-2xl text-xl leading-relaxed" set:html={markdownify(content)} />

      <div class="mt-6 flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3 sm:gap-x-5">
        {
          button_solid.enable && (
            <a
              href={button_solid.link}
              target={button_solid.link.startsWith("http") ? "_blank" : "_self"}
              rel={button_solid.link.startsWith("http") ? "noopener noreferrer" : "nofollow"}
              class="hero-cta-gold block sm:inline-block w-full sm:w-auto text-center font-secondary font-semibold text-base px-8 py-4 transition"
            >
              {button_solid.label}
            </a>
          )
        }
        {
          button_underline.enable && (
            <a
              href={button_underline.link}
              target={button_underline.link.startsWith("http") ? "_blank" : "_self"}
              rel={button_underline.link.startsWith("http") ? "noopener noreferrer" : "nofollow"}
              class="block sm:inline-block w-full sm:w-auto text-center border border-dark text-dark font-secondary font-semibold text-base px-8 py-4 transition hover:bg-dark hover:text-white"
            >
              {button_underline.label}
            </a>
          )
        }
        {fine_print && <span class="text-sm text-text-light">{fine_print}</span>}
      </div>
    </div>

    {
      stats && stats.length > 0 && (
        <div class="xl:max-w-6xl grid grid-cols-2 lg:grid-cols-4 border-t border-b border-border">
          {stats.map((stat: { value: string; label: string; accent?: string }, i: number) => (
            <div
              class={`px-5 py-5 border-border ${
                i % 2 === 0 ? "border-r" : ""
              } lg:border-r ${i === stats.length - 1 ? "lg:border-r-0" : ""} ${
                i >= 2 ? "border-t lg:border-t-0" : ""
              }`}
            >
              <div class="font-secondary font-bold text-3xl tabular-nums text-dark">
                {stat.value}
              </div>
              <div class="mt-1 text-sm font-bold uppercase tracking-[0.05em] text-text-light">
                {stat.label}
              </div>
            </div>
          ))}
        </div>
      )
    }
  </div>
  </div>
</section>

<style>
  .hero-cta-gold {
    background-color: #FFB612;
    color: #121212;
  }
  .hero-cta-gold:hover {
    background-color: #E6A410;
  }
</style>
