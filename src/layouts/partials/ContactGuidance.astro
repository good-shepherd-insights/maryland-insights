---
const consultationSteps = [
  {
    number: "01",
    title: "Diagnostic review before the call",
    description: "Send your website URL, primary services, and target Maryland counties. We inspect your Core Web Vitals, local schema markup, and search footprint prior to our conversation."
  },
  {
    number: "02",
    title: "Practical strategy based on data",
    description: "We review what the technical audit revealed: where leads are leaking, why local rankings stall in specific zip codes, or why current advertising delivers low conversion rates."
  },
  {
    number: "03",
    title: "A clear scope without sales pressure",
    description: "You receive an exact plan of work with straightforward recommendations, whether that means a fast technical fix, an automation pipeline, or a comprehensive site redesign."
  }
];

const contextItems = [
  {
    title: "Current Website & Hosting",
    detail: "Share your current platform (WordPress, Squarespace, custom) and whether you have administrative access to your domain DNS."
  },
  {
    title: "Core Services & Average Value",
    detail: "Highlight the 2 or 3 high-priority services that generate the bulk of your revenue and profit margin."
  },
  {
    title: "Target Maryland Markets",
    detail: "List the specific counties, cities, or commercial zones (e.g. Montgomery County, Baltimore Metro, Annapolis) you want to dominate."
  },
  {
    title: "The Primary Bottleneck",
    detail: "Tell us what is failing right now: slow page load speeds, invisible local rankings, broken form submissions, or poor conversion."
  }
];
---

<section class="section-sm bg-light border-y border-border/70" aria-labelledby="contact-guidance-title">
  <div class="container lg:w-[84%] xl:w-[80%] mx-auto">
    <!-- Top Narrative & Step Flow -->
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:gap-16 xl:gap-24 items-start">
      <div>
        <p class="font-secondary text-xs font-semibold uppercase tracking-[0.14em] text-text-light mb-3">
          Consultation Process
        </p>
        <h2 id="contact-guidance-title" class="mb-5 text-balance">
          A useful first conversation starts with the operational reality of your business.
        </h2>
        <p class="text-lg leading-relaxed text-text-dark/80 mb-4 max-w-prose">
          You do not need a completed RFP, technical specifications, or marketing jargon. Tell us where your business operates, what you provide, and where your current digital setup falls short.
        </p>
        <p class="leading-relaxed text-text-light max-w-prose text-sm">
          We use your input to run a technical audit before we speak. That way, our first call focuses on real findings and specific solutions rather than a generic capabilities pitch.
        </p>
      </div>

      <!-- Steps with refined rail styling -->
      <div class="space-y-6 lg:border-l lg:border-border lg:pl-10">
        {consultationSteps.map((step) => (
          <div class="group relative pl-10">
            <span class="absolute left-0 top-0.5 font-secondary text-xs font-bold tracking-wider text-primary">
              {step.number}
            </span>
            <h3 class="h5 mb-1.5 text-text-dark font-medium text-balance">
              {step.title}
            </h3>
            <p class="text-sm leading-relaxed text-text-dark/75">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom Context Checklist -->
    <div class="mt-12 pt-10 border-t border-border lg:mt-16">
      <div class="mb-8">
        <h3 class="h4 font-medium text-balance text-text-dark">
          Helpful context to share in your message
        </h3>
        <p class="mt-1 text-sm text-text-light max-w-2xl">
          Including these details allows our engineering team to review your live footprint prior to our first reply.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {contextItems.map((item) => (
          <div class="p-6 rounded-xl border border-border/80 bg-body/60 transition-colors hover:border-primary/40 hover:bg-body">
            <strong class="block font-secondary text-sm font-semibold text-text-dark mb-2">
              {item.title}
            </strong>
            <p class="text-xs leading-relaxed text-text-dark/70">
              {item.detail}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
