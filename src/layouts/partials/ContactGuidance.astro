---
type Props = {
  eyebrow?: string;
  title?: string;
  processIntro?: string;
  description?: string;
  steps?: { number?: string; title?: string; description?: string }[];
  contextTitle?: string;
  contextIntro?: string;
  contextItems?: { title?: string; detail?: string }[];
};

const {
  eyebrow,
  title,
  processIntro,
  description,
  steps = [],
  contextTitle,
  contextIntro,
  contextItems = [],
} = Astro.props as Props;
---

<section class="section-sm bg-light border-y border-border/70" aria-labelledby="contact-guidance-title">
  <div class="container lg:w-[84%] xl:w-[80%] mx-auto">
    <!-- Top Narrative & Step Flow -->
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:gap-16 xl:gap-24 items-start">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-text-light mb-3">
          {eyebrow}
        </p>
        <h2 id="contact-guidance-title" class="mb-5 text-balance">
          {title}
        </h2>
        <p class="text-lg leading-relaxed text-text-dark/80 mb-4 max-w-prose">
          {processIntro}
        </p>
        <p class="leading-relaxed text-text-light max-w-prose text-sm">
          {description}
        </p>
      </div>

      <!-- Steps with refined rail styling -->
      <div class="space-y-6 lg:border-l lg:border-border lg:pl-10">
        {steps.map((step) => (
          <div class="group relative pl-10">
            <span class="absolute left-0 top-0.5 text-xs font-bold tracking-wider text-primary">
              {step.number}
            </span>
            <h3 class="h5 mb-1.5 text-text-dark font-medium text-balance">
              {step.title}
            </h3>
            <p class="text-sm leading-relaxed text-text-dark/75">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom Context Checklist -->
    <div class="mt-12 pt-10 border-t border-border lg:mt-16">
      <div class="mb-8">
        <h3 class="h4 font-medium text-balance text-text-dark">
          {contextTitle}
        </h3>
        <p class="mt-1 text-sm text-text-light max-w-2xl">
          {contextIntro}
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {contextItems.map((item) => (
          <div class="p-6 rounded-xl border border-border/80 bg-body/60 transition-colors hover:border-primary/40 hover:bg-body">
            <strong class="block font-secondary text-sm font-semibold text-text-dark mb-2">
              {item.title}
            </strong>
            <p class="text-xs leading-relaxed text-text-dark/70">
              {item.detail}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
