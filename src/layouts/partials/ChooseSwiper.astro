---
import ImageMod from "@/components/ImageMod.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { FaCheck } from "react-icons/fa6";
import type { CollectionEntry } from "astro:content";

type Props = {
  data: CollectionEntry<"homepage">["data"]["agents_swiper"];
};

const { data } = Astro.props as Props;
if (!data.enable) return null;
const { title, agents } = data;
---

<section
  id="be-the-answer"
  class="section bg-dark section-divider"
  style="--section-divider-color: var(--color-dark)"
>
  <div class="mx-0 md:mx-8">
    <div class="container px-8">
      <h2
        class="text-center text-white text-balance"
        set:html={markdownify(title)}
      />

      <div class="mt-12 lg:mt-20 flex flex-col gap-16 lg:gap-24">
        {
          agents?.map((agent, i) => (
            <div class={`grid gap-8 lg:gap-16 items-center ${agent.image ? "lg:grid-cols-2" : "lg:max-w-3xl lg:mx-auto"}`}>
              {agent.image && (
                <div class={i % 2 === 1 ? "lg:order-2" : ""}>
                  <div
                    class={agent.image_bg
                      ? "rounded-2xl p-[3px]"
                      : ""}
                    style={agent.image_bg
                      ? "background: linear-gradient(135deg, #C8102E, var(--color-secondary))"
                      : undefined}
                  >
                    <div
                      class={agent.image_bg
                        ? "bg-light rounded-[calc(var(--radius-2xl)-3px)] p-5 flex items-center justify-center h-full"
                        : ""}
                    >
                      <ImageMod
                        src={agent.image}
                        alt={agent.label}
                        width={750}
                        height={584}
                        class={agent.image_bg
                          ? "w-full h-auto max-w-sm mx-auto"
                          : "w-full h-auto rounded-2xl"}
                        format={agent.image.endsWith(".svg") ? "svg" : "webp"}
                      />
                    </div>
                  </div>
                </div>
              )}

              <div>
                <span class="text-sm font-medium uppercase tracking-wide text-white/50">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3
                  class="mt-3 h3 text-white"
                  set:html={markdownify(agent.label)}
                />
                <p
                  class="mt-4 text-lg text-white/70 text-balance"
                  set:html={markdownify(agent.description)}
                />

                {agent.points && (
                  <ul class="mt-6 flex flex-col gap-3">
                    {agent.points.map((point) => (
                      <li class="flex items-start gap-3 text-white">
                        <FaCheck className="mt-1 shrink-0 text-primary" />
                        <span set:html={markdownify(point)} />
                      </li>
                    ))}
                  </ul>
                )}

                {agent.button.enable && (
                  <a
                    href={agent.button.link}
                    target={agent.button.link.startsWith("http") ? "_blank" : "_self"}
                    rel="noopener"
                    class="hero-cta-gold mt-8 inline-block text-center font-secondary font-semibold text-base px-8 py-4 transition"
                  >
                    {agent.button.label}
                  </a>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
