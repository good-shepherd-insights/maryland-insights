---
import ImageMod from "@/components/ImageMod.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";

type Props = {
  data: CollectionEntry<"homepage">["data"]["agents_swiper"];
  id?: string;
};

const { data, id = "be-the-answer" } = Astro.props as Props;
if (!data.enable) return null;
const { title, agents } = data;

const splitPoint = (point: string) => {
  const match = point.match(/^\*\*(.+?)\*\*:\s*(.+)$/);

  if (!match) {
    return { label: undefined, detail: point };
  }

  return { label: match[1], detail: match[2] };
};

const tabs = agents?.map((agent: any, i: number) => ({
  num: String(i + 1).padStart(2, "0"),
  label: agent.label,
  panelId: `service-${i + 1}`,
})) ?? [];
---

<section class="ds-scope" id={id}>
  <div class="ds-container mx-auto w-full max-w-[1147px] px-4 pt-10 pb-14 md:px-6 md:pt-12 md:pb-16 lg:max-w-[1280px] lg:pb-20 xl:max-w-[1400px]">
    <!-- Section header -->
    <div class="flex flex-col items-start gap-6 text-left">
      <h2 class="ds-h1" set:html={markdownify(title)} />
    </div>

    <!-- Split layout: sticky tab rail + stacked panels -->
    <div class="mt-14 flex flex-col gap-6 md:mt-20 lg:flex-row lg:gap-10 xl:gap-16">
      <!-- Tab strip (visible below lg: vertical list on phones, horizontal scroll strip sm–md) -->
      <div
        class="ds-tabs grid grid-cols-1 gap-2 sm:grid-flow-col sm:grid-cols-none sm:auto-cols-max sm:overflow-x-auto sm:pb-1 lg:hidden [scrollbar-width:thin] [scrollbar-gutter:stable] [-webkit-overflow-scrolling:touch]"
        role="tablist"
        aria-label="Services"
      >
        {
          tabs.map((t) => (
            <button
              type="button"
              role="tab"
              data-ds-tab={t.panelId}
              aria-controls={`ds-panel-${t.panelId}`}
              class="ds-tab flex min-h-12 shrink-0 touch-manipulation items-center gap-2 px-3 py-2 text-left transition-colors duration-200"
            >
              <span class="ds-tab-num" aria-hidden="true">{t.num}</span>
              <span class="ds-tab-label" aria-hidden="true">{t.label}</span>
            </button>
          ))
        }
      </div>

      <!-- Desktop sticky rail -->
      <div class="hidden lg:block lg:w-[226px] lg:shrink-0">
        <div class="ds-rail lg:sticky lg:top-32 self-start max-h-[calc(100dvh-8.5rem)] overflow-y-auto">
          <div class="relative">
            <div class="relative flex overflow-x-auto lg:flex-col" role="tablist" aria-label="Services">
              {
                tabs.map((t) => (
                  <button
                    type="button"
                    role="tab"
                    data-ds-tab={t.panelId}
                    aria-controls={`ds-panel-${t.panelId}`}
                    class="ds-tab relative z-10 flex min-w-[160px] shrink-0 items-center gap-[14px] border p-[10px] text-left transition-[background-color,color,border-color] duration-300 lg:w-full lg:min-w-0"
                  >
                    <span class="ds-tab-num" aria-hidden="true">{t.num}</span>
                    <span class="ds-tab-label" aria-hidden="true">{t.label}</span>
                  </button>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <!-- Panels stack -->
      <div class="min-w-0 flex-1">
        {
          agents?.map((agent: any, i: number) => {
            const panelId = `service-${i + 1}`;
            const points = agent.points ?? [];
            const last = i === agents.length - 1;
            return (
              <div id={`ds-panel-${panelId}`} data-ds-panel={panelId} class="ds-panel sticky">
                <div class="ds-card flex flex-col border border-dark bg-body lg:grid lg:grid-cols-[minmax(0,28%)_1fr] lg:items-stretch lg:min-h-[520px] lg:pl-[30px] lg:pr-[30px] lg:py-7 xl:grid-cols-[minmax(0,34%)_1fr] xl:pl-[40px] xl:pr-[40px]">
                  <!-- Visual: vector centered on mobile/MD, full-size on desktop -->
                  <div class="flex flex-col items-center gap-5 px-5 pt-5 pb-4 sm:px-8 md:pt-10 md:pb-8">
                    {agent.image && (
                      <figure class="service-art-figure w-full max-w-full overflow-hidden">
                        <ImageMod
                          src={agent.image}
                          alt={agent.label}
                          width={420}
                          height={320}
                          class="h-auto w-full max-w-[120px] object-contain self-center sm:max-w-[160px] md:max-w-[280px] lg:max-w-[240px] xl:max-w-[360px]"
                          format={agent.image.endsWith(".svg") ? "svg" : "webp"}
                        />
                      </figure>
                    )}
                  </div>

                  <!-- Copy -->
                  <div class="flex w-full min-w-0 flex-1 flex-col px-4 pt-4 pb-5 sm:px-6 md:pt-6 md:pb-6 lg:px-0 lg:pt-4 lg:pb-4 lg:pl-8 lg:pr-0 xl:pl-10">
                    <div class="flex items-center gap-3">
                      <span class="ds-num-chip text-sm" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                    </div>
                    <h2 class="mt-3.5 text-[22px] leading-snug text-text-dark sm:text-[26px] lg:text-[28px]">{markdownify(agent.label)}</h2>
                    <div
                      class="ds-muted mt-4 max-w-[68ch] text-[13px] leading-normal sm:text-sm sm:leading-snug lg:mt-4 lg:max-w-[75ch] lg:text-[18px] lg:leading-snug [&_p]:my-0 [&_p]:max-w-[68ch] [&_p]:lg:max-w-[75ch]"
                      set:html={markdownify(agent.description, true)}
                    />
                    {points.length > 0 && (
                      <div class="relative mt-6 flex flex-col gap-4 md:mt-8 md:gap-5 lg:mt-7 lg:gap-4">
                        <div class="absolute top-0 bottom-0 left-0 w-[3px] rounded-full bg-primary/25" aria-hidden="true" />
                        {points.map((point: string) => {
                          const { label, detail } = splitPoint(point);
                          return (
                            <div class="ds-bullet pl-4">
                              <div class="ds-bullet-marker" aria-hidden="true" />
                              <p class="ds-muted max-w-[68ch] text-[13px] leading-normal sm:text-sm sm:leading-snug lg:max-w-[75ch] lg:text-[16px]">
                                {label ? (
                                  <strong class="font-semibold text-text-dark">{label}:</strong>
                                ) : null}{" "}
                                {detail}
                              </p>
                            </div>
                          );
                        })}
                      </div>
                    )}
                    {agent.button?.enable && (
                      <a
                        href={agent.button.link}
                        target={agent.button.link.startsWith("http") ? "_blank" : "_self"}
                        rel={agent.button.link.startsWith("http") ? "noopener" : undefined}
                        class="ds-cta mt-auto inline-flex w-fit items-center gap-2 pt-6 md:pt-10 lg:pt-6 text-xs lg:text-[16px] font-bold tracking-[0.02em]"
                      >
                        {agent.button.label}
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" class="lg:h-[16px] lg:w-[16px]">
                          <path d="M2 6h8M6.5 2.5L10 6l-3.5 3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </a>
                    )}
                  </div>
                </div>
                {
                  !last && (
                    <div class="h-10 flex items-center" aria-hidden="true">
                      <div class="flex h-[14px] w-full">
                        {[0, 1, 2, 3, 4].map(() => (
                          <div class="h-full flex-1 border border-border border-l-0 first:border-l" />
                        ))}
                      </div>
                    </div>
                  )
                }
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .ds-scope {
    /* Light scheme, project tokens (same palette as /services and homepage) */
    background-color: var(--color-light);
    /* composio type: display/body resolve from theme.json tokens */
    --ds-font-display: var(--font-secondary);
    --ds-font-sans: var(--font-primary);
    --ds-line: var(--color-dark);
    --ds-panel-border: var(--color-border);
    --ds-accent: var(--color-primary);
    --ds-accent-2: var(--color-accent);
    --ds-fg: var(--color-text-dark);
    --ds-fg-strong: var(--color-text-dark);
    font-family: var(--ds-font-sans);
    color: var(--ds-fg-strong);
  }

  .ds-scope :is(h1, h2, h3) {
    font-family: var(--ds-font-display);
  }
  .ds-scope :is(p, span, a, button, strong, li) {
    font-family: var(--ds-font-sans);
  }
  /* heading text can live in inline descendants — keep it display font */
  .ds-scope :is(h1, h2, h3) :is(span, strong, em, a, mark) {
    font-family: var(--ds-font-display);
  }

  .ds-panel {
    top: 6rem;
    scroll-margin-top: 7rem;
  }
  @media (min-width: 768px) {
    .ds-panel {
      top: 7rem;
      scroll-margin-top: 8rem;
    }
  }
  @media (min-width: 1024px) {
    .ds-panel {
      top: 8rem;
      scroll-margin-top: 9rem;
    }
  }

  /* lg+: cards are scaled down only if they cannot fit the viewport while
     pinned (lg:top-32); --ds-scale is set by the fit script, 1 = no shrink.
     Width compensation keeps the card flush with its column after scaling. */
  @media (min-width: 1024px) {
    .ds-card {
      transform: scale(var(--ds-scale, 1));
      transform-origin: top left;
      width: calc(100% / var(--ds-scale, 1));
    }
  }

  .ds-scope h2.ds-h1 {
    font-size: clamp(2rem, 5.4vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 700;
    color: var(--ds-fg-strong);
  }
  .ds-muted {
    color: var(--ds-fg);
  }
  .ds-muted :global(p) {
    max-width: 68ch;
  }

  /* Tabs */
  .ds-tab {
    background-color: var(--color-body);
    border-width: 1px;
    border-style: solid;
    border-color: var(--ds-line);
  }
  .ds-tab .ds-tab-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 23px;
    height: 23px;
    border-radius: 2px;
    background-color: color-mix(in srgb, var(--color-dark) 6%, #ffffff);
    color: color-mix(in srgb, var(--color-dark) 64%, transparent);
  }
  .ds-tab .ds-tab-label {
    color: var(--ds-fg-strong);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .ds-tab[aria-selected="true"] {
    z-index: 20;
    background-color: var(--color-body);
    border-color: var(--ds-accent);
  }
  .ds-tab[aria-selected="true"] .ds-tab-num {
    background-color: var(--ds-accent);
    color: var(--color-dark);
  }

  @media (min-width: 1024px) {
    .ds-tab + .ds-tab {
      margin-top: -1px;
    }
  }

  /* Bullets */
  .ds-bullet-marker {
    position: relative;
    z-index: 10;
    margin-top: 2px;
    height: 14px;
    width: 3px;
    flex-shrink: 0;
    border-radius: 9999px;
    background-color: var(--ds-accent);
  }
  .ds-bullet {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  /* Number chip in copy column */
  .ds-num-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 2px;
    background-color: color-mix(in srgb, var(--ds-accent) 12%, transparent);
    color: var(--ds-accent);
  }

  /* Link to the service page */
  .ds-cta {
    color: var(--ds-accent);
  }
  .ds-cta:hover {
    color: #ffb612;
  }
  .ds-cta:focus-visible {
    outline: 2px solid var(--ds-accent);
    outline-offset: 3px;
  }
</style>

<script>
  const initBeTheAnswer = () => {
    const section = document.getElementById("be-the-answer");
    if (!section) return;

    const tabs = Array.from(
      section.querySelectorAll<HTMLElement>("[data-ds-tab]"),
    );
    const panels = Array.from(
      section.querySelectorAll<HTMLElement>("[data-ds-panel]"),
    );
    if (tabs.length === 0 || panels.length === 0) return;

    const setActive = (id: string) => {
      tabs.forEach((t) => {
        t.setAttribute("aria-selected", String(t.dataset.dsTab === id));
      });
    };

    const getStickOffset = () => {
      if (window.matchMedia("(min-width: 1024px)").matches) return 146;
      if (window.matchMedia("(min-width: 768px)").matches) return 128;
      return 112;
    }; // sticky line incl. breathing room; keep CSS top-* and scroll math aligned

    // Fit-to-viewport (lg+): scale cards down only when they cannot fit below
    // the pinned line. offsetHeight is the unscaled layout height (transform
    // doesn't affect layout), so the ratio is stable across recomputes.
    const cards = Array.from(section.querySelectorAll<HTMLElement>(".ds-card"));
    const fitCards = () => {
      const lg = window.matchMedia("(min-width: 1024px)").matches;
      // Clear every width-compensating scale before measuring natural heights.
      cards.forEach((card) => card.style.removeProperty("--ds-scale"));
      if (!lg) return;
      const avail = window.innerHeight - getStickOffset() - 8;
      const scales = cards.map((card) => Math.min(1, avail / card.offsetHeight));
      cards.forEach((card, index) => {
        if (scales[index] < 1) card.style.setProperty("--ds-scale", String(scales[index]));
      });
    };
    fitCards();
    let fitFrame = 0;
    const scheduleFitCards = () => {
      if (fitFrame) return;
      fitFrame = requestAnimationFrame(() => {
        fitFrame = 0;
        fitCards();
      });
    };
    document.fonts.ready.then(scheduleFitCards);

    // Scroll-position-driven: the active panel is the last one whose top has
    // crossed the stick line. Deterministic, always matches what the user sees.
    let ticking = false;
    const updateActive = () => {
      ticking = false;
      const line = getStickOffset(); // exact stick line: a stuck panel has top <= this value
      let current = 0;
      panels.forEach((p, idx) => {
        if (p.getBoundingClientRect().top <= line) current = idx;
      });
      setActive(panels[current].dataset.dsPanel ?? "");
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateActive);
      }
    };

    const isDesktop = () => window.matchMedia("(min-width: 1024px)").matches;
    let wasDesktop = isDesktop();

    const scrollHandler: EventListenerOrEventListenerObject = onScroll;
    window.addEventListener("scroll", scrollHandler, { passive: true });
    window.addEventListener("resize", () => {
      scheduleFitCards();
      const nowDesktop = isDesktop();
      if (nowDesktop !== wasDesktop) {
        wasDesktop = nowDesktop;
        if (!nowDesktop) setActive(tabs[0].dataset.dsTab ?? "");
      }
      onScroll();
    });
    updateActive();

    // Tab clicks: scroll with fixed-header offset (all viewports)
    const clickHandlers: [HTMLElement, EventListener][] = [];
    tabs.forEach((t) => {
      const handler = () => {
        const target = panels.find(
          (p) => p.dataset.dsPanel === t.dataset.dsTab,
        );
        if (target) {
          window.scrollTo({
            top:
              target.getBoundingClientRect().top +
              window.scrollY -
              getStickOffset(),
            behavior: "smooth",
          });
        }
      };
      t.addEventListener("click", handler);
      clickHandlers.push([t, handler]);
    });

    return () => {
      window.removeEventListener("scroll", scrollHandler);
      clickHandlers.forEach(([t, h]) => t.removeEventListener("click", h));
    };
  };

  let cleanupBeTheAnswer: (() => void) | undefined;
  cleanupBeTheAnswer = initBeTheAnswer() ?? undefined;

  document.addEventListener("astro:after-swap", () => {
    cleanupBeTheAnswer?.();
    cleanupBeTheAnswer = initBeTheAnswer() ?? undefined;
  });
</script>
