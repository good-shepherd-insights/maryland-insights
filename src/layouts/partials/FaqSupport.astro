---
type Props = {
  eyebrow?: string;
  title?: string;
  intro?: string;
  description?: string;
  navAriaLabel?: string;
  cards?: { title?: string; description?: string; href?: string; highlight?: boolean }[];
};

const { eyebrow, title, intro, description, navAriaLabel, cards = [] } = Astro.props as Props;
---
<section class="section-sm bg-light border-y border-border/70" aria-labelledby="faq-navigation-title">
  <div class="container lg:w-[80%] xl:w-[70%] mx-auto">
    <div class="max-w-4xl">
      <p class="text-sm font-semibold text-text-light mb-4">{eyebrow}</p>
      <h2 id="faq-navigation-title" class="mb-4 text-balance">{title}</h2>
      <p class="text-lg leading-relaxed mb-4 max-w-prose">
        {intro}
      </p>
      <p class="leading-relaxed text-text-light max-w-prose">
        {description}
      </p>
    </div>

    <nav class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" aria-label={navAriaLabel}>
      {cards.map((card) => (
        <a href={card.href} class={card.highlight ? "bg-dark text-white p-6 rounded-2xl hover:-translate-y-0.5 transition-transform sm:col-span-2 lg:col-span-1" : "bg-body p-6 rounded-2xl card-shadow hover:-translate-y-0.5 transition-transform"}>
          <span class={card.highlight ? "font-semibold" : "font-semibold text-text-dark"}>{card.title}</span>
          <span class={card.highlight ? "block mt-2 text-sm leading-relaxed text-white/70" : "block mt-2 text-sm leading-relaxed text-text-light"}>{card.description}</span>
        </a>
      ))}
    </nav>
  </div>
</section>
