---
type Props = {
  title: string;
  introduction: string;
  reading_note: string;
  categories: string[];
  eyebrow?: string;
  pillars?: { number?: string; title?: string; description?: string }[];
  domainsHeading?: string;
  domainsIntro?: string;
  topics?: { name?: string; detail?: string }[];
};

const { title, introduction, reading_note, categories, eyebrow, pillars = [], domainsHeading, domainsIntro, topics = [] } = Astro.props as Props;
---

<section aria-labelledby="blog-library-guide-title">
  <div class="sp-sec hp-white">
    <div class="hp-in sp-stack">
      <div class="sp-head">
        <div class="sp-title">
          {eyebrow && <p class="sp-eyebrow">{eyebrow}</p>}
          <h2 id="blog-library-guide-title" class="sp-h2">{title}</h2>
        </div>
        <div class="sp-title"><p>{introduction}</p><p class="sp-mut">{reading_note}</p></div>
      </div>
      <div class="sp-cols" style={`--n:${Math.max(1, Math.min(3, pillars.length))}`}>
        {pillars.map((pillar) => <div class="sp-rule sp-rule-3"><span class="sp-big sp-red">{pillar.number}</span><h3 class="sp-h3">{pillar.title}</h3><p>{pillar.description}</p></div>)}
      </div>
    </div>
  </div>
  <div class="sp-sec sp-sec-s hp-gold">
    <div class="hp-in sp-stack">
      <div class="sp-head sp-head-end">
        <div class="sp-title"><h3 class="sp-h2 sp-h2-s">{domainsHeading}</h3><p>{domainsIntro}</p></div>
        {categories.length > 0 && <div class="bp-tags">{categories.map((category) => <a href="#all-articles">{category}</a>)}</div>}
      </div>
      <div class="bp-topics">{topics.map((topic) => <div class="sp-rule"><strong>{topic.name}</strong><p>{topic.detail}</p></div>)}</div>
    </div>
  </div>
</section>
