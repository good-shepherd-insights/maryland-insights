---
import ImageMod from "@/components/ImageMod.astro";
import { markdownify } from "@/lib/utils/textConverter";

type Props = {
  title: string;
  image: string;
  paragraphs: string[];
};

const { title, image, paragraphs } = Astro.props as Props;
---

<section class="section-sm bg-light" aria-labelledby="about-origin-title">
  <div class="container lg:w-[84%] xl:w-[80%] mx-auto">
    <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16 xl:gap-20 lg:items-start">
      <figure class="lg:sticky lg:top-28">
        <ImageMod
          src={image}
          alt="Maryland Insights team and workspace"
          width={1300}
          height={601}
          class="w-full rounded-2xl lg:rounded-3xl"
        />
      </figure>

      <div class="max-w-2xl">
        <h2 id="about-origin-title" class="text-balance mb-8" set:html={markdownify(title)} />

        <div class="space-y-0">
          {paragraphs.map((paragraph, index) => (
            <p
              class:list={[
                "leading-relaxed",
                index === 0 ? "text-xl lg:text-2xl text-text-dark pb-8" : "pt-7 pb-7 border-t border-border",
                index === paragraphs.length - 1 && "font-medium text-text-dark",
              ]}
              set:html={markdownify(paragraph)}
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
